<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>2c5be9d1-12f7-428d-9fc9-e4afa191d464</UserSecretsId>
	<LangVersion>latest</LangVersion>
	<OutputType>Exe</OutputType>
	<DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>

<PropertyGroup>
	<EnableNETAnalyzers>true</EnableNETAnalyzers>
	<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
</PropertyGroup>

<ItemGroup>
	<PackageReference Include="Amazon.AspNetCore.DataProtection.SSM" Version="4.0.3" />
	<PackageReference Include="AWSSDK.S3" Version="4.0.102.1" />
	<PackageReference Include="ClosedXML" Version="0.105.1" />
	<PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="9.0.0" PrivateAssets="all" />
</ItemGroup>

  <ItemGroup>
    <PackageReference Include="Base36" Version="1.0.0" />
    <PackageReference Include="Humanizer" Version="2.14.1" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.19.6" />
    <PackageReference Include="Microsoft.VisualStudio.Web.CodeGeneration.Design" Version="10.0.2" />
    <PackageReference Include="morelinq" Version="4.2.0" />
    <PackageReference Include="NodaTime" Version="3.1.11" />
    <PackageReference Include="NuGet.Packaging" Version="7.9.0" />
    <PackageReference Include="NuGet.Protocol" Version="7.9.0" />
    <PackageReference Include="Polly" Version="8.3.1" />
    <PackageReference Include="YamlDotNet" Version="15.1.2" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="assets\js\views\" />
    <Folder Include="assets\js\shared\" />
    <Folder Include="assets\scss\shared\" />
    <Folder Include="assets\scss\views\" />
    <Folder Include="Views\Account\" />
    <Folder Include="wwwroot\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HNTAS.Api.Client\src\HNTAS.Api.Client\HNTAS.Api.Client.csproj" />
    <ProjectReference Include="..\HNTAS.Web.OneLogin\HNTAS.Web.OneLogin.csproj" />
  </ItemGroup>

</Project>

@using HNTAS.Web.UI.Models
@model CheckYourAnswersHeatNetworkModel

@{
    ViewData["Title"] = "Check your answers";
    var energyCentreChangeAction = Model.HeatNetworkType == "Communal" ? "HeatNetworkEcCommunal" : "HeatNetworkEcDistrict";
    var heatNetworkName = Model.HeatNetworkNameModel.HeatNetworkName;
    var additionalDescription = Model.HeatNetworkNameModel.AdditionalDescription;
    var heatNetworkCoordinates = Model.ECDetailsModel.LatitudeLongitude;
    var energyCentreAddress = Model.HeatNetworkAddressModel?.Fulladdress ?? "Not provided";
    var heatNetworkPhase = Model.HeatNetworkPhaseModel.HeatNetworkPhase;
    var heatNetworkConnections = Model.HeatNetworkConnectionsModel;
    var pathway = Model.PathwayModel.Pathway;
    bool hasDeclarationErrors = ViewData.ModelState.ContainsKey(nameof(Model.ConfirmedDeclaration)) &&
                                ViewData.ModelState[nameof(Model.ConfirmedDeclaration)].Errors.Any();    
    var fieldOrder = new[] { nameof(Model.ConfirmedDeclaration) };   
}


<div class="govuk-width-container">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <h1 class="govuk-heading-l">Check your answers</h1>
            <form asp-controller="HeatNetworkRegistration" asp-action="SubmitAnswers" method="post" novalidate>
                @Html.AntiForgeryToken()
                <h2 class="govuk-heading-m">Heat Network registration</h2>
                <dl class="govuk-summary-list">
                    <div class="govuk-summary-list__row">
                        <dt class="govuk-summary-list__key">Number of dwellings more than 6</dt>
                        <dd class="govuk-summary-list__value">@Model.DoesHnHaveMoreThan6Dwellings</dd>
                        <dd class="govuk-summary-list__actions">
                            <a class="govuk-link" href="@Url.Action("HeatNetworkDwellingsCheck", "HeatNetworkRegistration")">Change<span class="govuk-visually-hidden"> heatNetworkType</span></a>
                        </dd>
                    </div>
                    <div class="govuk-summary-list__row">
                        <dt class="govuk-summary-list__key">Network Type</dt>
                        <dd class="govuk-summary-list__value">@Model.HeatNetworkType</dd>
                        <dd class="govuk-summary-list__actions">
                            <a class="govuk-link" href="@Url.Action("HeatNetworkType", "HeatNetworkRegistration")">Change<span class="govuk-visually-hidden"> heatNetworkType</span></a>
                        </dd>
                    </div>
                    <div class="govuk-summary-list__row">
                        <dt class="govuk-summary-list__key">Main energy centre</dt>
                        <dd class="govuk-summary-list__value">@Model.HasOwnEnergyCenter</dd>
                        <dd class="govuk-summary-list__actions">
                            <a class="govuk-link" href="@Url.Action(energyCentreChangeAction, "HeatNetworkRegistration")">Change<span class="govuk-visually-hidden"> main energy centre</span></a>
                        </dd>
                    </div>
                    @if (Model.HeatNetworkType == "District" && Model.HeatNetworkConnectionsModel.ConnectionsToDisplay.Any())
                    {
                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key">Connections</dt>
                            <dd class="govuk-summary-list__value">
                                <ul class="govuk-list">
                                    @foreach (var c in Model.HeatNetworkConnectionsModel.ConnectionsToDisplay)
                                    {
                                        <li>@c</li>
                                    }
                                </ul>
                            </dd>
                            <dd class="govuk-summary-list__actions">
                                <a class="govuk-link" href="@Url.Action("HeatNetworkConnections", "HeatNetworkRegistration")">Change<span class="govuk-visually-hidden"> heatNetworkConnections</span></a>
                            </dd>
                        </div>
                    }

                    <div class="govuk-summary-list__row">
                        <dt class="govuk-summary-list__key">Coordinates</dt>
                        <dd class="govuk-summary-list__value">@heatNetworkCoordinates</dd>
                        <dd class="govuk-summary-list__actions">
                            <a class="govuk-link" href="@Url.Action("ECCoordinates", "HeatNetworkRegistration")">Change<span class="govuk-visually-hidden"> heat network Location</span></a>
                        </dd>
                    </div>
                    <div class="govuk-summary-list__row">
                        <dt class="govuk-summary-list__key">Heat Network Name</dt>
                        <dd class="govuk-summary-list__value">@heatNetworkName</dd>
                        <dd class="govuk-summary-list__actions">
                            <a class="govuk-link" href="@Url.Action("HeatNetworkName", "HeatNetworkRegistration")">Change<span class="govuk-visually-hidden"> heat network Name</span></a>
                        </dd>
                    </div>
                    <div class="govuk-summary-list__row">
                        <dt class="govuk-summary-list__key">Additional description</dt>
                        <dd class="govuk-summary-list__value">@(!string.IsNullOrEmpty(additionalDescription) ? additionalDescription : "Not provided")</dd>
                        <dd class="govuk-summary-list__actions">
                            <a class="govuk-link" href="@Url.Action("HeatNetworkName", "HeatNetworkRegistration")">Change<span class="govuk-visually-hidden"> heat network description</span></a>
                        </dd>
                    </div>
                    <div class="govuk-summary-list__row">
                        <dt class="govuk-summary-list__key">Main energy centre address and postcode</dt>
                        <dd class="govuk-summary-list__value">@energyCentreAddress</dd>
                        <dd class="govuk-summary-list__actions">
                            <a class="govuk-link" href="@Url.Action("DoesHNHaveAPostcode", "HeatNetworkRegistration")">Change<span class="govuk-visually-hidden"> main energy centre address and postcode</span></a>
                        </dd>
                    </div>
                    <div class="govuk-summary-list__row">
                        <dt class="govuk-summary-list__key">Phase</dt>
                        <dd class="govuk-summary-list__value">@heatNetworkPhase</dd>
                        <dd class="govuk-summary-list__actions">
                            <a class="govuk-link" href="@Url.Action("HeatNetworkPhase", "HeatNetworkRegistration")">Change<span class="govuk-visually-hidden"> heat network phase</span></a>
                        </dd>
                    </div>
                </dl>

                <div class="govuk-form-group @(hasDeclarationErrors ? "govuk-form-group--error" : "")">
                    <fieldset class="govuk-fieldset" aria-describedby="@(hasDeclarationErrors ? "confirmDeclaration-error" : "")">

                        <legend class="govuk-visually-hidden">
                            Confirm declaration
                        </legend>

                        @if (hasDeclarationErrors)
                        {
                            <p id="confirmDeclaration-error" class="govuk-error-message">
                                <span class="govuk-visually-hidden">Error:</span> @Html.ValidationMessageFor(m => m.ConfirmedDeclaration)
                            </p>
                        }

                        <div class="govuk-checkboxes govuk-checkboxes--small data-module="govuk-checkboxes">
                            <div class="govuk-checkboxes__item">
                                <input class="govuk-checkboxes__input" id="confirmeddeclaration"
                                       asp-for="ConfirmedDeclaration"
                                       type="checkbox"
                                       required="required" />

                                <label for="confirmeddeclaration" class="govuk-label govuk-checkboxes__label">
                                    I confirm that the summary above is correct for @heatNetworkName@(!string.IsNullOrEmpty(additionalDescription) ? ", " + additionalDescription + "." : ".")
                                </label>
                            </div>
                        </div>
                    </fieldset>
                </div>

                <button type="submit" class="govuk-button" data-module="govuk-button">
                    Confirm
                </button>
            </form>
        </div>
    </div>        
</div>
@{
    ViewData["Title"] = "Confirmation";
}


<div class="govuk-width-container">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <h1 class="govuk-visually-hidden">
                Your heat network has been registered
            </h1>
            <div class="govuk-panel govuk-panel--confirmation">
                <span class="govuk-!-font-weight-bold">
                    Unique heat network ID
                </span><br />
                <span class="govuk-!-font-weight-regular">UHNID </span><span class="govuk-!-font-weight-bold">@ViewBag.HNId</span>
            </div><br/>
            <p class="govuk-body">We've:</p>
            <ul class="govuk-list govuk-list--bullet">
                <li>registered ds</li>
                <li>sent a confirmation email with the unique heat network ID (UHNID)</li>
            </ul>
            <p class="govuk-body">You can now provide technical information on your heat network and add team members to help you.</p>
                
            <a class="govuk-button" role="button" draggable="false" asp-controller="HeatNetworkRegistration" asp-action="HeatNetworkSuccessRedirection">
                Continue
            </a>
        </div>
    </div>
</div>
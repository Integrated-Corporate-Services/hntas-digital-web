@using HNTAS.Web.UI.Models.HeatNetworkRegistration
@model DistrictNetworksResponsibilityViewModel

@{
    ViewData["Title"] = "How many new connected district networks are you responsible for? - Add a heat network - GOV.UK";
}

<div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">

            <form asp-controller="@ViewBag.ControllerName" asp-action="DistrictNetworksResponsibility" method="post" novalidate>

                <div class="govuk-form-group @(ViewData.ModelState[nameof(Model.ResponsibleDistrictNetworks)]?.Errors.Count > 0 ? "govuk-form-group--error" : "")">

                    <h1 class="govuk-label-wrapper">
                        <span class="govuk-caption-l">Add a heat network</span>
                        <label class="govuk-label govuk-label--l" for="ResponsibleDistrictNetworks">
                            How many new connected district networks are you responsible for?
                        </label>
                    </h1>

                    <div id="district-networks-hint" class="govuk-hint">
                        Within HNTAS, responsibility means you are designing, constructing or operating new district networks beyond the connection point from this network.
                    </div>

                    @* Field Validation Error Message *@
                    @if (ViewData.ModelState[nameof(Model.ResponsibleDistrictNetworks)]?.Errors.Count > 0)
                    {
                        <p id="ResponsibleDistrictNetworks-error" class="govuk-error-message">
                            <span class="govuk-visually-hidden">Error:</span>
                            @ViewData.ModelState[nameof(Model.ResponsibleDistrictNetworks)]!.Errors[0].ErrorMessage
                        </p>
                    }

                    <label class="govuk-label" for="ResponsibleDistrictNetworks">
                        Number of new district networks
                    </label>

                    <input class="govuk-input govuk-input--width-5 @(ViewData.ModelState[nameof(Model.ResponsibleDistrictNetworks)]?.Errors.Count > 0 ? "govuk-input--error" : "")"
                           id="ResponsibleDistrictNetworks"
                           asp-for="ResponsibleDistrictNetworks"
                           type="text"
                           inputmode="numeric"
                           aria-describedby="district-networks-hint @(ViewData.ModelState[nameof(Model.ResponsibleDistrictNetworks)]?.Errors.Count > 0 ? "ResponsibleDistrictNetworks-error" : "")" />
                </div>

                <button type="submit" class="govuk-button" data-module="govuk-button">
                    Continue
                </button>

            </form>

        </div>
    </div>
@model HNTAS.Web.UI.Models.HeatNetworkNameModel
@{
    ViewData["Title"] = "What is the name of your heat network?";
    var heatNetworkNameId = Html.LowercaseIdFor(m => m.HeatNetworkName);
}

<div class="govuk-width-container">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <form asp-controller="HeatNetwork" asp-action="EnterHNName" method="post" novalidate>
                <div class="govuk-form-group @(ViewData.ModelState["HeatNetworkName"]?.Errors.Count > 0 ? "govuk-form-group--error" : "")">
                    <span class="govuk-caption-l">Add a heat network</span>
                    <label class="govuk-label" for="@heatNetworkNameId">
                        <h1 class="govuk-heading-l">What is your heat network name?</h1>
                    </label>
                    <p class="govuk-body">
                        Use the name your organisation uses for the heat network. You can add the location if it helps identify it.
                    </p>
                    <p class="govuk-body">
                        Heat Network Name
                    </p>
                    <p class="govuk-hint">
                        For example : Avenue Park Aberdeen
                    </p>
                    @if (ViewData.ModelState["HeatNetworkName"]?.Errors.Count > 0)
                    {
                        <span asp-validation-for="HeatNetworkName" class="govuk-error-message"></span>
                    }
                    <input class="govuk-input govuk-!-width-two-thirds" id="@heatNetworkNameId" name="@heatNetworkNameId" asp-for="HeatNetworkName" autocomplete="off" />
                </div>
                <button type="submit" class="govuk-button" data-module="govuk-button">
                    Continue
                </button>
            </form>
        </div>
    </div>
</div>
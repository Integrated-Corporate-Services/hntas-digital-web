@model HNTAS.Web.UI.Models.CarbonCalculatorViewModel

@{
    ViewData["Title"] = "Carbon Calculation Result";
}

<div class="govuk-width-container">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds govuk-!-padding-top-4">

            @if (Model?.TotalCarbonEmission is not null)
            {
                <!-- GOV.UK success notification banner -->
                <div class="govuk-panel govuk-panel--confirmation" aria-labelledby="result-banner-title" role="region">                    
                    <div class="govuk-panel__body">
                        Total Carbon Emission<br><strong>@Model.TotalCarbonEmission</strong>
                    </div>
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(Model?.Error))
            {
                <!-- show error text (no success banner) -->
                <div class="govuk-error-summary govuk-!-margin-top-4" role="alert">
                    <h2 class="govuk-error-summary__title">There is a problem</h2>
                    <div class="govuk-error-summary__body">@Model.Error</div>
                </div>
            }

            <div class="govuk-!-margin-top-6">
                <a class="govuk-button govuk-button--secondary" href="@Url.Action("Index", "CarbonCalculator")">Back to form</a>
            </div>
        </div>
    </div>
</div>
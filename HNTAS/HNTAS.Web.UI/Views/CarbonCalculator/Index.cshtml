<script>
    (function () {
        // Mapping helpers
        function arrayPathForContainer(containerId) {
            switch (containerId) {
                case 'chp-section': return 'Request.Energy.ChpInputs';
                case 'hp-section': return 'Request.Energy.HeatPumpInputs';
                case 'hrw-section': return 'Request.Energy.RecoveredInputs';
                case 'blr-section': return 'Request.Energy.BoilerInputs';
                default: return null;
            }
        }
        function countInputNameForContainer(containerId) {
            switch (containerId) {
                case 'chp-section': return 'Request.Energy.ChpCount';
                case 'hp-section': return 'Request.Energy.HeatPumpCount';
                case 'hrw-section': return 'Request.Energy.RecoveredCount';
                case 'blr-section': return 'Request.Energy.BoilerCount';
                default: return null;
            }
        }

        // Initialize a single repeater area
        function initRepeater(sectionId) {
            var container = document.getElementById(sectionId);
            if (!container) return;

            var addBtn = container.querySelector('.add-repeater-btn');
            var template = container.querySelector('.repeater-item.template');
            if (!template) return;

            // Add button handler: clone template and insert
            if (addBtn) {
                addBtn.addEventListener('click', function () {
                    addRepeaterItem(container, template);
                });
            }

            // Delegated handler for remove buttons inside this container
            container.addEventListener('click', function (ev) {
                var target = ev.target;
                if (target && target.classList && target.classList.contains('remove-repeater-btn')) {
                    var item = target.closest('.repeater-item');
                    if (!item) return;

                    // Only allow removing clones (items that weren't the original template-bound first item)
                    var items = container.querySelectorAll('.repeater-item:not(.template)');
                    if (items.length <= 1) return;

                    item.parentNode.removeChild(item);
                    renumberItems(container);
                    updateCountForContainer(container);
                }
            });

            // Ensure names/ids/count reflect current DOM (useful when server rendered model already contains items)
            renumberItems(container);
            updateCountForContainer(container);
        }

        // Add a new repeater item by cloning the template and assigning correct names for model binding.
        function addRepeaterItem(container, template) {
            var arrayPath = arrayPathForContainer(container.id);
            if (!arrayPath) return;

            var itemsBefore = container.querySelectorAll('.repeater-item:not(.template)');
            var newIndex = itemsBefore.length; // first visible is index 0, clones start at 1

            var clone = template.cloneNode(true);
            clone.classList.remove('template');
            clone.style.display = '';
            clone.removeAttribute('aria-hidden');

            // Update controls inside clone to have the expected id/name for model binding
            var elems = clone.querySelectorAll('[data-base]');
            elems.forEach(function (el) {
                var base = el.getAttribute('data-base');
                if (!base) return;

                var newId = base + '-' + newIndex;
                if (el.tagName.toLowerCase() === 'label') {
                    el.setAttribute('for', newId);
                    return;
                }

                el.id = newId;
                el.name = arrayPath + '[' + newIndex + '].' + base;

                // clear values on newly added clone so user starts with empty fields
                if ('value' in el) {
                    try { el.value = ''; } catch (e) { }
                }

                // keep data-base attribute for future renumbering
                el.setAttribute('data-base', base);
            });

            // Fix labels without data-base (set for attributes for consistency)
            var labels = clone.querySelectorAll('label');
            labels.forEach(function (lbl) {
                var base = lbl.getAttribute('data-base');
                if (base) {
                    lbl.setAttribute('for', base + '-' + newIndex);
                }
            });

            // Insert clone before template so template stays last
            template.parentNode.insertBefore(clone, template);

            // Ensure contiguous indexes/names if necessary (especially after removals)
            renumberItems(container);
            updateCountForContainer(container);

            // Focus first input of the new clone for UX
            var firstInput = clone.querySelector('input, select, textarea');
            if (firstInput) firstInput.focus();
        }

        // Renumber all visible items so their names/ids match server model-binding (contiguous 0..N-1)
        function renumberItems(container) {
            var arrayPath = arrayPathForContainer(container.id);
            if (!arrayPath) return;

            var items = Array.prototype.slice.call(container.querySelectorAll('.repeater-item:not(.template)'));
            items.forEach(function (item, i) {
                item.setAttribute('data-index', i);

                var elems = item.querySelectorAll('[data-base]');
                elems.forEach(function (el) {
                    var base = el.getAttribute('data-base');
                    if (!base) return;

                    var newId = base + '-' + i;
                    if (el.tagName.toLowerCase() === 'label') {
                        el.setAttribute('for', newId);
                        return;
                    }

                    el.id = newId;
                    el.name = arrayPath + '[' + i + '].' + base;
                    // keep existing value so user inputs aren't lost when renumbering
                    el.setAttribute('data-base', base);
                });

                // fix plain labels referencing data-base
                var labels = item.querySelectorAll('label');
                labels.forEach(function (lbl) {
                    var base = lbl.getAttribute('data-base');
                    if (base) lbl.setAttribute('for', base + '-' + i);
                });
            });
        }

        // Update the corresponding Count input to reflect the number of visible items
        function updateCountForContainer(container) {
            var countName = countInputNameForContainer(container.id);
            if (!countName) return;
            var countInput = document.querySelector('[name="' + countName + '"]');
            if (!countInput) return;
            var items = container.querySelectorAll('.repeater-item:not(.template)');
            countInput.value = items.length;
        }

        // Init repeaters on DOMContentLoaded
        document.addEventListener('DOMContentLoaded', function () {
            ['chp-section', 'hp-section', 'hrw-section', 'blr-section'].forEach(function (id) {
                initRepeater(id);
            });
        });
    })();
</script>

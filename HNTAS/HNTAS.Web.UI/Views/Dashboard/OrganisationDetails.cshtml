@using HNTAS.Web.UI.Models
@model OrganisationDetailsModel

@{
    ViewData["Title"] = "Organisation Details";

    // Helper to filter out empty address lines and join them with line breaks
    var addressLines = new[] {
        Model.AddressLine1,
        Model.AddressLine2,
        Model.Town,
        Model.County,
        Model.Postcode,
        Model.Country
    }.Where(line => !string.IsNullOrWhiteSpace(line));

    var companyNumber = !string.IsNullOrEmpty(Model.CompanyHouseNumber) ? @Model.CompanyHouseNumber : "Not applicable";
}

@section BeforeMain {

    <nav class="govuk-breadcrumbs" aria-label="Breadcrumb">
        <ol class="govuk-breadcrumbs__list">
            <li class="govuk-breadcrumbs__list-item">
                <a class="govuk-breadcrumbs__link" href="@Url.Action("UserAccount", "Dashboard")">Dashboard</a>
            </li>
            <li class="govuk-breadcrumbs__list-item">
                Organisation details
            </li>
        </ol>
    </nav>
}


    <div class="govuk-grid-row">
        <div class="govuk-grid-column-full">
            <span class="govuk-caption-l">@ViewBag.OrganisationName</span>        
            <h1 class="govuk-heading-l">Organisation details</h1>

        @if (ViewBag.IsUserAnRp != true && ViewBag.IsMultipleOrganisation == true)
        {
            <div class="govuk-body">
                <a class="govuk-link" href="@Url.Action("SwitchOrganisation", "Dashboard")">Switch organisation</a> to view the networks for the organisation
            </div>
        }        

            <dl class="govuk-summary-list govuk-!-margin-bottom-7">
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">Organisation reference number</dt>
                <dd class="govuk-summary-list__value">@Model.OrganisationId</dd>
            </div>
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">Organisation type</dt>
                <dd class="govuk-summary-list__value">@Model.OrganisationType</dd>
            </div>
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">Company number</dt>
                <dd class="govuk-summary-list__value">@companyNumber</dd>
            </div>
                <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">Organisation name and address</dt>                    
                    <dd class="govuk-summary-list__value">
                    @Model.OrganisationName <br />
                        @foreach (var line in addressLines)
                        {
                            @line
                            <br />
                        }
                    </dd>
                </div>                

                <div class="govuk-summary-list__row">
                    <dt class="govuk-summary-list__key">Email address</dt>
                    <dd class="govuk-summary-list__value">@Model.RPEmail</dd>
                </div>                
            </dl>            
        </div>
    </div>

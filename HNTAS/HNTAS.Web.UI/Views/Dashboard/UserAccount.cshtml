@{
    ViewData["Title"] = "User Account";
}

<div class="govuk-width-container">
    <main class="govuk-main-wrapper" id="main-content" role="main">
        

        <div>
            <div><span class="govuk-hint">Your organisation</span></div>
            <div><span class="govuk-heading-l">ABC limited</span></div>
            <div style="background: #f3f2f1; padding: 1rem; border-radius: 2px; width: 250px;">
                <div class="govuk-body" style="font-weight: 500; color: #1d70b8; margin-bottom: 0.5rem;">Organisation details</div>
                <div class="govuk-body" style="color: #505a5f;">View or change your organisation's details</div>
            </div>
        </div>

        <h2 class="govuk-heading-m" style="margin-top: 2rem;">My heat network list</h2>
        <table class="govuk-table">
            <thead class="govuk-table__head">
                <tr class="govuk-table__row">
                    <th class="govuk-table__header" scope="col">Heat network name</th>
                    <th class="govuk-table__header" scope="col">Organisation</th>
                    <th class="govuk-table__header" scope="col">Status</th>
                    <th class="govuk-table__header" scope="col">Action</th>
                </tr>
            </thead>
            <tbody class="govuk-table__body">
                <tr class="govuk-table__row">
                    <td class="govuk-table__cell">Corporate heat provider</td>
                    <td class="govuk-table__cell">ABC Limited</td>
                    <td class="govuk-table__cell">
                        <span class="govuk-tag govuk-tag--green" style="background: #d5e8d4; color: #005a30;">Active</span>
                    </td>
                    <td class="govuk-table__cell">
                        <a class="govuk-link" href="#">View/Edit</a>
                    </td>
                </tr>
            </tbody>
        </table>
    </main>
</div>

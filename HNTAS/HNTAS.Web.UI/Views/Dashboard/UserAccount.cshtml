@using HNTAS.Web.UI.Models

@model DashboardModel

@{
    ViewData["Title"] = "User Account";
    var disabled = Model.HasHeatNetworks ? "" : "dashboard-card--disabled";
}

<div class="govuk-width-container">
    @if (Model.UserRole == HNTAS.Api.Client.Model.UserRole.ResponsiblePerson.ToString())
    {
        <div><span class="govuk-hint">Your organisation</span></div>
        <h1 class="govuk-heading-l">@Model.OrganisationName</h1>

        <div class="govuk-grid-row" style="display: flex; align-items: stretch;">
            <div class="govuk-grid-column-one-third">
                <div class="dashboard-card">
                    <h3 class="dashboard-card__title govuk-heading-s">
                        <a asp-controller="Dashboard" asp-action="OrganisationDetails" class="govuk-link govuk-link--no-visited-state">Organisation details</a>
                    </h3>
                    <p class="govuk-body-s">View or change your organisation's details.</p>
                    <span class="govuk-tag govuk-tag--green">Submitted</span>
                </div>
            </div>
       
            <div class="govuk-grid-column-one-third">
                <div class="dashboard-card @disabled">
                    <h3 class="dashboard-card__title govuk-heading-s">
                        <a class="govuk-link govuk-link--no-visited-state" asp-action="ManageUsers" asp-controller="UserManagement"> Manage user</a>
                    </h3>
                    <p class="govuk-body-s">Register a heat network to activate manage users.</p>

                </div>
            </div>
            <div class="govuk-grid-column-one-third">
                <div class="dashboard-card">
                    <h3 class="dashboard-card__title govuk-heading-s">
                        <a class="govuk-link govuk-link--no-visited-state" asp-action="HeatNetworks" asp-controller="UserManagement">Your heat networks</a>
                    </h3>
                    <p class="govuk-body-s">View the heat network to be assessed.</p>

                </div>
            </div>
            <div class="govuk-grid-column-one-third">
                <div class="dashboard-card @disabled">
                    <h3 class="dashboard-card__title govuk-heading-s">
                        <a class="govuk-link govuk-link--no-visited-state" asp-action="AddContributor" asp-controller="UserManagement"> Contributors</a>
                    </h3>
                    <p class="govuk-body-s">You can add or view contributors to your heat network.</p>

                </div>
            </div>           
        </div>
        <br />
        <br />
        <br />
        <br />
        <div class="govuk-grid-row" style="display: flex; align-items: stretch;">
            <div class="govuk-grid-column-one-third">
                <div class="dashboard-card">
                    <h3 class="dashboard-card__title govuk-heading-s">
                        <a asp-controller="UserManagement" asp-action="ChangeOrganisationUser" class="govuk-link govuk-link--no-visited-state">Manage Organisation Roles</a>
                    </h3>
                    <p class="govuk-body-s">View or change user roles and permissions within your organisation.</p>
                </div>
            </div>
            <div class="govuk-grid-column-one-quarter">
                <div class="dashboard-card">
                    <h3 class="dashboard-card__title govuk-heading-s">
                        <a class="govuk-link govuk-link--no-visited-state" asp-action="Index" asp-controller="CarbonCalculator">Carbon Calculator</a>
                    </h3>
                    <p class="govuk-body-s">Calculate carbon emission for your heat network.</p>
                </div>
            </div>
        </div>

        <br />
        <br />
    }
    else if (Model.UserRole == HNTAS.Api.Client.Model.UserRole.Assessor.ToString())
    {
        <h1 class="govuk-heading-l">My Details</h1>

        <div class="govuk-grid-row" style="display: flex; align-items: stretch;">
            @if (Model.OrganisationName == null)
            {
                <div class="govuk-grid-column-one-quarter">
                    <div class="dashboard-card">
                        <h3 class="dashboard-card__title govuk-heading-s">
                            <a class="govuk-link govuk-link--no-visited-state" asp-controller="ExistingOrganisation" asp-action="AddOrRegister">
                                Add Organisation Details
                            </a>
                        </h3>
                        <p class="govuk-body-s">Add or register the organisation you work for.</p>
                    </div>
                </div>
            }
            else
            {
                <div class="govuk-grid-column-one-quarter">
                    <div class="dashboard-card">
                        <h3 class="dashboard-card__title govuk-heading-s">
                            <a asp-controller="Dashboard" asp-action="OrganisationDetails" class="govuk-link govuk-link--no-visited-state">Organisation details</a>
                        </h3>
                        <p class="govuk-body-s">View or change your organisation's details.</p>
                    </div>
                </div>
            }

            <div class="govuk-grid-column-one-third">
                <div class="dashboard-card @disabled">
                    <h3 class="dashboard-card__title govuk-heading-s">
                        <a class="govuk-link govuk-link--no-visited-state" asp-action="UserDetails" asp-controller="Assessor">User Details</a>
                    </h3>
                    <p class="govuk-body-s">View your details</p>

                </div>
            </div>
            <div class="govuk-grid-column-one-third">
                <div class="dashboard-card @disabled">
                    <h3 class="dashboard-card__title govuk-heading-s">
                        <a class="govuk-link govuk-link--no-visited-state" asp-action="HeatNetworks" asp-controller="UserManagement">Your heat networks</a>
                    </h3>
                    <p class="govuk-body-s">View the heat network to be assessed.</p>

                </div>
            </div>
            <div class="govuk-grid-column-one-quarter">
                <div class="dashboard-card">
                    <h3 class="dashboard-card__title govuk-heading-s">
                        <a class="govuk-link govuk-link--no-visited-state" asp-action="Index" asp-controller="CarbonCalculator">Carbon Calculator</a>
                    </h3>
                    <p class="govuk-body-s">Calculate carbon emission for your heat network.</p>
                </div>
            </div>
        </div>
        <br/>
        <br/>
    }
    else if (Model.UserRole == HNTAS.Api.Client.Model.UserRole.Certifier.ToString())
    {
        <h1 class="govuk-heading-l">My Details</h1>

        <div class="govuk-grid-row" style="display: flex; align-items: stretch;">
            <div class="govuk-grid-column-one-third">
                <div class="dashboard-card">
                    <h3 class="dashboard-card__title govuk-heading-s">
                        <a asp-controller="Dashboard" asp-action="OrganisationDetails" class="govuk-link govuk-link--no-visited-state">Organisation details</a>
                    </h3>
                    <p class="govuk-body-s">View or change your organisation's details.</p>
                </div>
            </div>

            <div class="govuk-grid-column-one-third">
                <div class="dashboard-card @disabled">
                    <h3 class="dashboard-card__title govuk-heading-s">
                        <a class="govuk-link govuk-link--no-visited-state" asp-action="UserDetails" asp-controller="Assessor">User Details</a>
                    </h3>
                    <p class="govuk-body-s">View your details</p>

                </div>
            </div>
            <div class="govuk-grid-column-one-third">
                <div class="dashboard-card @disabled">
                    <h3 class="dashboard-card__title govuk-heading-s">
                        <a class="govuk-link govuk-link--no-visited-state" asp-action="HeatNetworks" asp-controller="UserManagement">Networks for certification</a>
                    </h3>
                    <p class="govuk-body-s">View networks assigned to you.</p>

                </div>
            </div>
            <div class="govuk-grid-column-one-quarter">
                <div class="dashboard-card">
                    <h3 class="dashboard-card__title govuk-heading-s">
                        <a class="govuk-link govuk-link--no-visited-state" asp-action="Index" asp-controller="CarbonCalculator">Carbon Calculator</a>
                    </h3>
                    <p class="govuk-body-s">Calculate carbon emission for your heat network.</p>
                </div>
            </div>
        </div>
        <br />
        <br />
    }
    else
    {
        <h1 class="govuk-heading-l">My Details</h1>

        <div class="govuk-grid-row" style="display: flex; align-items: stretch;">

            @if (Model.OrganisationName == null)
            {
                <div class="govuk-grid-column-one-quarter">
                    <div class="dashboard-card">
                    <h3 class="dashboard-card__title govuk-heading-s">
                        <a class="govuk-link govuk-link--no-visited-state" asp-controller="ExistingOrganisation" asp-action="AddOrRegister">
                            Add Organisation Details
                        </a>
                    </h3>
                    <p class="govuk-body-s">Add or register the organisation you work for.</p>
                    </div>
                </div>
            }
            else
            {
                <div class="govuk-grid-column-one-quarter">
                    <div class="dashboard-card">
                        <h3 class="dashboard-card__title govuk-heading-s">
                            <a asp-controller="Dashboard" asp-action="OrganisationDetails" class="govuk-link govuk-link--no-visited-state">Organisation details</a>
                        </h3>
                        <p class="govuk-body-s">View or change your organisation's details.</p>
                    </div>
                </div>
            }

            <div class="govuk-grid-column-one-quarter">
                <div class="dashboard-card">
                    <h3 class="dashboard-card__title govuk-heading-s">
                        <a class="govuk-link govuk-link--no-visited-state" asp-action="ManageUsers" asp-controller="UserManagement">Manage user</a>
                    </h3>
                    <p class="govuk-body-s">View or add users to your heat network.</p>
                </div>
            </div>

            <div class="govuk-grid-column-one-quarter">
                <div class="dashboard-card @disabled">
                    <h3 class="dashboard-card__title govuk-heading-s">
                        <a class="govuk-link govuk-link--no-visited-state" asp-action="HeatNetworks" asp-controller="UserManagement">Your heat networks</a>
                    </h3>
                    <p class="govuk-body-s">View, add or edit heat network details.</p>
                </div>
            </div>

            <div class="govuk-grid-column-one-quarter">
                <div class="dashboard-card @disabled">
                    <h3 class="dashboard-card__title govuk-heading-s">
                        <a class="govuk-link govuk-link--no-visited-state" asp-action="AddContributor" asp-controller="UserManagement">Contributors</a>
                    </h3>
                    <p class="govuk-body-s">You can add or view contributors to your heat network.</p>
                </div>
            </div>

            <div class="govuk-grid-column-one-quarter">
                <div class="dashboard-card">
                    <h3 class="dashboard-card__title govuk-heading-s">
                        <a class="govuk-link govuk-link--no-visited-state" asp-action="Index" asp-controller="CarbonCalculator">Carbon Calculator</a>
                    </h3>
                    <p class="govuk-body-s">Calculate carbon emission for your heat network.</p>
                </div>
            </div>
        </div>


        <br />
        <br />
    }

</div>
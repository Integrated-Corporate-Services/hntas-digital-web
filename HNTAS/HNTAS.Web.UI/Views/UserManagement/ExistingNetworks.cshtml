@model HNTAS.Web.UI.Models.ExistingNetworksViewModel

<h1 class="govuk-heading-l">Heat networks</h1>

@if (Model.HeatNetworks != null && Model.HeatNetworks.Any())
{    
    <table class="govuk-table">
        <thead class="govuk-table__head">
            <tr class="govuk-table__row">
                <th class="govuk-table__header" scope="col">Ofgem imported date</th>
                <th class="govuk-table__header" scope="col">Heat network</th>                
                <th class="govuk-table__header" scope="col">Action</th>                
            </tr>
        </thead>
        <tbody class="govuk-table__body">
            @foreach (var heatNetwork in Model.HeatNetworks)
            {
                <tr class="govuk-table__row">
                    <td class="govuk-table__cell">@heatNetwork.OfgemImportedDate!.Value.ToString("dd/MM/yyyy")</td>
                    <td class="govuk-table__cell">
                        @heatNetwork.HnId<br />
                        @heatNetwork.Name<br/>
                        @heatNetwork.HnDescription
                    </td>                                                    
                    
                    <td class="govuk-table__cell">
                        <a class="govuk-link govuk-link--no-visited-state" href="@Url.Action("AddNetworkDetails", "HeatNetwork", new { hnId = @heatNetwork.HnId })">Register with HNTAS</a>
                    </td>                                                              
                </tr>
            }
        </tbody>
    </table>
}
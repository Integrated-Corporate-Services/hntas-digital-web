@using System.Collections.Generic;
@using HNTAS.Web.UI.Helpers
@model HNTAS.Web.UI.Models.User.ManageUsersModel

@{
    ViewData["Title"] = "Manage users"; // This sets the title that might be used in the _Layout.cshtml
}

 <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
        <h1 class="govuk-heading-l">
            <span class="govuk-caption-xl">@Model.OrganisationName</span>
            Manage users
        </h1>

        <h2 class="govuk-heading-m">Users</h2>
        <div class="govuk-overflow-container">
            <table class="govuk-table">
            <thead class="govuk-table__head">
                <tr class="govuk-table__row">
                    <th scope="col" class="govuk-table__header">Name</th>
                    <th scope="col" class="govuk-table__header">Email address</th>
                    <th scope="col" class="govuk-table__header">Heat network name</th>
                    <th scope="col" class="govuk-table__header">Status</th>
                    <td scope="col" class="govuk-table__header"></td>
                </tr>
            </thead>
            <tbody class="govuk-table__body">
            @foreach (var user in Model.Users)
            {
                <tr class="govuk-table__row">
                    <td class="govuk-table__cell">
                        @user.Name
                        @if (user.Roles != null && user.Roles.Any())
                        {
                            <br /> <span class="govuk-body govuk-!-font-size-16 govuk-!-margin-top-1">(@string.Join(", ", user.Roles))</span>
                        }
                    </td>
                    <td class="govuk-table__cell">@user.EmailAddress</td>
                    <td class="govuk-table__cell">
                        <span class="govuk-body govuk-!-font-size-16 govuk-!-margin-top-1">@string.Join(", ", user.HeatNetworks)</span>
                    </td>
                    <td class="govuk-table__cell">
                        <strong class="govuk-tag @GovUkTagHelper.GetTagClass(user.Status)">
                            @user.Status
                        </strong>
                    </td>                      
                    <td class="govuk-table__cell govuk-table__cell--numeric">
                        @if (user.IsCurrentUser)
                        {
                            <a class="govuk-link govuk-link--no-visited-state" data-module="govuk-button" asp-action="ContactDetails" asp-controller="UserDetails" asp-flowtype="edit" >View</a>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
        </div>           
    </div>
</div>
@model HNTAS.Web.UI.Models.Contributors.ExistingContributorsListViewModel

@{
    ViewData["Title"] = "Select someone from your current list";
}

<div class="govuk-width-container">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <span class="govuk-caption-l">Your network team</span>

            <h1 class="govuk-heading-l">
                Select someone from your current list
            </h1>

            <form method="post">
                @Html.AntiForgeryToken()
                @if (Model.Contributors == null)
                {
                    <p class="govuk-body">No contributors found for the current user.</p>
                }
                else
                {
                    <div class="govuk-form-group">
                        <span class="govuk-error-message" asp-validation-for="SelectedEmailAddress"></span>
                        <select class="govuk-select" asp-for="SelectedEmailAddress" asp-items="Model.Contributors.Select(x => new SelectListItem { Value = x.EmailAddress, Text = x.EmailAddress })">
                            <option value="">-- Select --</option>
                        </select>
                    </div>
                    <button class="govuk-button" type="submit">
                        Continue
                    </button>
                }               
            </form>
        </div>
    </div>
</div>
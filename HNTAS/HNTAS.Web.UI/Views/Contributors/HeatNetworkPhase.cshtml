@using HNTAS.Web.UI.Models.Components
@using HNTAS.Web.UI.Models.Common
@using HNTAS.Web.UI.Models.Contributors
@model HeatNetworkPhaseViewModel

@{
    ViewData["Title"] = "What phases are the designated duty holder responsible for?";
    var fieldId = Html.LowercaseIdFor(m => m.SelectedPhases);
}

<div class="govuk-width-container">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">

            <span class="govuk-caption-l">Your network team</span>

            <form asp-action="" method="post">

                <div class="govuk-form-group @(Html.HasError(nameof(Model.SelectedPhases)) ? "govuk-form-group--error" : "")">
                    <fieldset class="govuk-fieldset" aria-describedby="nationality-hint nationality-error">
                        <legend class="govuk-fieldset__legend govuk-fieldset__legend--l">
                            <h1 class="govuk-fieldset__heading">
                                What phases are the designated duty holder responsible for?
                            </h1>
                        </legend>
                        
                        @if (Html.HasError(nameof(Model.SelectedPhases)))
                        {
                            <p id="@fieldId-error" class="govuk-error-message">
                                <span class="govuk-visually-hidden">Error:</span> @Html.ValidationMessageFor(m => m.SelectedPhases)
                            </p>
                        }

                        @await Html.PartialAsync("Components/_GovUkCheckboxList", new GovUkCheckboxListModel
                        {
                            FieldId = Html.LowercaseIdFor(m => m.SelectedPhases),
                            FieldName = nameof(Model.SelectedPhases),
                            SelectedValues = Model.SelectedPhases,
                            Items = Model.Phases
                        })
                    </fieldset>
                </div>
                <button type="submit" class="govuk-button" data-module="govuk-button">
                    Continue
                </button>
            </form>
        </div>

    </div>
</div>

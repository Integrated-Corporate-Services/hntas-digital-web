@using HNTAS.Web.UI.Models.Contributors
@model ManageContributorsViewModel

@{
    ViewData["Title"] = "Duty holders and contributors – Certify your heat networks";

    string GetNextDirection(string column)
    {
        if (Model.SortBy.Equals(column, StringComparison.OrdinalIgnoreCase))
        {
            return Model.SortDirection == "asc" ? "desc" : "asc";
        }
        return "asc";
    }

    string GetAriaSort(string column)
    {
        if (Model.SortBy.Equals(column, StringComparison.OrdinalIgnoreCase))
        {
            return Model.SortDirection == "asc" ? "ascending" : "descending";
        }
        return "none";
    }

    string GetSortUrl(string column)
    {
        return Url.Action("ManageContributors", new
        {
            pageNumber = Model.PageNumber,
            pageSize = Model.PageSize,
            sortBy = column,
            sortDirection = GetNextDirection(column)
        }) ?? "#";
    }

    Microsoft.AspNetCore.Html.IHtmlContent GetSortIcon(string column)
    {
        if (Model.SortBy.Equals(column, StringComparison.OrdinalIgnoreCase))
        {
            if (Model.SortDirection == "asc")
            {
                return Html.Raw("<svg class='govuk-!-margin-left-1' width='12' height='12' viewBox='0 0 12 12' fill='none' xmlns='http://www.w3.org/2000/svg' aria-hidden='true' focusable='false'><path d='M6 2L10 8H2L6 2Z' fill='currentColor'/></svg>");
            }
            else
            {
                return Html.Raw("<svg class='govuk-!-margin-left-1' width='12' height='12' viewBox='0 0 12 12' fill='none' xmlns='http://www.w3.org/2000/svg' aria-hidden='true' focusable='false'><path d='M6 10L2 4H10L6 10Z' fill='currentColor'/></svg>");
            }
        }
        return Html.Raw(string.Empty);
    }
}

<style>
    .govuk-pagination__item {
        display: block !important;
        text-align: center;
    }
</style>

@section BeforeMain {
    <nav class="govuk-breadcrumbs" aria-label="Breadcrumb">
        <ol class="govuk-breadcrumbs__list">
            <li class="govuk-breadcrumbs__list-item">
                <a class="govuk-breadcrumbs__link" href="@Url.Action("UserAccount", "Dashboard")">Dashboard</a>
            </li>
            <li class="govuk-breadcrumbs__list-item" aria-current="page">
                @ViewBag.WhoDoYouWantToAdd
            </li>
        </ol>
    </nav>
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-full">

        <span class="govuk-caption-l">@ViewBag.OrganisationName</span>
        <h1 class="govuk-heading-l">@ViewBag.WhoDoYouWantToAdd</h1>

        <div class="govuk-!-margin-bottom-6">
            <a asp-action="Start" class="govuk-button" data-module="govuk-button">
                Add a person
            </a>
        </div>

        <h2 class="govuk-heading-m">Current duty holders and contributors</h2>

        @if (Model.Contributors != null && Model.Contributors.Any())
        {
            <div class="govuk-table-container">
                <table class="govuk-table">
                    <thead class="govuk-table__head">
                        <tr class="govuk-table__row">
                            <th scope="col" class="govuk-table__header" aria-sort="@GetAriaSort("Name")">
                                <a class="govuk-link govuk-link--no-visited-state" href="@GetSortUrl("Name")">
                                    Name @GetSortIcon("Name")
                                </a>
                            </th>
                            <th scope="col" class="govuk-table__header" aria-sort="@GetAriaSort("Email")">
                                <a class="govuk-link govuk-link--no-visited-state" href="@GetSortUrl("Email")">
                                    Email @GetSortIcon("Email")
                                </a>
                            </th>
                            <th scope="col" class="govuk-table__header">
                                <a class="govuk-link govuk-link--no-visited-state">
                                    Organisation name
                                </a>
                            </th>
                        </tr>
                    </thead>
                    <tbody class="govuk-table__body">
                        @foreach (var contributor in Model.Contributors)
                        {
                            <tr class="govuk-table__row">
                                <td class="govuk-table__cell">
                                    <a class="govuk-link" asp-action="ViewContributor" asp-route-id="@contributor.Id">
                                        @contributor.Name
                                    </a>
                                </td>
                                <td class="govuk-table__cell">@contributor.Email</td>
                                <td class="govuk-table__cell">@contributor.OrganisationName</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.TotalPages > 1)
            {
                <nav class="govuk-pagination" role="navigation" aria-label="Pagination">
                    @if (Model.PageNumber > 1)
                    {
                        <div class="govuk-pagination__prev">
                            <a class="govuk-link govuk-pagination__link" href="@Url.Action("ManageContributors", new { pageNumber = Model.PageNumber - 1, pageSize = Model.PageSize, sortBy = Model.SortBy, sortDirection = Model.SortDirection })" rel="prev">
                                <svg class="govuk-pagination__icon govuk-pagination__icon--prev" xmlns="http://www.w3.org/2000/svg" height="13" width="15" aria-hidden="true" focusable="false" viewBox="0 0 15 13">
                                    <path d="m6.5938-0.0078125-6.7266 6.7266 6.7441 6.4062 1.377-1.449-4.1856-3.9768h12.896v-2h-12.984l4.2931-4.293-1.414-1.414z"></path>
                                </svg>
                                <span class="govuk-pagination__link-title">Previous</span>
                            </a>
                        </div>
                    }

                    <ul class="govuk-pagination__list">
                        @{
                            var pagesToShow = new List<int>();

                            void AddPage(int page)
                            {
                                if (page >= 1 && page <= Model.TotalPages && !pagesToShow.Contains(page))
                                {
                                    pagesToShow.Add(page);
                                }
                            }

                            AddPage(1);
                            AddPage(Model.PageNumber - 1);
                            AddPage(Model.PageNumber);
                            AddPage(Model.PageNumber + 1);
                            AddPage(Model.TotalPages);

                            pagesToShow.Sort();

                            int? previousPage = null;

                            foreach (var i in pagesToShow)
                            {
                                if (previousPage.HasValue && i - previousPage.Value > 1)
                                {
                                    <li class="govuk-pagination__item govuk-pagination__item--ellipses" aria-hidden="true">...</li>
                                }
                                if (i == Model.PageNumber)
                                {
                                    <li class="govuk-pagination__item govuk-pagination__item--current">
                                        <a class="govuk-link govuk-pagination__link" href="#" aria-label="Page @i" aria-current="page">@i</a>
                                    </li>
                                }
                                else
                                {
                                    <li class="govuk-pagination__item">
                                        <a class="govuk-link govuk-pagination__link" href="@Url.Action("ManageContributors", new { pageNumber = i, pageSize = Model.PageSize, sortBy = Model.SortBy, sortDirection = Model.SortDirection })" aria-label="Page @i">
                                            @i
                                        </a>
                                    </li>
                                }
                                previousPage = i;
                            }
                        }
                    </ul>

                    @if (Model.PageNumber < Model.TotalPages)
                    {
                        <div class="govuk-pagination__next">
                            <a class="govuk-link govuk-pagination__link" href="@Url.Action("ManageContributors", new { pageNumber = Model.PageNumber + 1, pageSize = Model.PageSize, sortBy = Model.SortBy, sortDirection = Model.SortDirection })" rel="next">
                                <span class="govuk-pagination__link-title">Next</span>
                                <svg class="govuk-pagination__icon govuk-pagination__icon--next" xmlns="http://www.w3.org/2000/svg" height="13" width="15" aria-hidden="true" focusable="false" viewBox="0 0 15 13">
                                    <path d="m8.107-0.0078125-1.4136 1.414 4.2926 4.293h-12.986v2h12.896l-4.1855 3.9766 1.377 1.4492 6.7441-6.4062-6.7246-6.7266z"></path>
                                </svg>
                            </a>
                        </div>
                    }
                </nav>
            }
        }
        else
        {
            <p class="govuk-body">No current duty holders or contributors found.</p>
        }

    </div>
</div>
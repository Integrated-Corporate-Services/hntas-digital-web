@using HNTAS.Web.UI.Models.Components
@using HNTAS.Web.UI.Models.NetworkElements
@model NewAndExistingNetworkElementSummaryViewModel

<div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
        <span class="govuk-caption-l">HN2000154 asdf, sf</span>
        <h1 class="govuk-heading-l">Heat network element summary</h1>
        <div class="govuk-hint">
            You have told us you have the following elements on your network:
        </div>
        <form asp-action="NewAndExistingNetworkElementSummary" method="post" novalidate>
        <div class="govuk-summary-card">
            <div class="govuk-summary-card__title-wrapper">
                <h2 class="govuk-summary-card__title">
                    Elements
                </h2>
                <ul class="govuk-summary-card__actions">
                    <li class="govuk-summary-card__action">
                            <a class="govuk-link" href="@Url.Action("NewAndExistingNetworkElements", "NetworkElements")">Change<span class="govuk-visually-hidden"> (University of Gloucestershire)</span></a>
                    </li>                    
                </ul>
            </div>
            <div class="govuk-summary-card__content">
                <dl class="govuk-summary-list">
                    <div class="govuk-summary-list__row">
                        <dt class="govuk-summary-list__key">
                            Existing
                        </dt>
                        <dd class="govuk-summary-list__value">
                            <ul>
                                @foreach(var existingEl in Model.ExistingNetworkElements!)
                                {
                                    <li>@existingEl</li>
                                }                                
                            </ul>
                        </dd>
                    </div>                    
                </dl>
            </div> 
        </div>

        <div class="govuk-summary-card">
            <div class="govuk-summary-card__title-wrapper">
                <h2 class="govuk-summary-card__title">
                    Elements
                </h2>
                <ul class="govuk-summary-card__actions">
                    <li class="govuk-summary-card__action">
                            <a class="govuk-link" href="@Url.Action("NewAndExistingNetworkElements", "NetworkElements")">Change<span class="govuk-visually-hidden"> (University of Gloucestershire)</span></a>
                    </li>
                </ul>
            </div>
            <div class="govuk-summary-card__content">
                <dl class="govuk-summary-list">
                    <div class="govuk-summary-list__row">
                        <dt class="govuk-summary-list__key">
                            New
                        </dt>
                        <dd class="govuk-summary-list__value">
                            <ul>
                                @foreach (var newEl in Model.NewNetworkElements!)
                                {
                                    <li>@newEl</li>
                                }
                            </ul>
                        </dd>
                    </div>
                </dl>
            </div>
        </div>

        <div class="govuk-summary-card">
            <div class="govuk-summary-card__title-wrapper">
                <h2 class="govuk-summary-card__title">
                    Energy centre names
                </h2>
                <ul class="govuk-summary-card__actions">
                    <li class="govuk-summary-card__action">
                            <a class="govuk-link" href="@Url.Action("NewAndExistingNetworkEnergyCentreName", "NetworkElements")">Change<span class="govuk-visually-hidden"> (University of Gloucestershire)</span></a>
                    </li>
                </ul>
            </div>
            <div class="govuk-summary-card__content">
                <dl class="govuk-summary-list">
                    <div class="govuk-summary-list__row">
                        <dt class="govuk-summary-list__key">
                            Existing
                        </dt>
                        <dd class="govuk-summary-list__value">
                            <ul>
                                @foreach (var existingName in Model.ExistingNetworkEcNames!)
                                {
                                    <li>@existingName</li>
                                }
                            </ul>
                        </dd>
                    </div>
                </dl>
            </div>
        </div>

        <div class="govuk-summary-card">
            <div class="govuk-summary-card__title-wrapper">
                <h2 class="govuk-summary-card__title">
                    Energy centre names
                </h2>
                <ul class="govuk-summary-card__actions">
                    <li class="govuk-summary-card__action">
                            <a class="govuk-link" href="@Url.Action("NewAndExistingNetworkEnergyCentreName", "NetworkElements")">Change<span class="govuk-visually-hidden"> (University of Gloucestershire)</span></a>
                    </li>
                </ul>
            </div>
            <div class="govuk-summary-card__content">
                <dl class="govuk-summary-list">
                    <div class="govuk-summary-list__row">
                        <dt class="govuk-summary-list__key">
                            New
                        </dt>
                        <dd class="govuk-summary-list__value">
                            <ul>
                                @foreach (var newName in Model.NewNetworkEcNames!)
                                {
                                    <li>@newName</li>
                                }
                            </ul>
                        </dd>
                    </div>
                </dl>
            </div>
        </div>

        <div class="govuk-summary-card">
            <div class="govuk-summary-card__title-wrapper">
                <h2 class="govuk-summary-card__title">
                    Existing energy centre supplying new buildings
                </h2>
                <ul class="govuk-summary-card__actions">
                    <li class="govuk-summary-card__action">
                            <a class="govuk-link" href="@Url.Action("NewAndExistingEnergyCentresSupply", "NetworkElements")">Change<span class="govuk-visually-hidden"> (University of Gloucestershire)</span></a>
                    </li>
                </ul>
            </div>
            <div class="govuk-summary-card__content">
                <dl class="govuk-summary-list">
                    <div class="govuk-summary-list__row">
                        <dt class="govuk-summary-list__key">
                            Existing
                        </dt>
                        <dd class="govuk-summary-list__value">
                            <ul>
                                @foreach (var existingEcSupplying in Model.ExistingEcSupplyingNewBuilding!)
                                {
                                    <li>@existingEcSupplying</li>
                                }
                            </ul>
                        </dd>
                    </div>
                </dl>
            </div>
        </div>

        @{
            var hasDeclarationErrors = ViewData.ModelState.ContainsKey(nameof(Model.ConfirmedDeclaration)) && ViewData.ModelState[nameof(Model.ConfirmedDeclaration)].Errors.Any();
            var confirmDeclarationComponentData = new ConfirmDeclarationCheckboxModel
            {
                Id = nameof(Model.ConfirmedDeclaration),
                Name = nameof(Model.ConfirmedDeclaration).ToLower(),
                Label = $"I confirm that the summary above is correct for HNName, desc",
                HasError = hasDeclarationErrors,
                ErrorMessage = hasDeclarationErrors ? ViewData.ModelState[nameof(Model.ConfirmedDeclaration)].Errors[0].ErrorMessage : null,
                Value = Model.ConfirmedDeclaration
            };

            @await Html.PartialAsync("Components/_ConfirmDeclaration", confirmDeclarationComponentData)

            <button type="submit" class="govuk-button" data-module="govuk-button">
                Confirm
            </button>
        }
        </form>
    </div>
</div>



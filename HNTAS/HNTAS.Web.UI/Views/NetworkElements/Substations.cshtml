@using HNTAS.Web.UI.Models.NetworkElements
@model SubstationsViewModel
@{
    bool hasDistrictSubstationErrors = ViewData.ModelState.ContainsKey(nameof(Model.HasDistrictSubstation)) && ViewData.ModelState[nameof(Model.HasDistrictSubstation)].Errors.Any();
    bool hasNumberOfSubstationsErrors = ViewData.ModelState.ContainsKey(nameof(Model.NumberOfSubstations)) && ViewData.ModelState[nameof(Model.NumberOfSubstations)].Errors.Any();
}
<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <span class="govuk-caption-l">@ViewBag.HnId @ViewBag.HnName</span>

        <h1 class="govuk-heading-l">Distribution networks and substations</h1>
        <p class="govuk-body"><strong>Substations</strong></p>
        <p class="govuk-body">
            A substation is a connection between distribution networks which contains an exchange of thermal energy (for example, via plate heat exchangers) together with other necessary equipment.
        </p>
        <p class="govuk-body">
            Each substation you add to a district distribution network (the supplying pipework) splits it into separate sections. Each section is treated as a separate district distribution network.
        </p>
        
        <form asp-action="Substations" asp-controller="NetworkElements" method="post">
            <div class="govuk-form-group @(hasDistrictSubstationErrors ? " govuk-form-group--error" : "" )">
                <fieldset class="govuk-fieldset">
                    <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">
                        Do you have any substations on your district network?
                    </legend>
                    <div class="govuk-hint">Do not include any substations within communal buildings</div>
                    <div class="govuk-radios" data-module="govuk-radios">

                        <div class="govuk-radios__item">
                            <input class="govuk-radios__input"
                                   id="hasdistrictsubstation"
                                   name="HasDistrictSubstation"
                                   type="radio"
                                   value="true"
                                   checked="@(Model?.HasDistrictSubstation)"
                                   data-aria-controls="conditional-hasdistrictsubstation">
                            <label class="govuk-label govuk-radios__label" for="hasdistrictsubstation">
                                Yes
                            </label>
                        </div>
                        <div class="govuk-radios__conditional govuk-radios__conditional--hidden"
                             id="conditional-hasdistrictsubstation">
                            <div class="govuk-form-group @(hasNumberOfSubstationsErrors ? "govuk-form-group--error" : "")">
                                <label class="govuk-label" for="numberofsubstations">
                                    Number of substations
                                </label>
                                <input class="govuk-input govuk-input--width-3"
                                       id="numberofsubstations"
                                       name="NumberOfSubstations"
                                       type="number"
                                       value="@Model?.NumberOfSubstations">
                            </div>
                        </div>

                        <div class="govuk-radios__item">
                            <input class="govuk-radios__input"
                                   id="hasDistrictSubstation-2"
                                   name="HasDistrictSubstation"
                                   type="radio"
                                   value="false"
                                   checked="@(!Model?.HasDistrictSubstation)">
                            <label class="govuk-label govuk-radios__label" for="hasDistrictSubstation-2">
                                No
                            </label>
                        </div>
                    </div>
                </fieldset>
            </div>
            <button type="submit" class="govuk-button" data-module="govuk-button">
                Continue
            </button>
        </form>        
    </div>
</div>
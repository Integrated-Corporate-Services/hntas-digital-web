@{
    ViewData["Title"] = "Confirmation";    
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <div class="govuk-panel govuk-panel--confirmation">
            <h1 class="govuk-panel__title">
                You have successfully defined the elements for your heat network
            </h1>            

        </div>
        <p class="govuk-body">You can now:</p>
        <ul class="govuk-list govuk-list--bullet">
            <li>view a summary of your network, including all connections and elements</li>
            <li>provide plant data for any energy centres you have told us about</li>
            <li>update us on the progress of the heat network</li>
        </ul>

        <a class="govuk-button" role="button" draggable="false" asp-controller="NetworkElements" asp-action="NewAndExistingNetworkOverview">
            Continue
        </a>
    </div>
</div>

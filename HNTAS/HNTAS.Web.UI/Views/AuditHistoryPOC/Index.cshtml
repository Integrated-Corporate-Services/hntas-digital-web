@using HNTAS.Api.Client.Model
@model AuditLogResponse

@{
    ViewData["Title"] = "Certification history";
    var currentSort = ViewBag.CurrentSort as string;
    var currentOrder = ViewBag.CurrentOrder as string;
    var currentPage = (int)(ViewBag.CurrentPage);
    var pageSize = (int)(ViewBag.PageSize);
    var totalPages = (int)(ViewBag.TotalPages);
    var hnId = Model.HnId;
    
    string GetSortUrl(string sortField)
    {
        var order = currentOrder == "asc" ? "desc" : "asc";
        return Url.Action("Index", new { hnId = hnId, sortBy = sortField, sortOrder = order, page = currentPage, pageSize = pageSize }) ?? "";
    }
    
    string GetSortIcon()
    {        
        if (currentOrder == "asc")
        {
            return "<svg class='govuk-!-margin-left-1' width='12' height='12' viewBox='0 0 12 12' fill='none' xmlns='http://www.w3.org/2000/svg' aria-hidden='true' focusable='false'><path d='M6 2L10 8H2L6 2Z' fill='currentColor'/></svg>";
        }
        else
        {
            return "<svg class='govuk-!-margin-left-1' width='12' height='12' viewBox='0 0 12 12' fill='none' xmlns='http://www.w3.org/2000/svg' aria-hidden='true' focusable='false'><path d='M6 10L2 4H10L6 10Z' fill='currentColor'/></svg>";
        }
    }
}

<style>
    .sort-link {
        text-decoration: none !important;
    }
    
    .sort-link:hover {
        text-decoration: none !important;
        text-decoration-thickness: max(3px, 0.1875rem, 0.12em);
    }
</style>

<div class="govuk-grid-row">
    <div class="govuk-grid-column-full">

        <h1 class="govuk-heading-l">Certification history</h1>

        <table class="govuk-table">           

            <thead class="govuk-table__head">
                <tr class="govuk-table__row">
                    <th scope="col" class="govuk-table__header">
                        <a href="@GetSortUrl("EntryType")" class="govuk-link govuk-link--no-visited-state sort-link">
                            Entry type @Html.Raw(GetSortIcon())
                        </a>
                    </th>
                    <th scope="col" class="govuk-table__header">
                        <a href="@GetSortUrl("Element")" class="govuk-link govuk-link--no-visited-state sort-link">
                            Element @Html.Raw(GetSortIcon())
                        </a>
                    </th>
                    <th scope="col" class="govuk-table__header">
                        <a href="@GetSortUrl("Phase")" class="govuk-link govuk-link--no-visited-state sort-link">
                            Phase @Html.Raw(GetSortIcon())
                        </a>
                    </th>
                    <th scope="col" class="govuk-table__header">Stage</th>
                    <th scope="col" class="govuk-table__header">
                        <a href="@GetSortUrl("Timestamp")" class="govuk-link govuk-link--no-visited-state sort-link">
                            Date @Html.Raw(GetSortIcon())
                        </a>
                    </th>
                </tr>
            </thead>

            <tbody class="govuk-table__body">
                @if (Model.Items != null && Model.Items.Any())
                {
                    @foreach (var log in Model.Items)
                    {
                        <tr class="govuk-table__row">
                            <td class="govuk-table__cell">@log.EntryType</td>
                            <td class="govuk-table__cell">@log.ElementName</td>
                            <td class="govuk-table__cell">@log.Phase</td>
                            <td class="govuk-table__cell">@log.Stage</td>
                            <td class="govuk-table__cell">
                                @if (DateTime.TryParse(log.Timestamp, out DateTime parsedDate))
                                {
                                    @parsedDate.ToString("dd/MM/yyyy")
                                }
                                else
                                {
                                    @log.Timestamp @* Fallback to raw string if parsing fails *@
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr class="govuk-table__row">
                        <td class="govuk-table__cell" colspan="5">No certification history found.</td>
                    </tr>
                }
            </tbody>
        </table>

        @if (totalPages > 1)
        {
            <nav class="govuk-pagination" role="navigation" aria-label="Pagination">
                
                    @if (currentPage > 1)
                    {
                    <div class="govuk-pagination__prev">
                        <a class="govuk-link govuk-pagination__link" href="@Url.Action("Index", new { hnId = hnId, sortBy = currentSort, sortOrder = currentOrder, page = currentPage - 1, pageSize = pageSize })" rel="prev">
                            <svg class="govuk-pagination__icon govuk-pagination__icon--prev" xmlns="http://www.w3.org/2000/svg" height="13" width="15" aria-hidden="true" focusable="false" viewBox="0 0 15 13">
                                <path d="m6.5938-0.0078125-6.7266 6.7266 6.7441 6.4062 1.377-1.449-4.1856-3.9768h12.896v-2h-12.984l4.2931-4.293-1.414-1.414z"></path>
                            </svg>
                            <span class="govuk-pagination__link-title">Previous</span>
                        </a>
                    </div>
                    }
                
                <ul class="govuk-pagination__list">
                    @{
                        int startPage = Math.Max(1, currentPage - 2);
                        int endPage = Math.Min(totalPages, currentPage + 2);        

                        for (int i = startPage; i <= endPage; i++)
                        {
                            if (i == currentPage)
                            {
                                <li class="govuk-pagination__item govuk-pagination__item--current">
                                    <a class="govuk-link govuk-pagination__link" href="#" aria-label="Page @i" aria-current="page">@i</a>
                                </li>
                            }
                            else
                            {
                                <li class="govuk-pagination__item">
                                    <a class="govuk-link govuk-pagination__link" href="@Url.Action("Index", new { hnId = hnId, sortBy = currentSort, sortOrder = currentOrder, page = i, pageSize = pageSize })" aria-label="Page @i">
                                        @i
                                    </a>
                                </li>
                            }
                        }                        
                        
                    }
                </ul>
                <div class="govuk-pagination__next">
                    @if (currentPage < totalPages)
                    {
                        <a class="govuk-link govuk-pagination__link" href="@Url.Action("Index", new { hnId = hnId, sortBy = currentSort, sortOrder = currentOrder, page = currentPage + 1, pageSize = pageSize })" rel="next">
                            <span class="govuk-pagination__link-title">Next</span>
                            <svg class="govuk-pagination__icon govuk-pagination__icon--next" xmlns="http://www.w3.org/2000/svg" height="13" width="15" aria-hidden="true" focusable="false" viewBox="0 0 15 13">
                                <path d="m8.107-0.0078125-1.4136 1.414 4.2926 4.293h-12.986v2h12.896l-4.1855 3.9766 1.377 1.4492 6.7441-6.4062-6.7246-6.7266z"></path>
                            </svg>
                        </a>
                    }
                </div>
            </nav>
        }

    </div>
</div>
@using HNTAS.Api.Client.Model
@model IEnumerable<AuditLogResponse>

@{
    ViewData["Title"] = "Certification history";
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-full">

        <h1 class="govuk-heading-l">Certification history</h1>

        <table class="govuk-table">           

            <thead class="govuk-table__head">
                <tr class="govuk-table__row">
                    <th scope="col" class="govuk-table__header">Entry type</th>
                    <th scope="col" class="govuk-table__header">Element</th>
                    <th scope="col" class="govuk-table__header">Phase</th>
                    <th scope="col" class="govuk-table__header">Stage</th>
                    <th scope="col" class="govuk-table__header">Date</th>
                </tr>
            </thead>

            <tbody class="govuk-table__body">
                @foreach (var log in Model)
                {
                    <tr class="govuk-table__row">
                        <td class="govuk-table__cell">@log.EntryType</td>
                        <td class="govuk-table__cell">@log.ElementName</td>
                        <td class="govuk-table__cell">@log.Phase</td>
                        <td class="govuk-table__cell">@log.Stage</td>
                        <td class="govuk-table__cell">
                            @if (DateTime.TryParse(log.Timestamp, out DateTime parsedDate))
                            {
                                @parsedDate.ToString("dd/MM/yyyy")
                            }
                            else
                            {
                                @log.Timestamp @* Fallback to raw string if parsing fails *@
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>

    </div>
</div>
@using HNTAS.Web.UI.Models
@model HeatNetworkPhaseModel

@{
    ViewData["Title"] = "Which phase is your heat network in?";
    var fieldOrder = new[] { nameof(Model.HeatNetworkPhase) };
    var elementId = Html.GenerateIdFromName(nameof(Model.HeatNetworkPhase)).ToLowerInvariant();
    var pageData = new QuestionWithRadiobuttonsModel
    {
        Controller = "HeatNetwork",
        Action = "EnterHNPhase",
        FieldOrder = fieldOrder,
        Questions = new List<Question>
        {
            new Question
            {
                QId = elementId,
                QText = $"Which phase is {ViewBag.HNName} in?",
                QDescText = null,
                QHintText = null,
                Options = new List<Option>
                {
                    new Option { OptId = $"{elementId}", OptValue = "design", OptText = "Feasibility or design", OptHintText = null },
                    new Option { OptId = $"{elementId}-2", OptValue = "construction", OptText = "Under construction", OptHintText = null },
                    new Option { OptId = $"{elementId}-3", OptValue = "operation", OptText = "In operation", OptHintText = null }
                },
                SeletedOption = Model.HeatNetworkPhase
            },
        }
    };
}

<div class="govuk-width-container">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            @await Html.PartialAsync("_QuestionWithRadiobuttons", pageData)
        </div>
    </div>
</div>
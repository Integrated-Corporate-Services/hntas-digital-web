@using HNTAS.Web.UI.Models.Common
@using HNTAS.Web.UI.Models.HeatNetwork
@using HNTAS.Api.Client.Model
@model NetworkDetailsViewModel

@{
    ViewData["Title"] = "Heat network details";
    string? additionalDescription = ViewBag.HNAdditionalDescription as string;
}
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-full">
        <span class="govuk-caption-l">@ViewBag.HNId @ViewBag.HNName@(!string.IsNullOrEmpty(additionalDescription) ? ", " + additionalDescription.TruncateWithEllipsis() : "")</span>
            <h1 class="govuk-heading-l">
                Network details
            </h1>

            <ul class="govuk-task-list">
                @foreach (var detail in Model.DetailsOptions)
                {
                    var statusClass = "";
                    var linkClass = "";
                    //var fontColor = "";
                    var skipSpan = false;
                switch (detail.UiStatus)
                    {
                        case StatusConstants.ReadyToStart:
                            statusClass = "govuk-tag govuk-tag--blue";
                            linkClass = "govuk-task-list__item--with-link";
                            break;                        
                        case StatusConstants.InProgress:
                        case StatusConstants.Incomplete:
                            statusClass = "govuk-tag govuk-tag--turquoise";
                            linkClass = "govuk-task-list__item--with-link";
                            break;
                        case StatusConstants.Completed:
                            statusClass = "";
                            linkClass = "govuk-task-list__item--with-link";
                            skipSpan = true;
                        break;
                        default:
                            statusClass = "govuk-task-list__status--cannot-start-yet";
                            linkClass = "";
                            skipSpan = true;
                        break;
                    }

                    <li class="govuk-task-list__item @linkClass">
                        <div class="govuk-task-list__name-and-hint">
                            @if (detail.IsEnabled)
                            {
                                <a class="govuk-link govuk-task-list__link" href="@Url.Action("SelectNetworkDetail", "HeatNetwork", new { hnid = ViewBag.HNId, networkDetailId = detail.Id })" aria-describedby="@detail.Id">
                                    @detail.Label
                                </a>
                            }
                            else
                            {
                                <span> @detail.Label</span>
                            }
                        </div>
                    @if (!skipSpan)
                    {
                        <div class="govuk-task-list__status" id="@detail.Id">
                            <span class="@statusClass">
                                @detail.UiStatus
                            </span>
                        </div>
                    }
                    else
                    {
                        <div class="govuk-task-list__status @statusClass" id="@detail.Id">
                                @detail.UiStatus                            
                        </div>
                    }
                        
                    </li>
                }

            </ul>
        </div>

        </div>

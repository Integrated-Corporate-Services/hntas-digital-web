@using HNTAS.Web.UI.Models
@model HasElementBeenRegisteredModel

@{
    ViewData["Title"] = "Has this element been registered?";
    var fieldOrder = new[] { nameof(Model.HasElementBeenRegistered) };
    var elementId = Html.GenerateIdFromName(nameof(Model.HasElementBeenRegistered)).ToLowerInvariant();
    var pageData = new QuestionWithRadiobuttonsModel
    {
        Controller = "HeatNetwork",
        Action = "HasElementBeenRegistered",
        FieldOrder = fieldOrder,
        Questions = new List<Question>
        {
            new Question
            {
                QId = elementId,
                QText = "Has element been registered & entry point evidence been provided?",
                QDescText = null,
                QHintText = null,
                Options = new List<Option>
                {
                    new Option { OptId = $"{elementId}", OptValue = "yes", OptText = "Yes", OptHintText = null },
                    new Option { OptId = $"{elementId}-2", OptValue = "no", OptText = "No", OptHintText = null }
                },
                SeletedOption = Model.HasElementBeenRegistered
            },
        }
    };
}

<div class="govuk-width-container">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            @await Html.PartialAsync("_QuestionWithRadiobuttons", pageData)
        </div>
    </div>
</div>
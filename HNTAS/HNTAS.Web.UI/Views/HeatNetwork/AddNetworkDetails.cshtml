@using HNTAS.Api.Client.Model
@using HNTAS.Web.UI.Models.HeatNetwork
@model HNDetailsViewModel

@{
    ViewData["Title"] = "Heat network Overview";
}


    <div class="govuk-grid-row">
        <div class="govuk-grid-column-full">
            <form asp-action="NetworkDetails" method="get">
                <span class="govuk-caption-l">@Model.UHNID @Model.Name</span>
                <h1 class="govuk-heading-l">
                    Network overview
                </h1>

                <dl class="govuk-summary-list">
                    
                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key">
                                Address
                            </dt>
                            <dd class="govuk-summary-list__value">
                            @(!string.IsNullOrEmpty(Model.Address.Fulladdress) ? @Model.Address.Fulladdress : "Not provided")
                            </dd>
                        </div>                    

                    <div class="govuk-summary-list__row">
                        <dt class="govuk-summary-list__key">
                            Coordinates
                        </dt>
                        <dd class="govuk-summary-list__value">
                            @Model.Coordinates
                        </dd>
                    </div>
                    <div class="govuk-summary-list__row">
                        <dt class="govuk-summary-list__key">
                            Connections
                        </dt>
                    <dd class="govuk-summary-list__value">
                        @if (Model.NetworkBuildStatus != null && Model.NetworkBuildStatus == NullableOfNetworkBuildStatus.NewAndExisting.ToString())
                        {
                            <h3 class="govuk-heading-s">Existing connections</h3>
                            <ul class="govuk-list govuk-list--bullet">
                                @if ((Model.NetworkConnections.ExistingCommunalBuildings ?? 0) > 0)
                                {
                                    <li>@Model.NetworkConnections.ExistingCommunalBuildings existing communal buildings</li>
                                }
                                @if ((Model.NetworkConnections.ExistingHousesOrMaisonettes ?? 0) > 0)
                                {
                                    <li>@Model.NetworkConnections.ExistingHousesOrMaisonettes existing houses or maisonettes</li>
                                }
                                @if ((Model.NetworkConnections.ExistingNonDomesticBuildings ?? 0) > 0)
                                {
                                    <li>@Model.NetworkConnections.ExistingNonDomesticBuildings existing non-domestic buildings</li>
                                }
                                @if ((Model.NetworkConnections.ExistingMultiTenantedNonDomestic ?? 0) > 0)
                                {
                                    <li>@Model.NetworkConnections.ExistingMultiTenantedNonDomestic existing multi-tenanted non-domestic buildings</li>
                                }
                                @if ((Model.NetworkConnections.ExistingOtherDistrictNetworks ?? 0) > 0)
                                {
                                    <li>@Model.NetworkConnections.ExistingOtherDistrictNetworks existing other district heat networks</li>
                                }
                            </ul>
                        }

                        <h3 class="govuk-heading-s">New connections</h3>
                        <ul class="govuk-list govuk-list--bullet">
                            @if ((Model.NetworkConnections.NewCommunalBuildings ?? 0) > 0)
                            {
                                <li>@Model.NetworkConnections.NewCommunalBuildings new communal buildings</li>
                            }
                            @if ((Model.NetworkConnections.NewHousesOrMaisonettes ?? 0) > 0)
                            {
                                <li>@Model.NetworkConnections.NewHousesOrMaisonettes new houses or maisonettes</li>
                            }
                            @if ((Model.NetworkConnections.NewNonDomesticBuildings ?? 0) > 0)
                            {
                                <li>@Model.NetworkConnections.NewNonDomesticBuildings new non-domestic buildings</li>
                            }
                            @if ((Model.NetworkConnections.NewMultiTenantedNonDomestic ?? 0) > 0)
                            {
                                <li>@Model.NetworkConnections.NewMultiTenantedNonDomestic new multi-tenanted non-domestic buildings</li>
                            }

                            @if ((Model.NetworkConnections.NewOtherDistrictNetworks ?? 0) > 0)
                            {
                                @if (Model.NetworkConnections.NewOtherDistrictNetworks == 1 && Model.EnergyCentreType == NullableOfEnergyCentreType.SingleCommunalBuildingSeparateDistrictNetwork.ToString())
                                {
                                    <li>@Model.NetworkConnections.NewOtherDistrictNetworks Separate supplying district heat network</li>
                                }
                                else
                                {
                                    <li>@Model.NetworkConnections.NewOtherDistrictNetworks new other district heat networks</li>
                                }
                            }
                        </ul>
                    </dd>
                    </div>
                    <div class="govuk-summary-list__row">
                        <dt class="govuk-summary-list__key">
                            Phase
                        </dt>
                        <dd class="govuk-summary-list__value">
                            @Model.Phase
                        </dd>
                    </div>
                </dl>

                <button type="submit" class="govuk-button" data-module="govuk-button">
                    Continue
                </button>
            </form>
        </div>
        </div>

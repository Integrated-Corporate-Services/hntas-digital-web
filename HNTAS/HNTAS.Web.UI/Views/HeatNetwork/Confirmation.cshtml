@{
    ViewData["Title"] = "Confirmation";
}
<script>
gtag('event', 'hn_registrations', {
  method: 'hntas_digital',
});
</script>

<div class="govuk-width-container">
    <main class="govuk-main-wrapper govuk-main-wrapper--l" id="main-content" role="main">
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-two-thirds">
                <div class="govuk-panel govuk-panel--confirmation">
                    <span class="govuk-!-font-weight-bold">Heat network successfully registered</span><br/>
                    <span class="govuk-!-font-weight-regular">@ViewBag.HNName</span><br />
                    <span class="govuk-!-font-weight-regular">UHNID</span><span class="govuk-!-font-weight-bold"> @ViewBag.HNId</span>
                </div><br/>
                <p class="govuk-body">We have:</p>
                <ul class="govuk-list govuk-list--bullet">
                    <li>registered your heat network service under @ViewBag.CompanyName's organisation</li>
                    <li>sent an email confirmation, with the UHNID, to @ViewBag.ContactName</li>
                </ul>

                <p class="govuk-body">As the responsible party, you can now designate team members to help provide technical information for your heat network.</p>
                
                
                @* TODO - repoint to appropriate page when available. Pointing to UserAccount page for now, to test page in flow *@
                <a class="govuk-button" role="button" draggable="false" asp-controller="Dashboard" asp-action="UserAccount">
                    Continue
                </a>
            </div>
        </div>
    </main>
</div>

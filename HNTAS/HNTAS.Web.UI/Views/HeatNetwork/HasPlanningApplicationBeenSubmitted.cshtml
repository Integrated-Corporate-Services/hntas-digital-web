@using HNTAS.Web.UI.Models
@model HasPlanningApplicationBeenSubmittedModel

@{
    ViewData["Title"] = "Has a planning application been submitted";
    var fieldOrder = new[] { nameof(Model.HasPlanningApplicationBeenSubmitted)};
    var elementId = Html.GenerateIdFromName(nameof(Model.HasPlanningApplicationBeenSubmitted)).ToLowerInvariant();
    var pageData = new QuestionWithRadiobuttonsModel
    {
        Controller = "HeatNetwork",
        Action = "HasPlanningApplicationBeenSubmitted",
        FieldOrder = fieldOrder,
        Questions = new List<Question>
        {
            new Question
            {
                QId = elementId,
                QText = "Has a planning application been submitted for this element?",
                QDescText = null,
                QHintText = null,
                Options = new List<Option>
                {
                    new Option { OptId = $"{elementId}", OptValue = "yes", OptText = "Yes", OptHintText = null },
                    new Option { OptId = $"{elementId}-2", OptValue = "no", OptText = "No", OptHintText = null }
                },
                SeletedOption = Model.HasPlanningApplicationBeenSubmitted
            },
        }
    };
}

<div class="govuk-width-container">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            @await Html.PartialAsync("_QuestionWithRadiobuttons", pageData)
        </div>
    </div>
</div>
@model HNTAS.Web.UI.Models.HeatNetworkLocationModel

@{
    ViewData["Title"] = "Where is your heat network?";
    var heatNetworkLocationId = Html.LowercaseIdFor(m => m.HeatNetworkLocation);
}


<div class="govuk-width-container">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <form asp-controller="HeatNetwork" asp-action="EnterHNLocation" method="post" class="govuk-form-group">
                @Html.AntiForgeryToken()
                <span class="govuk-hint govuk-!-font-size-27">Heat network registration</span>
                <h1 class="govuk-heading-l">
                    Where is @ViewBag.HNName located?
                </h1>

                <div class="govuk-form-group" aria-described-by="enter-hnlocation" @(ViewData.ModelState["HeatNetworkLocation"]?.Errors.Count > 0 ? "govuk-form-group--error" : "")">

                    <p class="govuk-body" id="description1">
                        We need to know the specific location of your heat network and we require you to use the <a class="govuk-link" href="https://what3words.com/" target="_blank">what3words</a> (opens in a new tab) service to do this.
                    </p><p class="govuk-body" id="description2">
                        Use the heat network’s primary energy centre location for this.
                    </p><p class="govuk-body" id="description3">
                        what3words location e.g. ///fired.deeply.smoke
                    </p>

                    @if (ViewData.ModelState["HeatNetworkLocation"]?.Errors.Count > 0)
                    {
                        <span asp-validation-for="HeatNetworkLocation" class="govuk-error-message"></span>
                    }

                    <input class="govuk-input govuk-!-width-two-thirds" id="@heatNetworkLocationId" aria-labelledby="description1 description2 description3" name="@heatNetworkLocationId" asp-for="HeatNetworkLocation" autocomplete="off" />
                </div>
                <br />

                <button type="submit" class="govuk-button" data-module="govuk-button">
                    Continue
                </button>
            </form>
        </div>
    </div>
</div>
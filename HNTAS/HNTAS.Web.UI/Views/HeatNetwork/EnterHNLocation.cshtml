@model HNTAS.Web.UI.Models.HeatNetworkLocationModel

@{
    ViewData["Title"] = "Enter your HeatNetwork location";
}


<div class="govuk-width-container">
    <form asp-controller="HeatNetwork" asp-action="EnterHNLocation" method="post" class="govuk-form-group">
        @Html.AntiForgeryToken()
        <h1 class="govuk-heading-l">Enter your address (What3words)</h1>

        <div class="govuk-form-group @(ViewData.ModelState["HeatNetworkLocation"]?.Errors.Count > 0 ? "govuk-form-group--error" : "")">

            <p class="govuk-body">To provide the exact location of your heat network, please go to <a class="govuk-link govuk-link--no-visited-state" rel="noreferrer noopener" href="https://what3words.com/" target="_blank">https://what3words.com/</a> and enter your geo coordinates there. It will generate a unique url. Please copy that and paste it here.</p>
            <label class="govuk-label" for="heatnetworklocation">
                Enter the url
            </label>
            @if (ViewData.ModelState["HeatNetworkLocation"]?.Errors.Count > 0)
            {
                <span asp-validation-for="HeatNetworkLocation" class="govuk-error-message"></span>
            }

            <input class="govuk-input govuk-!-width-two-thirds" id="heatnetworklocation" name="heatnetworklocation" value="@Model.HeatNetworkLocation" autocomplete="off" />
        </div>
        <br />

        <button type="submit" class="govuk-button" data-module="govuk-button">
            Continue
        </button>
    </form>
</div>
@model HNTAS.Web.UI.Models.HeatNetworkLocationModel

@{
    ViewData["Title"] = "Enter your HeatNetwork location";
    var fieldOrder = new[] { nameof(Model.HeatNetworkLocation) };
}


<div class="govuk-width-container">
    <form asp-controller="HeatNetwork" asp-action="EnterHNLocation" method="post" class="govuk-form-group">
        @Html.AntiForgeryToken()
        <h1 class="govuk-heading-l">Enter your address (no postcode)</h1>

        @await Html.PartialAsync("_ErrorSummary", fieldOrder)

        <div class="govuk-form-group @(ViewData.ModelState["HeatNetworkLocation"]?.Errors.Count > 0 ? "govuk-form-group--error" : "")">
            <p class="govuk-body">To provide the exact location of your heat network, please go to <strong> https://what3words.com/</strong> and enter your geo coordinates there. It will generate a unique url. Please copy that and paste it here.</p>
            <label class="govuk-label" for="Address">
                Enter the url
            </label>
            @if (ViewData.ModelState["HeatNetworkLocation"]?.Errors.Count > 0)
            {
                <span asp-validation-for="HeatNetworkLocation" class="govuk-error-message"></span>
            }
            <input class="govuk-input" asp-for="HeatNetworkLocation" name="HeatNetworkLocation" id="@(Html.GenerateIdFromName("HeatNetworkLocation").ToLowerInvariant())" autocomplete="off" />

        </div><br />

        <button type="submit" class="govuk-button" data-module="govuk-button">
            Continue
        </button>
    </form>
</div>
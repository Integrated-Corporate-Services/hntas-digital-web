@model HNTAS.Web.UI.Models.HeatNetworkNameModel
@{
    ViewData["Title"] = "Enter name of your heat network";
    var fieldOrder = new[] { nameof(Model.HeatNetworkName) };
}

<div class="govuk-width-container">
    <form asp-controller="HeatNetwork" asp-action="EnterHNName" method="post" class="govuk-form-group">
        @await Html.PartialAsync("_ErrorSummary", fieldOrder)
        <div class="govuk-form-group @(ViewData.ModelState["HeatNetworkName"]?.Errors.Count > 0 ? "govuk-form-group--error" : "")">
            
            <label class="govuk-label" for="HeatNetworkName">
                <h1 class="govuk-heading-l">Enter name of the heat network</h1>
            </label>
            @if (ViewData.ModelState["HeatNetworkName"]?.Errors.Count > 0)
            {
                <span asp-validation-for="HeatNetworkName" class="govuk-error-message"></span>
            }
            <input class="govuk-input govuk-input--width-100" asp-for="HeatNetworkName" name="HeatNetworkName" id="@(Html.GenerateIdFromName("HeatNetworkName").ToLowerInvariant())" autocomplete="off" />

        </div><br />

        <button type="submit" class="govuk-button" data-module="govuk-button">
            Continue
        </button>
    </form>
</div>
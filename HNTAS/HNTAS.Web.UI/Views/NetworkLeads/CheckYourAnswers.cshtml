@using HNTAS.Web.UI.Models.Review
@using HNTAS.Web.UI.Models.Components
@using HNTAS.Web.UI.Models.NetworkLeads
@model CheckYourAnswersViewModel

@{
    ViewData["Title"] = "Check your answers";
    var viewModel = new ReviewSummaryModel
    {
        Sections = new List<ReviewSection>
        {
            new ReviewSection
            {
                Heading = "Contact Details",
                Items = new List<ReviewItem>
                {
                    new ReviewItem
                    {
                        Key = "Email",
                        Value = Model.EmailAddress,
                        ChangeLink = Url.Action("InviteLeadByEmail"),
                        ChangeLinkText = "Change"
                    },
                    new ReviewItem
                    {
                        Key = "First name",
                        Value = Model.FirstName,
                        ChangeLink = Model.InviteForFirstTime ? Url.Action("NewLeadDetails") : null,
                        ChangeLinkText = "Change"
                    },
                    new ReviewItem
                    {
                        Key = "Last name",
                        Value = Model.LastName,
                        ChangeLink =  Model.InviteForFirstTime ? Url.Action("NewLeadDetails") : null,
                        ChangeLinkText = "Change"
                    },
                    new ReviewItem
                    {
                        Key = "Job title",
                        Value = Model.JobTitle,
                        ChangeLink =  Model.InviteForFirstTime ? Url.Action("NewLeadDetails") : null,
                        ChangeLinkText = "Change"
                    },
                     new ReviewItem
                    {
                        Key = "Role assigned",
                        Value = Model.InvitedRole,
                        ChangeLink = null,
                        ChangeLinkText = "Change"
                    }
                }.Where(i => i != null).ToList()
            }
        }
    };

    if (Model.WorkForSameOrganisation == false)
    {
        viewModel.Sections[0].Items.AddRange(
            new ReviewItem
            {
                Key = "Work for same organisation",
                Value = Model.WorkForSameOrganisation == true ? "Yes" : "No",
                ChangeLink = Url.Action("SameOrganisation"),
                ChangeLinkText = "Change"
            },
            new ReviewItem
            {
                Key = "Their organisation name",
                Value = Model.WorkingOrganisationName,
                ChangeLink = Url.Action("SameOrganisation"),
                ChangeLinkText = "Change"
            });
    }
    else if (Model.WorkForSameOrganisation == true)
    {
        viewModel.Sections[0].Items.AddRange(
           
            new ReviewItem
            {
                Key = "Work for same organisation",
                Value = Model.WorkForSameOrganisation == true ? "Yes" : "No",
                ChangeLink = Url.Action("SameOrganisation"),
                ChangeLinkText = "Change"
            }
        );
    }

    var hasDeclarationErrors = ViewData.ModelState.ContainsKey(nameof(Model.ConfirmedDeclaration)) && ViewData.ModelState[nameof(Model.ConfirmedDeclaration)].Errors.Any();
    var confirmDeclarationComponentData = new ConfirmDeclarationCheckboxModel
    {
        Id = nameof(Model.ConfirmedDeclaration),
        Name = nameof(Model.ConfirmedDeclaration).ToLower(),
        Label = "I confirm that I am authorised to give this person access to this organisation with this role on behalf of my organisation.",
        HasError = hasDeclarationErrors,
        ErrorMessage = hasDeclarationErrors ? ViewData.ModelState[nameof(Model.ConfirmedDeclaration)].Errors[0].ErrorMessage : null,
        Value = Model.ConfirmedDeclaration
    };
}


<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <h1 class="govuk-heading-l">Check your answers</h1>
        <form asp-action="CheckYourAnswers" method="post" novalidate>
            @Html.AntiForgeryToken()
            @await Html.PartialAsync("Components/_CheckYourAnswersPartial", viewModel)
            <!-- Declaration -->
            @await Html.PartialAsync("Components/_ConfirmDeclaration", confirmDeclarationComponentData)
            <button type="submit" class="govuk-button" data-module="govuk-button">
                Send Invitation
            </button>
        </form>
    </div>
</div>

@{
    ViewData["Title"] = "Before you complete Statements of Applicability (SOA)";
}

<div class="govuk-width-container">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <h1 class="govuk-heading-l">Before you complete your Statements of Applicability (SOA)</h1>

            <p class="govuk-body">
                An SOA is a record of which HNTAS requirements (found in the <a class="govuk-link" asp-controller="Home" asp-action="DocumentLibrary" asp-method="GET">Document Library</a>) apply to a heat network element and what evidence is needed.
            </p>

            <p class="govuk-body">
                You will complete each SOA outside this service with your assessor and project team. Use this part of the service to update the status and track your progress for each part of your heat network.
            </p>

            <p class="govuk-body">
                An SOA must be completed for each element at different stages of development.
            </p>            

            <p class="govuk-body"><strong>An SOA must contain:</strong> </p>

            <ul class="govuk-list govuk-list--bullet">
                <li>which HNTAS technical requirements apply to the element</li>
                <li>which performance metrics apply</li>
                <li>how key network failures are avoided or mitigated</li>
                <li>what evidence will be used to demonstrate compliance</li>
            </ul>

            <p class="govuk-body">An assessor will review each SOA to issue a Statement of Conformity (SOC). This is needed to certify your heat network before it can operate.</p>

            <form asp-action="SubmitUnderstandingSoa" method="post">
                <button type="submit" class="govuk-button" data-module="govuk-button">
                    Continue
                </button>
            </form>
        </div>        
    </div>
</div>
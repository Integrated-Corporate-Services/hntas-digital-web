@using HNTAS.Web.UI.Helpers
@using HNTAS.Web.UI.Models.ElementSoa

@model ElementSoaViewModel

<div class="govuk-width-container">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-full">
            <span class="govuk-caption-xl">@ViewBag.HnId</span>
            <h1 class="govuk-heading-xl">
                Element statements of applicability (SOAs)
            </h1>

            <p class="govuk-body">Successful network assessment and eventual regulatory certification requires each element to conform to their respective technical requirements. Complete applicability for the stages below. You can submit an element SOA for the next stage, but not beyond that until the other elements have been completed.</p>

            <div class="govuk-tabs" data-module="govuk-tabs">
                <h2 class="govuk-tabs__title">Contents</h2>
                <ul class="govuk-tabs__list">
                    @for (int i = 0; i < Model.Stages.Count; i++)
                    {
                        var stage = Model.Stages[i];
                        <li class="govuk-tabs__list-item @(i == Model.CurrentStageIndex ? "govuk-tabs__list-item--selected" : "")">
                            <a class="govuk-tabs__tab" href="#stage-@i">
                                @stage.Name
                            </a>
                        </li>
                    }
                </ul>

                @for (int i = 0; i < Model.Stages.Count; i++)
                {
                    var stage = Model.Stages[i];
                    <div id="stage-@i" class="govuk-tabs__panel @(i != Model.CurrentStageIndex ? "govuk-tabs__panel--hidden" : "")">
                        <h2 class="govuk-heading-l">@stage.Title</h2>

                        <table class="govuk-table">
                            <tbody class="govuk-table__body">
                                @foreach (var element in stage.Elements)
                                {
                                    <tr class="govuk-table__row">
                                        <td class="govuk-table__cell">
                                            @element.Name
                                        </td>
                                        <td class="govuk-table__cell">
                                            @if (element.Documents?.Count > 0)
                                            {
                                                <a class="govuk-link"
                                                   href="@Url.Action("SoaStagesToUpload", "ElementSoa", new { stage = stage.Stage, elementId = element.ElementId })"
                                                   aria-describedby="@element.Documents?.FirstOrDefault()?.FileName"
                                                   onclick="event.stopPropagation();">
                                                    @element.Documents?.FirstOrDefault()?.FileName
                                                </a>
                                            }
                                            else
                                            {
                                                <a class="govuk-link"
                                                   href="@Url.Action("SoaStagesToUpload", "ElementSoa", new { stage = stage.Stage, elementId = element.ElementId })"
                                                   aria-describedby="Upload SOA details"
                                                   onclick="event.stopPropagation();">
                                                    Upload SOA details
                                                </a>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <a href="@Url.Action("UploadAssessmentPlan", new { phase = 0 })" role="button" draggable="false" class="govuk-button" data-module="govuk-button">
                Continue
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Ensure GOV.UK tabs are initialized
            if (typeof window.GOVUKFrontend !== 'undefined') {
                var tabsElement = document.querySelector('[data-module="govuk-tabs"]');
                if (tabsElement) {
                    new window.GOVUKFrontend.Tabs(tabsElement).init();
                }
            }

            // Prevent link clicks from interfering with tab navigation
            var taskLinks = document.querySelectorAll('.govuk-table__cell .govuk-link');
            taskLinks.forEach(function(link) {
                link.addEventListener('click', function(e) {
                    e.stopPropagation(); // Prevent event bubbling to tab handlers
                });
            });
        });
    </script>
}
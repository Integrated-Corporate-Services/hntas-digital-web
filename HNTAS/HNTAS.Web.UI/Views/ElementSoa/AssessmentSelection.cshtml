@using HNTAS.Web.UI.Models.ElementSoa
@model AssessorAssessmentSelectionViewModel

@{
    var hasError = ViewData.ModelState.ContainsKey(nameof(Model.SelectedAssessmentOption)) && ViewData.ModelState[nameof(Model.SelectedAssessmentOption)].Errors.Any();
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
        <span class="govuk-caption-xl">@ViewBag.HnId</span>
        <h1 class="govuk-heading-xl">
            Which step of the assessment will they carry out for the energy centre?
        </h1>
        <form method="post" asp-action="AssessmentSelection" asp-controller="ElementSoa">
            <div class="govuk-form-group @(hasError ? "govuk-form-group--error" : "")">
                <fieldset class="govuk-fieldset">
                    <div id="status-hint" class="govuk-hint">
                        Assign an independent assessor to one of the following steps.
                    </div>
                    <div class="govuk-radios" data-module="govuk-radios">
                        @for (var i = 0; i < Model.AssessmentOptions.Count; i++)
                        {
                            var option = Model.AssessmentOptions[i];
                            var optionId = $"option-{i}";
                            var hintId = $"{optionId}-item-hint";
                            <div class="govuk-radios__item">
                                <input class="govuk-radios__input" id="@optionId" name="SelectedAssessmentOption" type="radio" value="@option.Label" @( Model.SelectedAssessmentOption == option.Label ? "checked" : "")>
                                <label class="govuk-label govuk-radios__label" for="@optionId">
                                    @option.Label<br />
                                </label>
                                @if (!string.IsNullOrEmpty(option.Hint))
                                {
                                    <div id="@hintId" class="govuk-hint govuk-radios__hint">
                                        @option.Hint
                                    </div>
                                }
                                
                            </div>
                        }
                    </div>
                </fieldset>
            </div>
            @* @Html.HiddenFor(m => m.SoaStatus)
            @Html.HiddenFor(m => m.ElementId) *@
            <button type="submit" class="govuk-button">Continue</button>
        </form>
    </div>
</div>
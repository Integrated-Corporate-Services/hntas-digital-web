@{
    ViewData["Title"] = "You may need to register with HNTAS later";
}
<div class="govuk-width-container">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <h1 class="govuk-heading-l">
                You may need to register with HNTAS later
            </h1>

            <p class="govuk-body">
                From your answers, your new heat network is in an operational stage, but not yet supplying customers..
            </p>
            <p class="govuk-body">
                HNTAS is only supporting pre-operational networks at this time.
            </p>
            <p class="govuk-body">
                If your network is already supplying heat to consumers, you must be authorised by <a class="govuk-link" href="#">Ofgem</a>.
            </p>
            <p class="govuk-body">
                You may now leave the service.
            </p>
            
        </div>
    </div>
</div>

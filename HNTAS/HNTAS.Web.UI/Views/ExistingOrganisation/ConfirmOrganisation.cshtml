@model HNTAS.Web.UI.Models.ConfirmOrganisationViewModel
@{
    ViewData["Title"] = "Confirm this is the right organisation";
}


<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

        <h1 class="govuk-heading-l">
            Is this is the correct organisation?
        </h1>

        @if (Model != null && Model.RegisteredOfficeAddress != null)
        {
            <div class="govuk-body govuk-!-margin-bottom-6">


                <div class="govuk-body">
                    @Model.OrganisationId<br />
                    @Model.Title<br />
                    @Model.RegisteredOfficeAddress.AddressLine1<br />
                    @if (!string.IsNullOrEmpty(Model.RegisteredOfficeAddress.AddressLine2))
                    {
                        @Model.RegisteredOfficeAddress.AddressLine2
                
                        <br />
                    }
                    @if (!string.IsNullOrEmpty(@Model.RegisteredOfficeAddress.Locality))
                    {
                        @Model.RegisteredOfficeAddress.Locality
                
                        <br />
                    }
                    @if (!string.IsNullOrEmpty(Model.RegisteredOfficeAddress.Country) && Model.RegisteredOfficeAddress.Country != Model.RegisteredOfficeAddress.Locality)
                    {
                        @Model.RegisteredOfficeAddress.Country
                
                        <br />
                    }
                    @Model.RegisteredOfficeAddress.PostalCode
                </div>
            </div>

            <p class="govuk-body">
                <a href="@ViewBag.ChangeUrl" class="govuk-link govuk-link--no-visited-state">Change</a>
            </p>

            <br />
            <br />

            <form asp-controller="ExistingOrganisation" asp-action="SaveConfirmOrganisation" method="post" novalidate>
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.OrganisationId)
                <button type="submit" class="govuk-button" data-module="govuk-button">
                    Confirm and continue
                </button>
            </form>
        }
        else
        {
            <p class="govuk-body">Company details could not be loaded. Please go back and try again.</p>
            <p class="govuk-body">
                <a href="@ViewBag.ChangeUrl" class="govuk-link">Go back</a>
            </p>
        }

    </div>
</div>
@using HNTAS.Web.UI.Models
@model ServesGt10DwellingsViewModel

@{
    ViewData["Title"] = "Check your eligibility to register a heat network";
    var fieldOrder = new[] { nameof(Model.ServesMoreThan10Dwellings) };
    var pageData = new QuestionWithRadiobuttonsModel
    {
        Action = "ServesGt10Dwellings",
        FieldOrder = fieldOrder,
        Questions = new List<Question>
        {
            new Question
            {
                QId = nameof(Model.ServesMoreThan10Dwellings),
                QText = "Does the heat network serve more than 10 dwellings?",
                QDescText = null,
                QHintText = null,
                Options = new List<Option>
                {
                    new Option { OptId = "dwellingsYes", OptValue = "Yes", OptHintText = null },
                    new Option { OptId = "dwellingsNo", OptValue = "No", OptHintText = null }
                },
                SeletedOption = Model.ServesMoreThan10Dwellings
            }
        }
    };
}

<div class="govuk-width-container">
    @await Html.PartialAsync("_QuestionWithRadiobuttons", pageData)
</div>
@{
    ViewData["Title"] = "Check if the new regulations apply to your heat network";
}
<div class="govuk-width-container">
    <p class="govuk-hint">
        Check if the new regulations apply to your heat network
    </p>

    <h1 class="govuk-heading-l">
        Your heat network may not need to follow the new regulations
    </h1>

    <p class="govuk-body">
        Based on your answers, your heat network may be exempt from Ofgem and Heat Network Technical Assurance Scheme (HNTAS) requirements.
    </p>

    <p class="govuk-body">
        This could change if your organisation or network details change.
    </p>

    <h2 class="govuk-heading-m">What to do next</h2>
    <p class="govuk-body">You should:</p>
    <ul class="govuk-list govuk-list--bullet">
        <li>check the full guidance on exemptions (opens in a new tab)</li>
        <li>get professional advice if your network changes or expands</li>
    </ul>
</div>

@{
    ViewData["Title"] = "Your heat network may not need to comply with the new regulations";
}

<div class="govuk-width-container">
    <main class="govuk-main-wrapper" id="main-content" role="main">
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-two-thirds">

                <p class="govuk-hint">
                    Check if the new regulations apply to your heat network
                </p>

                <h1 class="govuk-heading-l">
                    Your heat network may not need to comply with the new regulations
                </h1>

                <p class="govuk-body">
                    Based on your answers you need to comply with Ofgem regulations.
                </p>

                <p class="govuk-body">
                    Review <a class="govuk-link" target="_blank" href="#">Ofgem Guidance (opens in new tab)</a> on registering your heat network and being authorised to supply heat.
                </p>

            </div>
        </div>
    </main>
</div>

@using HNTAS.Web.UI.Models
@model IsHNCurrentlyOperatingViewModel

@{
    ViewData["Title"] = "Check your eligibility to register a heat network";
    var fieldOrder = new[] { nameof(Model.IsCurrentlyOperating) };
    var elementId = Html.GenerateIdFromName(nameof(Model.IsCurrentlyOperating)).ToLowerInvariant();
    var pageData = new QuestionWithRadiobuttonsModel
    {
        Controller = "HeatNetworkEligibility",
        Action = "IsHNCurrentlyOperating",
        FieldOrder = fieldOrder,
        Questions = new List<Question>
        {
            new Question
            {
                QId = elementId,
                QText = "Is your heat network currently operating?",
                QDescText = null,
                QHintText = "This means it's supplying heating, cooling or hot water to consumers.",
                Options = new List<Option>
                {
                    new Option { OptId = "@elementId", OptValue = "yes", OptText = "Yes - it's already supplying heat, cooling or hot water", OptHintText = "Existing element" },
                    new Option { OptId = "@elementId-2", OptValue = "no", OptText = "No - it hasn't started supplying yet", OptHintText = null }
                },
                SeletedOption = Model.IsCurrentlyOperating
            },
        }
    };
}

<div class="govuk-width-container">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            @await Html.PartialAsync("_QuestionWithRadiobuttons", pageData)
        </div>
    </div>
</div>
@using HNTAS.Web.UI.Models
@model RunningAHNViewModel

@{
    ViewData["Title"] = "Check your eligibility to register a heat network";
    var fieldOrder = new[] { nameof(Model.IsRunningHeatNetwork) };
    var pageData = new QuestionWithRadiobuttonsModel
    {
        Controller = "HeatNetworkEligibility",
        Action = "RunningAHN",
        FieldOrder = fieldOrder,
        Questions = new List<Question>
        {
            new Question
            {
                QId = nameof(Model.IsRunningHeatNetwork),
                QText = "Are you running a heat network?",
                QDescText = null,
                QHintText = null,
                Options = new List<Option>
                {
                    new Option { OptId = "runningYes", OptText = "Yes", OptHintText = null },
                    new Option { OptId = "runningNo", OptText = "No", OptHintText = null }
                },
                SeletedOption = Model.IsRunningHeatNetwork
            }
        }
    };
}

<div class="govuk-width-container">
    @await Html.PartialAsync("_QuestionWithRadiobuttons", pageData)
</div>

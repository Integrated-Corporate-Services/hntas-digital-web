@using HNTAS.Web.UI.Models
@model OperatingAHNViewModel

@{
    ViewData["Title"] = "Check your eligibility to register a heat network";
    var fieldOrder = new[] { nameof(Model.IsExistingOrPlanned) };
    var pageData = new QuestionWithRadiobuttonsModel
    {
        Action = "OperatingAHN",
        FieldOrder = fieldOrder,
        Questions = new List<Question>
        {
            new Question
            {
                QId = nameof(Model.IsExistingOrPlanned),
                QText = "Are you operating an existing heat network or planning/designing/constructing a new one?",
                QDescText = null,
                QHintText = null,
                Options = new List<Option>
                {
                    new Option { OptId = "existingYes", OptValue = "Yes", OptHintText = null },
                    new Option { OptId = "existingNo", OptValue = "No", OptHintText = null }
                },
                SeletedOption = Model.IsExistingOrPlanned
            }
        }
    };
}
<div class="govuk-width-container">
    @await Html.PartialAsync("_QuestionWithRadiobuttons", pageData)
</div>
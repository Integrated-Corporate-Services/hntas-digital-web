@using HNTAS.Web.UI.Models
@model HNTAS.Web.UI.Models.LocatedInUkViewModel

@{
    ViewData["Title"] = "Check your eligibility to register a heat network";
    var fieldOrder = new[] { nameof(Model.IsInUK) };
    var pageData =  new QuestionWithRadiobuttonsModel
    {
        Action = "LocatedInUk",
        FieldOrder = fieldOrder,
        Questions = new List<Question>
        {
            new Question
            {
                QId = nameof(Model.IsInUK),
                QText = "Is the network located in England, Wales, or Scotland?",
                QDescText = null,
                QHintText = null,
                Options = new List<Option>
                {
                    new Option { OptId = "ukYes", OptValue = "Yes", OptHintText = null },
                    new Option { OptId = "ukNo", OptValue = "No", OptHintText = null }
                },
                SeletedOption = Model.IsInUK
            }
        }
    };
}
<div class="govuk-width-container">
    @await Html.PartialAsync("_QuestionWithRadiobuttons", pageData)
</div>
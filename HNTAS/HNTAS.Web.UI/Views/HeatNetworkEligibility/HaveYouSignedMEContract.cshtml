@using HNTAS.Web.UI.Models
@model HaveYouSignedMEContractViewModel

@{
    ViewData["Title"] = "Check your eligibility to register a heat network";
    var fieldOrder = new[] { nameof(Model.HaveYouSignedMEContract) };
    var elementId = Html.GenerateIdFromName(nameof(Model.HaveYouSignedMEContract)).ToLowerInvariant();
    var pageData = new QuestionWithRadiobuttonsModel
    {
        Controller = "HeatNetworkEligibility",
        Action = "HaveYouSignedMEContract",
        FieldOrder = fieldOrder,
        Questions = new List<Question>
        {
            new Question
            {
                QId = elementId,
                QText = "Have you signed the mechanical and electrical (M&E) constrcution contract?",
                QDescText = null,
                QHintText = null,
                Options = new List<Option>
                {
                    new Option { OptId = "@elementId", OptValue = "yes", OptText = "Yes", OptHintText = null },
                    new Option { OptId = "@elementId-2", OptValue = "no", OptText = "No", OptHintText = null }
                },
                SeletedOption = Model.HaveYouSignedMEContract
            },
        }
    };
}

<div class="govuk-width-container">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            @await Html.PartialAsync("_QuestionWithRadiobuttons", pageData)
        </div>
    </div>
</div>
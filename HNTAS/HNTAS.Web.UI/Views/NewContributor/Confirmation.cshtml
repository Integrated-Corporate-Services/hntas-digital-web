@{
    ViewData["Title"] = "User has been invited to join the heat network";
}

<div class="govuk-width-container">
    <main class="govuk-main-wrapper" id="main-content" role="main">
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-two-thirds">

                <div class="govuk-panel govuk-panel--confirmation">
                    <h1 class="govuk-panel__title">
                        @ViewData["Title"]
                    </h1>
                </div>

                <p class="govuk-body">
                    You’ve added @ViewData["FullName"] to the @ViewData["HeatNetwork"] heat network service for @ViewData["CompanyName"].
                </p>

                <p class="govuk-body">
                    They've been sent an email invitation to join.
                </p>

                <div class="govuk-button-group">
                    <a asp-action="ManageUsers" asp-controller="UserManagement"  role="button" draggable="false" class="govuk-button" data-module="govuk-button">
                        Manage users
                    </a>
                </div>

            </div>
        </div>
    </main>
</div>
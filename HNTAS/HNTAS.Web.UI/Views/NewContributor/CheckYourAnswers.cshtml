@using HNTAS.Web.UI.Models.Review
@{
    ViewData["Title"] = "Check your answers";

    // Build the data structure for the partial view
    var reviewModel = new ReviewSummaryModel();

    // Section 1: Personal details
    var personalDetailsSection = new ReviewSection
    {
        Heading = "Personal details",
        Items = new List<ReviewItem>
        {
            new ReviewItem { Key = "First name", Value = "John", ChangeLink = "#", ChangeLinkText = "Change" },
            new ReviewItem { Key = "Last name", Value = "Smith", ChangeLink = "#", ChangeLinkText = "Change" }
        }
    };
    reviewModel.Sections.Add(personalDetailsSection);

    // Section 2: Contact details
    var contactDetailsSection = new ReviewSection
    {
        Heading = "Contact details",
        Items = new List<ReviewItem>
        {
            new ReviewItem { Key = "Email address", Value = "john.smith@test.com", ChangeLink = "#", ChangeLinkText = "Change" },
            new ReviewItem { Key = "Phone number", Value = "07776794301", ChangeLink = "#", ChangeLinkText = "Change" }
        }
    };
    reviewModel.Sections.Add(contactDetailsSection);

    // Section 3: Permissions
    var permissionsSection = new ReviewSection
    {
        Heading = "Permissions",
        Items = new List<ReviewItem>
        {
            new ReviewItem { Key = "Permission 1", Value = "-- pending --", ChangeLink = "#", ChangeLinkText = "Change" },
            new ReviewItem { Key = "Permission 2", Value = "-- pending --", ChangeLink = "#", ChangeLinkText = "Change" },
            new ReviewItem { Key = "Permission 3", Value = "-- pending --", ChangeLink = "#", ChangeLinkText = "Change" }
        }
    };
    reviewModel.Sections.Add(permissionsSection);
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

        <h1 class="govuk-heading-l">
            @ViewData["Title"]
        </h1>

        <partial name="_CheckYourAnswersPartial" model="reviewModel" />

        <form asp-action="SubmitAnswers" asp-controller="NewContributor" method="post">
            <button type="submit" class="govuk-button" data-module="govuk-button">
                Submit details
            </button>
        </form>

    </div>
</div>
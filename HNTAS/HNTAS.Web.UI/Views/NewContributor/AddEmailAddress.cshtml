@using HNTAS.Web.UI.Helpers
@using HNTAS.Web.UI.Models.User
@model AddUserEmailAddressModel

@{
    ViewData["Title"] = "What is the new user's email address?";
    bool hasEmailAddressErrors = ViewData.ModelState.ContainsKey(nameof(Model.EmailAddress)) && ViewData.ModelState[nameof(Model.EmailAddress)].Errors.Any();
}


<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <h1 class="govuk-heading-l">
            <span class="govuk-caption-l">Manage users for @ViewBag.OrganisationName</span>
            @ViewData["Title"]
        </h1>

        <form asp-action="SaveEmailAddress" asp-controller="NewContributor" method="post" novalidate>
            <div class="govuk-form-group @(hasEmailAddressErrors ? " govuk-form-group--error" : "")">
                <label class="govuk-label" for="EmailAddress">
                    Email address
                </label>

                @if (hasEmailAddressErrors)
                {
                    <span asp-validation-for="EmailAddress" class="govuk-error-message"></span>
                }

                <input class="govuk-input @(hasEmailAddressErrors ? "govuk-input--error" : "")"
                        id="EmailAddress"
                        name="EmailAddress"
                        type="email"
                        asp-for="EmailAddress"
                        autocomplete="email"
                        spellcheck="false"
                       aria-describedby="@(hasEmailAddressErrors ? "EmailAddress-error" : "")" />
            </div>

            <button type="submit" class="govuk-button" data-module="govuk-button">
                Continue
            </button>
        </form>

    </div>
</div>
@using HNTAS.Web.UI.Models
@model SelectRoleModel

@{
    ViewData["Title"] = "Choose the user's role";
}


<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

        <h1 class="govuk-heading-l">
            <span class="govuk-caption-l">Manage users for @ViewBag.OrganisationName</span>
            @ViewData["Title"]
        </h1>

        <form asp-action="SaveChosenRole" asp-controller="NewContributor" method="post" novalidate>
            <div class="govuk-form-group @(Html.ValidationMessageFor(m => m.SelectedRoleId) != null ? "govuk-form-group--error" : "")">

                @if (ViewData.ModelState.GetValidationState("SelectedRoleId") == Microsoft.AspNetCore.Mvc.ModelBinding.ModelValidationState.Invalid)
                {
                    <p id="SelectedRoleId-error" class="govuk-error-message">
                        <span class="govuk-visually-hidden">Error:</span> @Html.ValidationMessageFor(m => m.SelectedRoleId)
                    </p>
                }

                <fieldset class="govuk-fieldset" aria-describedby="@(Html.ValidationMessageFor(m => m.SelectedRoleId) != null ? "SelectedRoleId-error" : "")">
                    <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">
                        Choose the role
                    </legend>

                    <div class="govuk-radios" data-module="govuk-radios">
                        @foreach (var role in Model.Roles)
                        {
                            <div class="govuk-radios__item">
                                <input class="govuk-radios__input" id="role-@role.Value" name="SelectedRoleId" type="radio" value="@role.Value" @(Model.SelectedRoleId == role.Value ? "checked" : "")>
                                <label class="govuk-label govuk-radios__label" for="role-@role.Value">
                                    @role.Text
                                </label>
                            </div>
                        }
                    </div>
                </fieldset>
            </div>

            <button type="submit" class="govuk-button" data-module="govuk-button">
                Continue
            </button>
        </form>
    </div>
</div>

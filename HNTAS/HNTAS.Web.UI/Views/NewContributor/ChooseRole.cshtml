@using HNTAS.Web.UI.Models
@using HNTAS.Web.UI.Models.Components
@model SelectRoleModel

@{
    ViewData["Title"] = "Choose the user's role";
    var fieldName = nameof(Model.SelectedRoleId);
    var fieldId = Html.LowercaseIdFor(m => m.SelectedRoleId);
    var hasErrors = ViewData.ModelState.TryGetValue(fieldName, out var entry) && entry.Errors.Any();
    var errorId = $"{fieldId}-error";
    var ariaDescribedBy = hasErrors ? errorId : null;
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

        <h1 class="govuk-heading-l">
            <span class="govuk-caption-l">Manage users for @ViewBag.OrganisationName</span>
            @ViewData["Title"]
        </h1>

        <form asp-action="SaveChosenRole" asp-controller="NewContributor" method="post" novalidate>
            <div class="govuk-form-group @(hasErrors ? "govuk-form-group--error" : "")">
                <fieldset class="govuk-fieldset" aria-describedby="@ariaDescribedBy">
                    <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">
                        Choose the role
                    </legend>

                    @if (hasErrors)
                    {
                        <p id="@errorId" class="govuk-error-message">
                            <span class="govuk-visually-hidden">Error:</span>
                            @Html.ValidationMessageFor(m => m.SelectedRoleId)
                        </p>
                    }


                    @await Html.PartialAsync("Components/_GovUkRadioList", new GovUkRadioListModel
                    {
                        FieldId = Html.LowercaseIdFor(m => m.SelectedRoleId),
                        FieldName = nameof(Model.SelectedRoleId),
                        SelectedValue = Model.SelectedRoleId,
                        Items = Model.Roles
                    })
                </fieldset>
            </div>

            <button type="submit" class="govuk-button" data-module="govuk-button">
                Continue
            </button>
        </form>
    </div>
</div>

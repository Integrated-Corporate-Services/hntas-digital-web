@using static HNTAS.Web.UI.Controllers.ArmsDashboardPOCController
@model NetworkListViewModel

<div class="govuk-grid-row">
    <div class="govuk-grid-column-one-third">
        <form method="get">
            <div class="govuk-form-group">
                <label class="govuk-label govuk-!-font-weight-bold" for="search">Search networks</label>
                <input class="govuk-input" id="search" name="searchTerm" type="text" value="@Model.SearchTerm">
            </div>

            <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible">

            <div class="govuk-form-group">
                <fieldset class="govuk-fieldset">
                    <legend class="govuk-fieldset__legend govuk-fieldset__legend--s">Reporting Period</legend>

                    <div class="govuk-form-group govuk-!-margin-bottom-2">
                        <label class="govuk-label" for="month">Month</label>
                        <select class="govuk-select govuk-!-width-full" id="month" name="month">
                            <option value="">All months</option> @* This is your new default *@
                            @foreach (var m in Model.Months)
                            {
                                <option value="@m.Key" selected="@(Model.SelectedMonth == m.Key ? "selected" : null)">
                                    @m.Value
                                </option>
                            }
                        </select>
                    </div>

                    <div class="govuk-form-group">
                        <label class="govuk-label" for="year">Year</label>
                        <select class="govuk-select govuk-!-width-full" id="year" name="year">
                            @foreach (var y in Model.AvailableYears)
                            {
                                <option value="@y" selected="@(Model.SelectedYear == y ? "selected" : null)">@y</option>
                            }
                        </select>
                    </div>
                </fieldset>
            </div>

            <button type="submit" class="govuk-button">Apply filters</button>

            <p class="govuk-body govuk-!-margin-top-2">
                <a href="@Url.Action("Index", "ArmsDashboardPOC")" class="govuk-link govuk-link--no-visited-state">
                    Reset all filters
                </a>
            </p>
        </form>
    </div>

    <div class="govuk-grid-column-two-thirds">
        <h1 class="govuk-heading-l">Heat Networks</h1>

        <table class="govuk-table">
            <thead class="govuk-table__head">
                <tr class="govuk-table__row">
                    <th class="govuk-table__header">HNID</th>
                    <th class="govuk-table__header">Network Name</th>
                    <th class="govuk-table__header">Provider</th>
                    <th class="govuk-table__header">Data Period</th>
                </tr>
            </thead>
            <tbody class="govuk-table__body">
                @foreach (var network in Model.Networks)
                {
                    <tr class="govuk-table__row">
                        <td class="govuk-table__cell">
                            <a href="/arms-dashboard-poc/details?hnid=@network.Hnid&month=@(Model.SelectedMonth ?? network.LastPostDate.Month)&year=@network.LastPostDate.Year" class="govuk-link govuk-!-font-weight-bold">
                                @network.Hnid
                            </a>
                        </td>
                        <td class="govuk-table__cell">@network.Name</td>
                        <td class="govuk-table__cell">@network.Provider</td>
                        <td class="govuk-table__cell">@network.LastPostDate.ToString("MMMM yyyy")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
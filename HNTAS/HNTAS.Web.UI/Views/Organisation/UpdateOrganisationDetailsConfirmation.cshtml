@{
    ViewData["Title"] = "Your Organisation details are updated";
}

@if (string.IsNullOrEmpty(TempData["ErrorSummary"]?.ToString()) && ViewData.ModelState.IsValid)
{
    <div class="govuk-width-container">
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-two-thirds">
                <h1 class="govuk-heading-l">
                    Your Organisation details are updated
                </h1>

                <p class="govuk-body">
                    We have sent an email confirmation.
                </p>                
            </div>
        </div>
    </div>
}
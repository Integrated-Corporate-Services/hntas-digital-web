@{
    ViewData["Title"] = $"Confirmation";
}

<div class="govuk-width-container">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <div class="govuk-panel govuk-panel--confirmation">
                <h1 class="govuk-panel__title">
                    Your organisation has been registered
                </h1>
                <div class="govuk-panel__body">
                    Organisation reference number<br />
                    <strong>@ViewBag.OrganisationId</strong>
                </div>
            </div>

            <p class="govuk-body">We have:</p>
            <ul class="govuk-list govuk-list--bullet">
                <li>registered @ViewBag.CompanyName</li>
                <li>sent a confirmation email with your reference number</li>
            </ul>

            <p class="govuk-body">
                You can now add heat networks for your organisation and invite others to help provide information.
            </p>

            <a role="button" draggable="false" asp-controller="HeatNetwork" asp-action="EnterHNName" class="govuk-button">
                Continue
            </a>
        </div>
    </div>
</div>

@using HNTAS.Web.UI.Models.User
@model UserModel

@{
    ViewData["Title"] = $"Are you {Model.OrganisationName} regulatory contact for heat networks?";
    var hasError = ViewData.ModelState.ContainsKey(nameof(Model.IsRegulatoryContact)) && ViewData.ModelState[nameof(Model.IsRegulatoryContact)].Errors.Any();
    var isRegulatoryContactNameId = Html.LowercaseIdFor(m => m.IsRegulatoryContact);
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <form asp-controller="Organisation" asp-action="ConfirmRegulatoryContact" method="post">
            @Html.AntiForgeryToken()

            <div class="govuk-form-group @(hasError ? "govuk-form-group--error" : "")">
                <fieldset class="govuk-fieldset" aria-describedby="@(hasError ? "regulatory-contact-error" : "")">
                    <legend class="govuk-fieldset__legend govuk-fieldset__legend--l">
                        <h1 class="govuk-fieldset__heading">
                            Are you the regulatory contact for @Model.OrganisationName?
                        </h1>
                    </legend>

                    <p class="govuk-body">
                        This is usually your organisation's most senior staff member responsible for heat networks.
                    </p>

                    <p class="govuk-body">As the regulatory contact, you'll:</p>
                    <ul class="govuk-list govuk-list--bullet">
                        <li>be the main point of contact for any regulatory or compliance matters</li>
                        <li>have full access to the HNTAS digital service, including managing users and submitting heat network information</li>
                        <li>be responsible for inviting other users and setting their permissions</li>
                    </ul>

                    <p class="govuk-body">You can change the regulatory contact later if needed.</p>

                    <div class="govuk-fieldset__legend govuk-fieldset__legend--m">
                        <h2 class="govuk-fieldset__heading">Are you the regulatory contact?</h2>
                    </div>

                    @if (hasError)
                    {
                        <p id="regulatory-contact-error" class="govuk-error-message">
                            <span class="govuk-visually-hidden">Error:</span> @Html.ValidationMessageFor(m => m.IsRegulatoryContact)
                        </p>
                    }

                    <div class="govuk-radios" data-module="govuk-radios">
                        <div class="govuk-radios__item">
                            <input class="govuk-radios__input" id="@isRegulatoryContactNameId" name="@isRegulatoryContactNameId" type="radio" value="true" @(Model.IsRegulatoryContact == true ? "checked" : "")>
                            <label class="govuk-label govuk-radios__label" for="@isRegulatoryContactNameId">
                                Yes
                            </label>
                        </div>
                        <div class="govuk-radios__item">
                            <input class="govuk-radios__input" id="@(isRegulatoryContactNameId)-1" name="@isRegulatoryContactNameId" type="radio" value="false" @(Model.IsRegulatoryContact == false ? "checked" : "")>
                            <label class="govuk-label govuk-radios__label" for="@(isRegulatoryContactNameId)-1">
                                No
                            </label>
                        </div>
                    </div>
                </fieldset>
            </div>

            <button type="submit" class="govuk-button" data-module="govuk-button">
                Continue
            </button>
        </form>
    </div>
</div>
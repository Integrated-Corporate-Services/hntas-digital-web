@using HNTAS.Web.UI.Models
@model OtherOrganisationNameModel

@{
    ViewData["Title"] = "What is your organisation's name?";
}

<form asp-controller="Organisation" asp-action="SaveOrganisationName" method="post" novalidate>
    @Html.AntiForgeryToken()
    <div class="govuk-form-group @(ViewData.ModelState.ContainsKey("OrganisationName") && ViewData.ModelState["OrganisationName"]?.Errors.Count > 0 ? "govuk-form-group--error" : "")">
        <h1 class="govuk-label-wrapper">
            <label class="govuk-label govuk-label--l" for="OrganisationName">
                What is your organisation's name?
            </label>
        </h1>
        @if (ViewData.ModelState.ContainsKey("OrganisationName") && ViewData.ModelState["OrganisationName"]?.Errors.Count > 0)
        {
            <span id="OrganisationName-error" class="govuk-error-message">
                <span class="govuk-visually-hidden">Error:</span>
                @ViewData.ModelState["OrganisationName"]?.Errors[0].ErrorMessage
            </span>
        }
        <div id="organisation-name-hint" class="govuk-hint">
            Use the full legal name that appears on official documents, such as Companies House or government forms.
        </div>
        <input class="govuk-input govuk-!-width-two-thirds @(ViewData.ModelState.ContainsKey("OrganisationName") && ViewData.ModelState["OrganisationName"]?.Errors.Count > 0 ? "govuk-input--error" : "")"
               id="OrganisationName"
               name="OrganisationName"
               type="text"
               aria-describedby="organisation-name-hint"
               autocomplete="organization"
               value="@Model.OrganisationName" />
    </div>

    <button type="submit" class="govuk-button" data-module="govuk-button">
        Continue
    </button>
</form>
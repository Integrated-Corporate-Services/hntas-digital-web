@{
    // Set the page title which will be used in the _Layout.cshtml
    ViewData["Title"] = "You cannot continue";
    // You might pass the organisation name via ViewBag or a Model
    string organisationName = ViewBag.OrganisationName;
}

<div class="govuk-width-container">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <h1 class="govuk-heading-l">
                You cannot continue
            </h1>

            <p class="govuk-body">
                You must be authorised to act on behalf of the Responsible Party for @organisationName to register the organisation.
                Ask someone who is authorised to complete the registration. They can then invite you to join the organisation.
            </p>
        </div>
    </div>
</div>

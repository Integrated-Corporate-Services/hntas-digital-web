@{
    ViewData["Title"] = "Register your organisation";
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

        <h1 class="govuk-heading-l">
            Register your organisation
        </h1>

        <p class="govuk-body">
            You need to register your organisation before you can register any heat networks for certification.
        </p>
        <p class="govuk-body">
            You'll need either:
        </p>
        <ul class="govuk-list govuk-list--bullet">
            <li>a Companies House number</li>
            <li>or a valid business address</li>
        </ul>

        @if (ViewBag.UserPathToday == "registerOperationalHN")
        {
            <div class="govuk-warning-text">
                <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
                <strong class="govuk-warning-text__text">
                    <span class="govuk-visually-hidden">Warning</span>
                    If you have an Ofgem account, use the same email address when registering.
                </strong>
            </div>
        }

        <div class="app-button-wrapper">
            <a asp-controller="Organisation" role="button" asp-action="Start" data-module="govuk-button" draggable="false" class="govuk-button">Continue</a>
        </div>

    </div>    
</div>

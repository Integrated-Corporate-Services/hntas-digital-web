@using HNTAS.Web.UI.Models
@model QuestionWithRadiobuttonsModel

<form asp-controller="HeatNetworkEligibility" asp-action="@Model.Action" method="post" novalidate>
    @Html.AntiForgeryToken()
    @await Html.PartialAsync("_ErrorSummary", Model.FieldOrder)
    @foreach (Question q in Model.Questions)
    {
        <div class="govuk-form-group @(ViewData.ModelState.ContainsKey(q.QId) && ViewData.ModelState[q.QId].Errors.Any() ? "govuk-form-group--error" : "")">
            <fieldset class="govuk-fieldset" aria-describedby="is-in-uk-hint @(ViewData.ModelState.ContainsKey(q.QId) && ViewData.ModelState[q.QId].Errors.Any() ? $"{q.QId}-error" : "")">
                <legend class="govuk-fieldset__legend govuk-fieldset__legend--l">
                    <h1 class="govuk-fieldset__heading">@q.QText</h1>
                </legend>
                @if (!string.IsNullOrEmpty(q.QDescText))
                {
                    <p class="govuk-body">@q.QDescText</p>
                }
                @if (!string.IsNullOrEmpty(q.QHintText))
                {
                    <div id="@q.QId-question-hint" class="govuk-hint">
                        @q.QHintText
                    </div>
                }


                @if (ViewData.ModelState.ContainsKey(q.QId) && ViewData.ModelState[q.QId].Errors.Any())
                {
                    <span id="is-in-uk-error" class="govuk-error-message">
                        <span class="govuk-visually-hidden">Error:</span> @ViewData.ModelState[q.QId].Errors[0].ErrorMessage
                    </span>
                }

                <div class="govuk-radios" data-module="govuk-radios">
                    @foreach (Option option in q.Options)
                    {
                        <div class="govuk-radios__item">
                            <input class="govuk-radios__input" id="@option.OptId" name="@q.QId" type="radio" value="@option.OptValue" aria-describedby="@q.QId-hint" @(q.SeletedOption == option.OptValue ? "checked" : "")>
                            <label class="govuk-label govuk-radios__label" for="@option.OptId">@option.OptValue</label>
                            @if (!string.IsNullOrEmpty(option.OptHintText))
                            {
                                <div id="@q.QId-item-hint" class="govuk-hint govuk-radios__hint">
                                    @option.OptHintText
                                </div>
                            }
                        </div>
                    }
                </div>
            </fieldset>
        </div>
    }

    <button class="govuk-button" data-module="govuk-button" type="submit">Continue</button>
</form>
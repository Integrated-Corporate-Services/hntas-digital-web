@using HNTAS.Api.Client.Model
@using HNTAS.Web.UI.Models
@using HNTAS.Web.UI.Models.HeatNetworkRegistration
@model MainEnergyCentreStatusModel

@{
    ViewData["Title"] = "Main energy centre status";
    var fieldOrder = new[] { nameof(Model.MainEnergyCentreStatus) };
    var elementId = Html.GenerateIdFromName(nameof(Model.MainEnergyCentreStatus)).ToLowerInvariant();
    string controllerName = Convert.ToString(ViewBag.ControllerName) ?? string.Empty;
    var pageData = new QuestionWithRadiobuttonsModel
    {
        Controller = controllerName,
        Action = "MainEcStatus",
        FieldOrder = fieldOrder,
        Questions = new List<Question>
        {
            new Question
            {
                QId = elementId,
                QText = "Is your main energy centre existing or new?",
                QDescText = @"",
                QHintText = null,
                HeadingLevel= QuestionHeadingLevel.H2,
                Options = new List<Option>
                {
                    new Option { OptId = $"{elementId}", OptValue = NullableOfMainEnergyCentreStatus.Existing.ToString(), OptText = NullableOfMainEnergyCentreStatus.Existing.ToString(), OptHintText = null },
                    new Option { OptId = $"{elementId}-2", OptValue = NullableOfMainEnergyCentreStatus.New.ToString(), OptText = NullableOfMainEnergyCentreStatus.New.ToString(), OptHintText = null },
                },
                SeletedOption = Model.MainEnergyCentreStatus
            },
        }
    };
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <span class="govuk-caption-l">Add a heat network</span>
        <h1 class="govuk-heading-l">Main energy centre status</h1>

        <p class="govuk-body">
            An existing main energy centre is one already supplying customers. A new main energy centre network is one either in design or construction.
        </p>        
        @await Html.PartialAsync("_QuestionWithRadiobuttons", pageData)
    </div>
</div>
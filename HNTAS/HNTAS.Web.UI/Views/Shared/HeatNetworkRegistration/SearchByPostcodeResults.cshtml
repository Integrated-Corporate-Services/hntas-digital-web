@using HNTAS.Web.UI.Models.Address
@model SearchAddressByPostcodeModel

@{
    ViewData["Title"] = "Search Results";
    var hasAddresses = Model?.Addresses != null && Model.Addresses.Length != 0;
    string controllerName = Convert.ToString(ViewBag.ControllerName) ?? string.Empty;
}


    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <h1 class="govuk-heading-l">Search Results</h1>
            @if (hasAddresses)
            {
                @foreach (var address in Model.Addresses)
                {
                    <div class="govuk-!-padding-bottom-5">
                        <a class="govuk-link govuk-body"
                           asp-controller="HeatNetworkRegistration"
                           asp-action="SelectAddress"
                           asp-route-selectedAddress="@address">
                            @address
                        </a>
                    </div>
                }
            }
            <br />
        <h2 class="govuk-heading-m">Can't find the address?</h2>

            <p class="govuk-body">
                <a class="govuk-link" asp-controller="@ViewBag.ControllerName" asp-action="AddressManualEntry" asp-method="GET">Enter address manually</a>
            </p>
        </div>
    </div>


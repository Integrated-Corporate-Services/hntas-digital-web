@using HNTAS.Web.UI.Models
@using HNTAS.Api.Client.Model
@model HeatNetworkSuccessRedirection

@{
    ViewData["Title"] = "Next Steps";
    var fieldOrder = new[] { nameof(Model.NextAction) };
    var elementId = Html.GenerateIdFromName(nameof(Model.NextAction)).ToLowerInvariant();
    string controllerName = Convert.ToString(ViewBag.ControllerName) ?? string.Empty;

    QuestionWithRadiobuttonsModel pageData;

    string notificationHtml = string.Empty;
    string existingNetworkMessageHtml = string.Empty;


    if (ViewBag.NotificationMessages is List<string> messages && messages.Any())
    {
        notificationHtml = $@"
                        <div class=""govuk-inset-text"">
                            {string.Join("", messages.Select(x => $"<p>{x}</p>"))}
                        </div>";
    }

    if (ViewBag.ExistingNetworkMessage is string existingNetworkMessage &&
    !string.IsNullOrEmpty(existingNetworkMessage))
    {
        existingNetworkMessageHtml = $@"
                <div class=""govuk-warning-text"">
                    <span class=""govuk-warning-text__icon"" aria-hidden=""true"">!</span>
                    <strong class=""govuk-warning-text__text"">
                        <span class=""govuk-visually-hidden"">Warning</span>
                        {existingNetworkMessage}
                    </strong>
                </div>";
    }


    if (ViewBag.RegistrationSource == RegistrationSource.OFGEM)
    {
        pageData = new QuestionWithRadiobuttonsModel
        {
            Controller = controllerName,
            Action = "HeatNetworkSuccessRedirection",
            FieldOrder = fieldOrder,
            Questions = new List<Question>
        {
            new Question
            {
                QId = elementId,
                QText = "Next steps",
                QDescText = @"
                <p class='govuk-body'>
                  You've successfully registered this heat network.
                </p>

                <p class='govuk-body'>
                  You can now:
                </p>

                <ul class='govuk-list govuk-list--bullet'>
                    <li>add details about it's connections and elements</li>
                    <li>go to your dashboard to manage your heat networks and include others to support you</li>                    
                </ul>

                <h2 class='govuk-heading-m'>What you can do now</h2>
                ",
                QHintText = null,
                Options = new List<Option>
                {
                    new Option { OptId = $"{elementId}", OptValue = "HNDetails", OptText = "Resume with this heat network", OptHintText = null },                    
                    new Option { OptId = $"{elementId}-3", OptValue = "Dashboard", OptText = "Go to your dashboard", OptHintText = null }
                },
                SeletedOption = Model.NextAction
            },
        }
        };
    }
    else
    {
        pageData = new QuestionWithRadiobuttonsModel
        {
            Controller = "HeatNetworkRegistration",
            Action = "HeatNetworkSuccessRedirection",
            FieldOrder = fieldOrder,
            Questions = new List<Question>
            {
                new Question
                {
                    QId = elementId,
                    QText = "What you can do now",
                    QDescText = "",
                    HeadingLevel = QuestionHeadingLevel.H2,
                    QHintText = null,
                    Options = new List<Option>
                    {
                        new Option { OptId = $"{elementId}", OptValue = "HNDetails", OptText = "Resume with this heat network", OptHintText = null },
                        new Option { OptId = $"{elementId}-2", OptValue = "AddHN", OptText = "Add another heat network", OptHintText = null },
                        new Option { OptId = $"{elementId}-3", OptValue = "Dashboard", OptText = "Go to your dashboard", OptHintText = null }
                    },
                    SeletedOption = Model.NextAction
                }
            }
        };
    }
    
}

    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <span class="govuk-caption-l">@ViewBag.HNId @ViewBag.HNName</span>
        <h1 class="govuk-heading-l">Next steps</h1>
            <p class='govuk-body'>You've successfully registered this heat network.</p>
            <p class='govuk-body'>You can now:</p>
            <ul class='govuk-list govuk-list--bullet'>
                <li>add details about its connections and elements</li>
                <li>register another heat network</li>
                <li>go to your dashboard to manage your heat networks and include others to support you</li>
            </ul>
            @Html.Raw(notificationHtml)
            @Html.Raw(existingNetworkMessageHtml)
            @await Html.PartialAsync("_QuestionWithRadiobuttons", pageData)
        </div>
    </div>

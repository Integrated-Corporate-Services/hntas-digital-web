@using HNTAS.Web.UI.Models
@model HeatNetworkPhaseModel

@{
    ViewData["Title"] = "Network phase";
    var fieldOrder = new[] { nameof(Model.HeatNetworkPhase) };
    var elementId = Html.GenerateIdFromName(nameof(Model.HeatNetworkPhase)).ToLowerInvariant();
    
    var pageData = new QuestionWithRadiobuttonsModel
    {
        Controller = "HeatNetwork",
        Action = "EnterHNPhase",
        FieldOrder = fieldOrder,
        Questions = new List<Question>
        {
            new Question
            {
                QId = elementId,
                QText = $"Which phase is the majority of your network currently in?",
                QHintText = null,
                QDescText = null,
                HeadingLevel = QuestionHeadingLevel.H2,
                Options = new List<Option>
                {
                    new Option { OptId = $"{elementId}", OptValue = "Feasibility", OptText = "Feasibility", OptHintText = "Concept design" },
                    new Option { OptId = $"{elementId}-1", OptValue = "Design", OptText = "Design", OptHintText =  "Developed design, technical design" },
                    new Option { OptId = $"{elementId}-2", OptValue = "Construction", OptText = "Construction", OptHintText = "Construction design, installation, commissioning" },
                    new Option { OptId = $"{elementId}-3", OptValue = "Operation", OptText = "Operation", OptHintText = "Operation, maintenance, ongoing monitoring" }
                },
                SeletedOption = Model.HeatNetworkPhase
            },
        }
    };
}


    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <span class="govuk-caption-l">Add a heat network</span>
            <h1 class="govuk-heading-l">
                Network phase
            </h1>
           <p class='govuk-body'>Parts of your network may be at different phases of development.</p>
            @await Html.PartialAsync("_QuestionWithRadiobuttons", pageData)
        </div>
    </div>

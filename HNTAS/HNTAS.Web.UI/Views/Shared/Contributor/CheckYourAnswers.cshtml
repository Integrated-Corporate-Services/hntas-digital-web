@using HNTAS.Web.UI.Models.Enums
@using HNTAS.Web.UI.Models.Review
@using HNTAS.Web.UI.Models.Components
@using HNTAS.Web.UI.Workflows.Models.Data
@model ReviewSummaryModel

@{
    ViewData["Title"] = "Check your answers";
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <h1 class="govuk-heading-l">@ViewData["Title"]</h1>
        <partial name="Components/_CheckYourAnswersPartial" model="@Model" />
        <form asp-action="@ViewBag.FormAction" asp-controller="@ViewBag.FormController" method="post">
            <button type="submit" class="govuk-button" data-module="govuk-button">
                Submit details
            </button>
        </form>
    </div>
</div>

@using HNTAS.Web.UI.Models
@using HNTAS.Web.UI.Models.Components
@using HNTAS.Web.UI.Models.HeatNetwork
@model ChooseHeatNetworkModel

@{
    ViewData["Title"] = "Heat network information";
    var selectedHeatNetworkId = Html.LowercaseIdFor(m => m.SelectedHeatNetworkId);
    var hasErrors = ViewData.ModelState.TryGetValue(nameof(Model.SelectedHeatNetworkId), out var entry) && entry.Errors.Any();
    var errorId = $"{selectedHeatNetworkId}-error";
    var hintId = $"{selectedHeatNetworkId}-hint";
    var ariaDescribedBy = hasErrors ? $"{errorId} {hintId}" : hintId;
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

        <h1 class="govuk-heading-l">
            <span class="govuk-caption-l">Manage users for @ViewBag.OrganisationName</span>
            @ViewData["Title"]
        </h1>

        <form asp-action="@ViewBag.FormAction" asp-controller="@ViewBag.FormController" method="post" novalidate>
            @Html.AntiForgeryToken()

            <div class="govuk-form-group @(hasErrors ? "govuk-form-group--error" : "")">
                <fieldset class="govuk-fieldset" aria-describedby="@ariaDescribedBy">
                    <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">
                        Choose the heat network
                    </legend>

                    <div id="@hintId" class="govuk-hint">
                        Added user will be contributing for this heat network
                    </div>

                    @if (hasErrors)
                    {
                        <p id="@errorId" class="govuk-error-message">
                            <span class="govuk-visually-hidden">Error:</span>
                            @Html.ValidationMessageFor(m => m.SelectedHeatNetworkId)
                        </p>
                    }

                    @await Html.PartialAsync("Components/_GovUkRadioList",new GovUkRadioListModel
                    {
                        FieldId = Html.LowercaseIdFor(m => m.SelectedHeatNetworkId),
                        FieldName = nameof(Model.SelectedHeatNetworkId),
                        SelectedValue = Model.SelectedHeatNetworkId,
                        Items = Model.HeatNetworks
                    })
                </fieldset>
            </div>

            <button type="submit" class="govuk-button" data-module="govuk-button">
                Continue
            </button>
        </form>
    </div>
</div>

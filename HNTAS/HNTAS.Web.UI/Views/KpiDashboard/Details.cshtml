@using static HNTAS.Web.UI.Controllers.KpiDashboardController
@model ArmsDetailsViewModel

<a href="@Model.BackToListUrl" class="govuk-back-link">Back to networks</a>

<div class="govuk-grid-row govuk-!-margin-top-6">
    <div class="govuk-grid-column-one-third">
        <form asp-action="Details" method="get">
            <!-- Preserve route values -->
            <input type="hidden" name="hnid" value="@Model.Hnid" />
            <input type="hidden" name="month" value="@Model.SelectedMonth" />
            <input type="hidden" name="year" value="@Model.SelectedYear" />

            <div class="govuk-form-group">
                <fieldset class="govuk-fieldset">
                    <legend class="govuk-fieldset__legend govuk-fieldset__legend--s">
                        KPI Status
                    </legend>

                    <div class="govuk-checkboxes govuk-checkboxes--small" data-module="govuk-checkboxes">

                        <div class="govuk-checkboxes__item">
                            <input class="govuk-checkboxes__input"
                                   id="fail"
                                   name="statusFilter"
                                   type="checkbox"
                                   value="Fail"
                                   @(Model.StatusFilter.Contains("Fail") ? "checked" : "") />
                            <label class="govuk-label govuk-checkboxes__label" for="fail">
                                Fail
                            </label>
                        </div>

                        <div class="govuk-checkboxes__item">
                            <input class="govuk-checkboxes__input"
                                   id="outside"
                                   name="statusFilter"
                                   type="checkbox"
                                   value="OutsideLimit"
                                   @(Model.StatusFilter.Contains("OutsideLimit") ? "checked" : "") />
                            <label class="govuk-label govuk-checkboxes__label" for="outside">
                                Outside Limit
                            </label>
                        </div>

                    </div>
                </fieldset>
            </div>

            <button type="submit" class="govuk-button govuk-!-margin-top-2">
                Apply filters
            </button>

            <p class="govuk-body govuk-!-margin-top-2">
                <a href="@Url.Action("Details", new { hnid = Model.Hnid, month = Model.SelectedMonth, year = Model.SelectedYear })"
                   class="govuk-link govuk-link--no-visited-state">
                    Reset status filters
                </a>
            </p>
        </form>
    </div>


    <div class="govuk-grid-column-two-thirds">
        <span class="govuk-caption-l">@Model.Hnid</span>
        <h1 class="govuk-heading-l">@Model.NetworkName</h1>
        <h2 class="govuk-heading-m">
            Elements for @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(Model.SelectedMonth) @Model.SelectedYear
        </h2>

        @foreach (var group in Model.GroupedElements)
        {
            <details class="govuk-details" data-module="govuk-details">
                <summary class="govuk-details__summary">
                    <span class="govuk-details__summary-text">
                        Element ID: @group.Key
                        @if (group.Value.Any(x => x.Status == KPIAssessmentStatus.Fail))
                        {
                            <strong class="govuk-tag govuk-tag--red govuk-!-margin-left-2">Fail</strong>
                        }
                    </span>
                </summary>
                <div class="govuk-details__text">
                    <table class="govuk-table">
                        <thead class="govuk-table__head">
                            <tr class="govuk-table__row">
                                <th class="govuk-table__header">KPI ID</th>
                                <th class="govuk-table__header">Value</th>
                                <th class="govuk-table__header">Threshold</th>
                                <th class="govuk-table__header">Status</th>
                            </tr>
                        </thead>
                        <tbody class="govuk-table__body">
                            @foreach (var kpi in group.Value)
                            {
                                <tr class="govuk-table__row">
                                    <td class="govuk-table__cell">@kpi.KpiId</td>
                                    <td class="govuk-table__cell">@kpi.Value</td>
                                    <td class="govuk-table__cell">@kpi.Threshold</td>
                                    <td class="govuk-table__cell">
                                        <strong class="govuk-tag @(kpi.Status == KPIAssessmentStatus.Pass ? "govuk-tag--green" : "govuk-tag--red")">
                                            @kpi.Status
                                        </strong>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </details>
        }

        <nav class="govuk-pagination" role="navigation" aria-label="results">
            @if (Model.HasPreviousPage)
            {
                <div class="govuk-pagination__prev">
                    <a class="govuk-link govuk-pagination__link"
                       href="@Url.Action("Details", new { hnid = Model.Hnid, month = Model.SelectedMonth, year = Model.SelectedYear, statusFilter = Model.StatusFilter, page = Model.CurrentPage - 1 })" rel="prev">
                        <svg class="govuk-pagination__icon govuk-pagination__icon--prev" xmlns="http://www.w3.org/2000/svg" height="13" width="15" aria-hidden="true" focusable="false" viewBox="0 0 15 13">
                            <path d="m6.5938-0.0078125-6.7266 6.7266 6.7441 6.4062 1.377-1.449-4.1856-3.9768h12.896v-2h-12.984l4.2931-4.293-1.414-1.414z"></path>
                        </svg>
                        <span class="govuk-pagination__link-title">Previous</span>
                    </a>
                </div>
            }

            <ul class="govuk-pagination__list">
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="govuk-pagination__item @(i == Model.CurrentPage ? "govuk-pagination__item--current" : "")">
                        <a class="govuk-link govuk-pagination__link"
                           href="@Url.Action("Details", new { hnid = Model.Hnid, month = Model.SelectedMonth, year = Model.SelectedYear, statusFilter = Model.StatusFilter, page = i })" aria-label="Page @i">
                            @i
                        </a>
                    </li>
                }
            </ul>

            @if (Model.HasNextPage)
            {
                <div class="govuk-pagination__next">
                    <a class="govuk-link govuk-pagination__link"
                       href="@Url.Action("Details", new { hnid = Model.Hnid, month = Model.SelectedMonth, year = Model.SelectedYear, statusFilter = Model.StatusFilter, page = Model.CurrentPage + 1 })" rel="next">
                        <span class="govuk-pagination__link-title">Next</span>
                        <svg class="govuk-pagination__icon govuk-pagination__icon--next" xmlns="http://www.w3.org/2000/svg" height="13" width="15" aria-hidden="true" focusable="false" viewBox="0 0 15 13">
                            <path d="m8.107-0.0078125-1.4136 1.414 4.2926 4.293h-12.986v2h12.896l-4.1855 3.9766 1.377 1.4492 6.7441-6.4062-6.7246-6.7266z"></path>
                        </svg>
                    </a>
                </div>
            }
        </nav>

        <p class="govuk-body govuk-!-margin-top-4">
            Showing <b>@Model.FromRecord</b> to <b>@Model.ToRecord</b> of <b>@Model.TotalElements</b> elements
        </p>
    </div>
</div>
@using System.Collections.Generic;
@model HNTAS.Web.UI.Models.User.ManageUsersModel

@{
    ViewData["Title"] = "Manage users"; // This sets the title that might be used in the _Layout.cshtml
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
        <hgroup class="govuk-!-margin-bottom-4">
            <p class="govuk-body-l govuk-!-margin-top-4 govuk-!-margin-bottom-6">@Model.OrganisationName</p>
             <h1 class="govuk-heading-xl">Manage users</h1>
        </hgroup>

        <h2 class="govuk-heading-l">Users</h2>

        <table class="govuk-table">
            <thead class="govuk-table__head">
                <tr class="govuk-table__row">
                    <th scope="col" class="govuk-table__header">Name</th>
                    <th scope="col" class="govuk-table__header">Email address</th>
                    <th scope="col" class="govuk-table__header">Status</th>
                    <th scope="col" class="govuk-table__header"></th> @* For the View link *@
                </tr>
            </thead>
            <tbody class="govuk-table__body">
                @foreach (var user in Model.Users)
                {
                    <tr class="govuk-table__row">
                        <td class="govuk-table__cell">
                            @user.Name
                            @if (user.Roles != null && user.Roles.Any())
                            {
                               <br /> <span class="govuk-body govuk-!-font-size-16 govuk-!-margin-top-1">(@string.Join(", ", user.Roles))</span>
                            }
                        </td>
                        <td class="govuk-table__cell">@user.EmailAddress</td>
                        <td class="govuk-table__cell">
                            <strong class="govuk-tag @(user.Status == "Active" ? "govuk-tag--green" : "govuk-tag--grey")">
                                @user.Status
                            </strong>
                        </td>
                        <td class="govuk-table__cell govuk-table__cell--numeric">
                            <a class="govuk-link govuk-link--no-visited-state" href="">View</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <p class="govuk-!-margin-top-6">
            <a href="#" role="button" draggable="false" class="govuk-button" data-module="govuk-button">
                Add new user
            </a>
        </p>

    </div>
</div>
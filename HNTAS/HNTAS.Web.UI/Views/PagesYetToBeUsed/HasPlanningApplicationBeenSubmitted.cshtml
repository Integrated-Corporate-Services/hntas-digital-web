@using HNTAS.Web.UI.Models
@model HasPlanningApplicationBeenSubmittedViewModel

@{
    ViewData["Title"] = "Check your eligibility to register a heat network";
    var fieldOrder = new[] { nameof(Model.HasPlanningApplicationBeenSubmitted) };
    var pageData = new QuestionWithRadiobuttonsModel
    {
        Controller = "HeatNetworkEligibility",
        Action = "HasPlanningApplicationBeenSubmitted",
        FieldOrder = fieldOrder,
        Questions = new List<Question>
        {
            new Question
            {
                QId = nameof(Model.HasPlanningApplicationBeenSubmitted),
                QText = "Has a planning application been submitted for this heat network?",
                QDescText = null,
                QHintText = null,
                Options = new List<Option>
                {
                    new Option { OptId = "yes", OptText = "Yes", OptHintText = null },
                    new Option { OptId = "no", OptText = "No", OptHintText = null }
                },
                SeletedOption = Model.HasPlanningApplicationBeenSubmitted
            },
        }
    };
}

<div class="govuk-width-container">
    @await Html.PartialAsync("_QuestionWithRadiobuttons", pageData)
</div>
@{
    ViewData["Title"] = "You are eligible for this service";
}

<div class="govuk-width-container">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <h1 class="govuk-heading-l">
                You should use this service
            </h1>
            <p class="govuk-body">
                Use this service to register heat networks with HNTAS.
            </p>
            <p class="govuk-body">
                To continue, sign in or create a GOV.UK One Login account.
            </p>
            <p class="govuk-body">
                GOV.UK One Login lets you sign in to government services using one account. Use your organisation email address if you have one. You can also invite colleagues to help manage your organisation and heat networks.
            </p>

            <p class="govuk-body">
                Once you've signed in, you can register your organisation and add heat networks for certification.
            </p>            
            <div class="app-button-wrapper">
                <button class="govuk-button" type="button" data-module="govuk-button" draggable="false" onclick="location.href='@Url.Action("Index", "Home")'">
                    Continue to GOV.UK One Login
                </button>
            </div>
        </div>    
    </div>
</div>
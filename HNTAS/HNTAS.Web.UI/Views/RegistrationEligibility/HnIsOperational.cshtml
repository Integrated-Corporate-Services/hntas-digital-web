@{
    ViewData["Title"] = "You do not need to use this service";
}
<div class="govuk-width-container">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <h1 class="govuk-heading-l">
                You do not need to use this service
            </h1>

            <p class="govuk-body">
                Based on your answers, your organisation is not currently developing any new heat networks.
            </p>

            <p class="govuk-body">
                The Heat Network Technical Assurance Scheme (HNTAS) applies to new heat networks during design and construction, before they begin operating.
            </p>

            <p class="govuk-body">
                If your organisation already has operational heat networks, you may still need to follow Ofgem’s heat network regulations.
            </p>

            <p class="govuk-body">
                <a class="govuk-link" href="#">Check Ofgem guidance</a> to find out more information.
            </p>
        </div>
    </div>
</div>

@using HNTAS.Web.UI.Models
@model AreYouTheRPModel

@{
    ViewData["Title"] = "Responsible Party - Check your eligibility to register a heat network";
    var fieldOrder = new[] { nameof(Model.AreYouTheRP) };
    var elementId = Html.GenerateIdFromName(nameof(Model.AreYouTheRP)).ToLowerInvariant();
    var pageData = new QuestionWithRadiobuttonsModel
    {
        Controller = "HeatNetworkEligibility",
        Action = "AreYouTheRP",
        FieldOrder = fieldOrder,
        Questions = new List<Question>
        {
            new Question
            {
                QId = elementId,
                QText = "Responsible Party",
                QDescText =
                    @"
                    <p class='govuk-body'>You are responsible if you have overall accountability for heat networks at an organisation level.</p>

                    <p class='govuk-body'>This is usually a director, trustee, or someone who reports to a senior leadership group.</p>

                    <p class='govuk-body'>As the Responsible Party, you can delegate responsibility for individual heat networks to others in your organisation.</p>

                    <p class='govuk-body'>Those people can then involve network specialists as needed.</p>

                    <legend class='govuk-fieldset__legend govuk-fieldset__legend--m'>
                        <h1 class='govuk-fieldset__heading'>
                            Are you responsible for heat networks in your organisation?
                        </h1>
                    </legend>",
                QHintText = null,
                Options = new List<Option>
                {
                    new Option { OptId = $"{elementId}", OptValue = "yes", OptText = "Yes", OptHintText = null },
                    new Option { OptId = $"{elementId}-2", OptValue = "no", OptText = "No", OptHintText = null }
                },
                SeletedOption = Model.AreYouTheRP
            },
        }
    };
}

<div class="govuk-width-container">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">            
            @await Html.PartialAsync("_QuestionWithRadiobuttons", pageData)
        </div>
    </div>
</div>
@{
    ViewData["Title"] = "Heat network responsibility";
}

<div class="govuk-width-container">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <h1 class="govuk-heading-l">
                Heat network responsibility
            </h1>
            <p class="govuk-body">
                Speak to your leadership team to decide who is responsible for heat networks in your organisation.
            </p>
            <p class="govuk-body">
                If it is someone else in your organisation, ask them to register.
            </p>
            <p class="govuk-body">
                If you are given permission to register, return to this service and continue.
            </p>
        </div>
    </div>
</div>

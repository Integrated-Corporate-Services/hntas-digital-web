@using HNTAS.Web.UI.Models
@model IsYourOrgWorkingOnANewHNModel

@{
    ViewData["Title"] = "Is your organisation working on any new heat networks that are not yet operational?";
    var fieldOrder = new[] { nameof(Model.IsYourOrgWorkingOnANewHN) };
    var elementId = Html.GenerateIdFromName(nameof(Model.IsYourOrgWorkingOnANewHN)).ToLowerInvariant();
    var pageData = new QuestionWithRadiobuttonsModel
    {
        Controller = "HeatNetworkEligibility",
        Action = "IsYourOrgWorkingOnANewHN",
        FieldOrder = fieldOrder,
        Questions = new List<Question>
        {
            new Question
            {
                QId = elementId,
                QText = "Is your organisation working on any new heat networks that are not yet operational?",
                QDescText = null,
                QHintText = "This includes heat networks in feasibility, design or construction across your organisation",
                Options = new List<Option>
                {
                    new Option { OptId = $"{elementId}", OptValue = "yes", OptText = "Yes", OptHintText = null },
                    new Option { OptId = $"{elementId}-2", OptValue = "no", OptText = "No", OptHintText = null }
                },
                SeletedOption = Model.IsYourOrgWorkingOnANewHN
            },
        }
    };
}

<div class="govuk-width-container">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            @await Html.PartialAsync("_QuestionWithRadiobuttons", pageData)
        </div>
    </div>
</div>
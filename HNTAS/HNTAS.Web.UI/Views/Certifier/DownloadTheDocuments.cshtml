@using HNTAS.Web.UI.Models.Soa
@model SOAReviewSummaryViewModel

@{
    ViewData["Title"] = "Download the documents";
}

<div class="govuk-width-container">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-full">
            <div class="govuk-grid-row">
                <div class="govuk-grid-column-two-thirds">

                    <h1 class="govuk-heading-l">
                        Download the documents of @ViewBag.HeatNetworkName
                    </h1>

                    <h2 class="govuk-heading-m">
                        Phase @Model.Phase overall Statement of applicability (SOA)
                    </h2>

                    <dl class="govuk-summary-list">
                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key">
                                Element list
                            </dt>
                            <dd class="govuk-summary-list__value">
                                @foreach (var element in Model.Elements)
                                {
                                    @($"{element.Name} ({element.Count})")

                                    <br />
                                }
                            </dd>
                        </div>
                    </dl>

                    <h2 class="govuk-heading-m">
                        Stage 1 SOA documents
                    </h2>

                    <dl class="govuk-summary-list">
                        @foreach (var eleDoc in Model.ElementDocuments)
                        {
                            <div class="govuk-summary-list__row">
                                <dt class="govuk-summary-list__key">
                                    @eleDoc.Name
                                </dt>
                                <dd class="govuk-summary-list__value">
                                    @foreach (var doc in eleDoc.Documents)
                                    {
                                        @($"[{doc.FileName}]")

                                        <br />
                                    }
                                </dd>
                                <dd class="govuk-summary-list__actions">
                                    @foreach (var doc in eleDoc.Documents)
                                    {
                                        <a class="govuk-link" href="@doc.DownloadUrl">
                                            Download
                                        </a>

                                        <br />
                                    }
                                </dd>
                            </div>
                        }
                    </dl>

                    <h2 class="govuk-heading-m">
                        Assessment plan
                    </h2>

                    <dl class="govuk-summary-list">
                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key">
                                @Model.AssessmentPlanDocument.Name
                            </dt>
                            <dd class="govuk-summary-list__value">
                                @($"[{Model.AssessmentPlanDocument.Documents.FirstOrDefault().FileName}]")
                            </dd>
                            <dd class="govuk-summary-list__actions">
                                <a class="govuk-link" href="@(Model.AssessmentPlanDocument.Documents.FirstOrDefault().DownloadUrl ?? "#")">
                                    Download
                                </a>
                            </dd>
                        </div>
                    </dl>

                    <form asp-action="SubmitDownloadTheDocuments" method="post">
                        <button type="submit" class="govuk-button" data-module="govuk-button">
                            Continue
                        </button>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

@using HNTAS.Web.UI.Models
@model HNTAS.Web.UI.Models.WhatDoYouWantToDoViewModel

@{
    ViewData["Title"] = "What do you want to do?";
    var fieldOrder = new[] { nameof(Model.UserPathToday) };
    var elementId = Html.GenerateIdFromName(nameof(Model.UserPathToday)).ToLowerInvariant();
    var pageData = new QuestionWithRadiobuttonsModel
    {
        Controller = "Home",
        Action = "WhatDoYouWantToDo",
        FieldOrder = fieldOrder,
        Questions = new List<Question>
        {
            new Question
            {
                QId = elementId,
                QText = "What do you want to do?",
                QDescText = "Choose an option so we can take you to the right part of the service.",
                QHintText = null,
                Options = new List<Option>
                {
                    new Option { OptId = $"{elementId}", OptValue = "registerNewHN", OptText = "Register a new organisation with pre-operational heat network", OptHintText = "You'll answer a few questions to check if your network needs to meets the requirements." },
                    new Option { OptId = $"{elementId}-2", OptValue = "updateExistingHN", OptText = "Resume adding details to your heat networks", OptHintText = "You'll sign in and be taken to your account." },
                },
                SeletedOption = Model.UserPathToday
            }
        }
    };

}

<div class="govuk-width-container">
    @await Html.PartialAsync("_QuestionWithRadiobuttons", pageData)
</div>


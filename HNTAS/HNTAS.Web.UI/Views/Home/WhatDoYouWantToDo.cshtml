@using HNTAS.Web.UI.Models
@model HNTAS.Web.UI.Models.WhatDoYouWantToDoViewModel

@{
    ViewData["Title"] = "What do you want to do?";
    var fieldOrder = new[] { nameof(Model.UserPathToday) };
    var elementId = Html.GenerateIdFromName(nameof(Model.UserPathToday)).ToLowerInvariant();
    var pageData = new QuestionWithRadiobuttonsModel
    {
        Controller = "Home",
        Action = "WhatDoYouWantToDo",
        FieldOrder = fieldOrder,
        Questions = new List<Question>
        {
            new Question
            {
                QId = elementId,
                QText = "What do you want to do?",                
                QHintText = null,
                Options = new List<Option>
                {
                    new Option { OptId = $"{elementId}", OptValue = "updateExistingHN", OptText = "Sign in to your HNTAS account", OptHintText = "Access your pre-operational and operational networks" },
                    new Option { OptId = $"{elementId}-2", OptValue = "registerNewHN", OptText = "Register a new organisation with pre-operational networks", OptHintText = "You have networks in an initial design or build phase" },
                    new Option { OptId = $"{elementId}-3", OptValue = "registerOperationalHN", OptText = "Register a new organisation with operational networks", OptHintText = "You have been notified to certify your Ofgem registered networks" },
                    
                },
                SeletedOption = Model.UserPathToday
            }
        }
    };

}

<div class="govuk-width-container">
    @await Html.PartialAsync("_QuestionWithRadiobuttons", pageData)
</div>


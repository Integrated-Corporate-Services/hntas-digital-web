@{
    ViewData["Title"] = "Certify your heat networks with the Heat Network Technical Assurance Scheme (HNTAS)";
}


<div class="govuk-width-container">
   
    <main class="govuk-main-wrapper" id="main-content" role="main">
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-full">

                <h1 class="govuk-heading-l">
                    Certify your heat networks with the Heat Network Technical Assurance Scheme (HNTAS)
                </h1>

                <p class="govuk-body">
                    Use this service to register your organisation and heat networks in England, Scotland and Wales.
                </p>

                <p class="govuk-body">
                    You'll provide information for assessment and certification.
                </p>

                <h2 class="govuk-heading-m">Who this service is for</h2>
                <p class="govuk-body">
                    You should use this service if your organisation is responsible for developing, owning or operating a heat network that needs to meet the HNTAS technical standards.
                </p>
                <p class="govuk-body">
                    This includes:
                </p>
                <ul class="govuk-list govuk-list--bullet">
                    <li>developers planning or building new heat networks</li>
                    <li>owners or operators of existing heat networks</li>
                    <li>local authorities or housing associations responsible for heat networks</li>
                </ul>

                <h2 class="govuk-heading-m">What you'll need</h2>
                <p class="govuk-body">
                    We will ask you for:
                </p>
                <ul class="govuk-list govuk-list--bullet">
                    <li>details about your organisation</li>
                    <li>network status i.e. whether your heat networks are new or existing</li>
                    <li>network characteristics and network elements</li>
                </ul>
                
                <p class="govuk-body">
                    Within the service, you’ll be able to invite others to help complete the information required to certify each network.
                </p>                

                <a href="@ViewBag.NavigateUrl" role="button" draggable="false" class="govuk-button govuk-button--start govuk-button--start-green" data-module="govuk-button" style="margin-top: 16px;">
                    Start now
                    <svg class="govuk-button__start-icon" xmlns="http://www.w3.org/2000/svg" width="17.5" height="19" viewBox="0 0 33 40" aria-hidden="true" focusable="false">
                        <path fill="currentColor" d="M0 0h13l20 20-20 20H0l20-20z" />
                    </svg>
                </a>

                <h2 class="govuk-heading-m" >Before you start</h2>

                <p class="govuk-body">
                    You may find it helpful to read:
                </p>

                <ul class="govuk-list govuk-list--bullet">
                    <li><a target="_blank" href="https://www.gov.uk/government/publications/heat-networks-regulation-technical-standards/heat-network-technical-assurance-scheme-hntas#ts1--the-heat-network-technical-standard" class="govuk-link">Heat Network Technical Assurance Scheme</a></li>
                    <li><a target="_blank" href="https://www.gov.uk/government/publications/heat-network-technical-standard-ts1" class="govuk-link">Heat network technical standard (TS1)</a></li>
                    <li><a target="_blank" href="https://www.gov.uk/government/collections/heat-network-technical-assurance-scheme-hntas-draft-code-documents" class="govuk-link">HNTAS Code Documents</a></li>
                    Draft technical specifications and assessment procedures for new and existing heat networks.
                </ul>                           
            </div>            
        </div>
    </main>
</div>
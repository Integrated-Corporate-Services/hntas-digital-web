@{
    ViewData["Title"] = "Certify your heat networks";
}

<div class="govuk-width-container">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">

            <h1 class="govuk-heading-l">Certify your heat networks</h1>

            <p class="govuk-body">
                Use this service to register your organisation and certify your heat networks with the Heat Network Technical Assurance Scheme (HNTAS).
            </p>

            <p class="govuk-body">
                Only use this service for heat networks in England, Scotland and Wales.
            </p>

            <h2 class="govuk-heading-m">Who this service is for</h2>
            <p class="govuk-body">
                You should use this service if your organisation is responsible for developing, owning or operating heat networks that needs to meet the HNTAS technical standards.
            </p>

            <p class="govuk-body">This includes:</p>
            <ul class="govuk-list govuk-list--bullet">
                <li>developers planning or building new heat networks</li>
                <li>owners or operators of existing heat networks</li>
                <li>local authorities or housing associations responsible for heat networks</li>
            </ul>

            <h2 class="govuk-heading-m">What you'll need</h2>
            <p class="govuk-body">
                You'll provide information for assessment and certification, including:
            </p>
            <ul class="govuk-list govuk-list--bullet">
                <li>details about your organisation</li>
                <li>whether your heat networks are new or existing</li>
                <li>network phases, characteristics, connections and elements</li>
            </ul>

            <p class="govuk-body">
                Within the service, you'll be able to invite others to add networks and help complete the information required to certify each network.
            </p>

            <a href="@ViewBag.NavigateUrl" role="button" draggable="false" class="govuk-button govuk-button--start govuk-button--start-green" data-module="govuk-button" style="margin-top: 16px;">
                Start now
                <svg class="govuk-button__start-icon" xmlns="http://www.w3.org/2000/svg" width="17.5" height="19" viewBox="0 0 33 40" aria-hidden="true" focusable="false">
                    <path fill="currentColor" d="M0 0h13l20 20-20 20H0l20-20z" />
                </svg>
            </a>

        </div>

        <div class="govuk-grid-column-one-third">
            <aside aria-labelledby="related-content-heading" class="govuk-related">
                <h2 class="govuk-heading-m" id="subsection-title">
                    Related content
                </h2>
                <nav role="navigation" aria-labelledby="subsection-title">
                    <ul class="govuk-list govuk-!-font-size-16">
                        <li><a href="https://www.gov.uk/government/publications/heat-networks-regulation-technical-standards/heat-network-technical-assurance-scheme-hntas#ts1--the-heat-network-technical-standard" class="govuk-link" rel="noreferrer noopener" target="_blank">Heat Network Technical Assurance Scheme<span class="govuk-visually-hidden">(opens in a new tab)</span></a></li>
                        <li><a href="https://www.gov.uk/government/publications/heat-network-technical-standard-ts1" class="govuk-link" rel="noreferrer noopener" target="_blank">Heat Network Technical Standard (TS1)<span class="govuk-visually-hidden">(opens in a new tab)</span></a></li>
                        <li>
                            <a href="https://www.gov.uk/government/collections/heat-network-technical-assurance-scheme-hntas-draft-code-documents" class="govuk-link" rel="noreferrer noopener" target="_blank">HNTAS Code Documents<span class="govuk-visually-hidden">(opens in a new tab)</span></a>
                        </li>
                    </ul>
                </nav>
            </aside>
        </div>
    </div>
</div>
@{
    ViewData["Title"] = "Help";
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <h1 class="govuk-heading-l">
            Get help with this service
        </h1>
        <h2 class="govuk-heading-m">Get help with certification</h2>
        <p class="govuk-body">We can help if you:</p>
        <ul class="govuk-list govuk-list--bullet">
            <li>are not sure where to start</li>
            <li>do not understand a term or requirement</li>
            <li>need help registering an organisation or adding a heat network</li>
        </ul>

        <p class="govuk-body"><strong>Email</strong></p>
        <p class="govuk-body govuk-!-margin-bottom-6"><a href="mailto:cyhn.support@energysecurity.gov.uk" class="govuk-link">cyhn.support@energysecurity.gov.uk</a></p>

        <h2 class="govuk-heading-m">Get help with service issues</h2>

        <p class="govuk-body">We can help if you:</p>
        <ul class="govuk-list govuk-list--bullet">
            <li>have problems inviting users or updating information</li>
            <li>want to report a technical issue or accessibility problem</li>
        </ul>

        <p class="govuk-body"><strong>Email</strong></p>
        <p class="govuk-body govuk-!-margin-bottom-6"><a href="mailto:hntas_digital.support@energysecurity.gov.uk" class="govuk-link">hntas_digital.support@energysecurity.gov.uk</a></p>
        <p class="govuk-body">We aim to respond within 2 working days.</p>


    </div>


</div>

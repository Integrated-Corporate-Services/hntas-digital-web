@{
    ViewData["Title"] = "Help";
}
<div class="govuk-width-container">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-full">
            <h1 class="govuk-heading-xl">Contact the HNTAS support team</h1>
            <p class="govuk-body">Email the support team if you need help using the service.</p>
            <p class="govuk-body"><strong>Email:</strong> <a href="mailto:hntas_digital.support@energysecurity.gov.uk">hntas_digital.support@energysecurity.gov.uk</a></p>

            <p class="govuk-body">Include:</p>
            <ul class="govuk-list govuk-list--bullet">
                <li>your full name</li>
                <li>your organisation name (if you have one)</li>
                <li>what you were trying to do</li>
                <li>any error messages</li>
                <li>any reference numbers</li>
                <li>screenshots (if you can provide them)</li>
            </ul>

            <p class="govuk-body">This helps us understand the problem and respond more quickly.</p>
            <p class="govuk-body">We aim to respond during normal working hours (business hours during weekdays excluding public holidays).</p>

            <hr />

            <h2 class="govuk-heading-l">Get Assisted Digital support</h2>
            <p class="govuk-body">You can get Assisted Digital support if you <strong>cannot</strong> use the service online.</p>
            <p class="govuk-body">This may be because you:</p>
            <ul class="govuk-list govuk-list--bullet">
                <li>do not have access to the internet</li>
                <li>are not confident using digital services</li>
                <li>have accessibility needs</li>
                <li>are experiencing technical problems</li>
            </ul>

            <p class="govuk-body">Getting Assisted Digital support does not affect how your submission is assessed or any technical assurance decisions.</p>

            <hr />

            <h2 class="govuk-heading-l">What Assisted Digital support can help with</h2>
            <p class="govuk-body">Assisted Digital support can help you:</p>
            <ul class="govuk-list govuk-list--bullet">
                <li>understand what information you need to use the service</li>
                <li>access and use the service</li>
                <li>complete online forms</li>
            </ul>

            <hr />

            <h2 class="govuk-heading-l">What Assisted Digital support cannot do</h2>
            <p class="govuk-body">Assisted Digital support cannot:</p>
            <ul class="govuk-list govuk-list--bullet">
                <li>complete or submit information for you</li>
                <li>make technical assurance decisions</li>
                <li>give advice on scheme requirements or outcomes</li>
            </ul>

            <hr />

            <h2 class="govuk-heading-l">Accessibility support</h2>
            <p class="govuk-body">DESNZ is committed to making its digital services accessible.</p>
            <p class="govuk-body">If you need support because of a disability or accessibility need, email the support team and explain how they can help.</p>

            <hr />

            <h2 class="govuk-heading-l">What this support cannot help with</h2>
            <p class="govuk-body">This support is only for help using the digital service.</p>
            <p class="govuk-body">For questions about:</p>
            <ul class="govuk-list govuk-list--bullet">
                <li>scheme rules</li>
                <li>technical requirements</li>
                <li>assurance outcomes</li>
                <li>complaints</li>
            </ul>
            <p class="govuk-body">Please use <a href="#">the relevant DESNZ guidance or complaints process</a>. [Link to form]</p>

            <p class="govuk-body"><small>Last updated: 24 June 2026</small></p>
        </div>
    </div>
</div>
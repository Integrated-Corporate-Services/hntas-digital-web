@{
    ViewData["Title"] = "Heat network summary";
}
<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <span class="govuk-caption-l">Add a heat network - @ViewBag.HnId</span>
        <h1 class="govuk-heading-l">
            Heat network summary
        </h1>
        <p class="govuk-body">You're registering a communal heat network with its own energy centre.</p>

        <button class="govuk-button" onclick="location.href='@Url.Action("HeatNetworkName", "ExistingHeatNetworkRegistration")'">
            Continue
        </button>
    </div>
</div>
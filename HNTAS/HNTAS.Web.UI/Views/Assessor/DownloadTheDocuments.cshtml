@using HNTAS.Web.UI.Models;
@model DownloadTheDocumentModel;

@{
    ViewData["Title"] = "Download the documents";
}

<div class="govuk-width-container">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <h1 class="govuk-heading-l">
                Download the documents for Olympic Park Aberdeen
            </h1>

            <h2 class="govuk-heading-m">
                    @Model.Phase overall Statement of applicability (SOA)
            </h2><br/>
            <div class="govuk-grid-row">
                <div class="govuk-grid-column-one-third"><p class="govuk-body govuk-!-font-weight-bold">Element list</p></div>
                <div class="govuk-grid-column-two-third">
                    <ul class="govuk-list">
                        @foreach(var element in Model.ElementList)
                        {
                            <li>@element.Name (@element.Count)</li>
                        }
                    </ul>
                </div>                
            </div>
            
            <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible" />

            <br/>
            <h2 class="govuk-heading-m govuk-!-margin-bottom-2">
                @Model.Stage SOA documents
            </h2>
            <br/>
            <div class="govuk-form-group">
                <div class="govuk-grid-row">
                    <div class="govuk-grid-column-one-third"><p class="govuk-body govuk-!-font-weight-bold">@Model.Element</p></div>
                    @foreach (var doc in Model.Documents)
                    {
                        <div class="govuk-grid-column-one-third govuk-!-text-colour-muted">
                            <ul class="govuk-list">

                                <li>@doc.FileName</li>

                            </ul>
                        </div>
                        <div class="govuk-grid-column-one-third">
                            <a href="@Url.Action("Download", "Assessor", new { stage = doc.Stage, filename = doc.FileName, element = Model.Element })" class="govuk-link">Download</a>
                        </div>
                    }
                </div>
                <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible" />
            </div>

            <br/>
            <h2 class="govuk-heading-m govuk-!-margin-bottom-2">
                Assessment plan
            </h2>
            <br/>
            <div class="govuk-form-group govuk-!-margin-bottom-4">
                <div class="govuk-grid-row">
                    <div class="govuk-grid-column-one-third"><p class="govuk-body govuk-!-font-weight-bold">Assessment plan</p></div>
                    @foreach(var doc in Model.Documents)
                    {
                        <div class="govuk-grid-column-one-third govuk-!-text-colour-muted">
                        <p class="govuk-body">@Model.AssessementPlan.DocNames.FirstOrDefault()</p>
                        </div>
                        <div class="govuk-grid-column-one-third">
                        <a href="#" class="govuk-link">Download</a>
                        </div>
                    }
                </div>
                <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible" />
            </div>
            <form method="post">
                <input type="hidden" value="@Model.Phase"/>
                <div class="app-button-wrapper">
                    <button type="submit" class="govuk-button" data-module="govuk-button">
                        Continue
                    </button>
                </div>
            </form>
           
        </div>
    </div>
</div>
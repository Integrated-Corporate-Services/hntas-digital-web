
@{
    ViewData["Title"] = "Heat network details";
}

<div class="govuk-width-container">
    <span class="govuk-hint govuk-!-font-size-27">Heat network</span>
    <h1 class="govuk-heading-xl" style="margin-bottom: 1.5rem;">xxxxxxxxxxxxxxModel.Name</h1>
    <div class="govuk-summary-list">
        <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">Name</dt>
            <dd class="govuk-summary-list__value">Heat network 1</dd>
        </div>
        <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">Address</dt>
            <dd class="govuk-summary-list__value">
                ABC LIMITED<br />
                20 Barton Drive,<br />
                Knowle,<br />
                Solihull,<br />
                West Midlands,<br />
                B93 0PE
            </dd>
        </div>
        <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">UHNID</dt>
            <dd class="govuk-summary-list__value">xxxxxxxModel.UHNID</dd>
        </div>
        <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">Organisation name</dt>
            <dd class="govuk-summary-list__value">xxxxxxxModel.OrganisationName</dd>
        </div>
        <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">Location</dt>
            <dd class="govuk-summary-list__value">
                @if (!string.IsNullOrEmpty(null))
                {
                    <a href="xxxxxxxModel.LocationUrl" target="_blank">W3W url will come here...</a>
                }
                else
                {
                    <span>W3W url will come here...</span>
                }
            </dd>
        </div>
        <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">Pathway</dt>
            <dd class="govuk-summary-list__value">Show the pathway build..</dd>
        </div>
    </div>

    <h2 class="govuk-heading-m" style="margin-top:2rem;">Progress so far</h2>
    <p class="govuk-body">You can see the updated progress of your heat network at element level.</p>

    <div class="govuk-tabs" data-module="govuk-tabs">
        <ul class="govuk-tabs__list">
            <li class="govuk-tabs__list-item govuk-tabs__list-item--selected">Phase 1</li>
            <li class="govuk-tabs__list-item">Phase 2</li>
            <li class="govuk-tabs__list-item">Phase 3</li>
            <li class="govuk-tabs__list-item">Phase 4</li>
            <li class="govuk-tabs__list-item">Phase 5</li>
        </ul>
        <div class="govuk-tabs__panel" id="phase-1">
            <h3 class="govuk-heading-m">Feasibility</h3>
            <p class="govuk-body-s">Stage 1 - concept design</p>
            <table class="govuk-table">
                <thead class="govuk-table__head">
                    <tr class="govuk-table__row">
                        <th class="govuk-table__header">Element List</th>
                        <th class="govuk-table__header">Status</th>
                        <th class="govuk-table__header">Action</th>
                    </tr>
                </thead>
                <tbody class="govuk-table__body">
                    <tr class="govuk-table__row">
                        <td class="govuk-table__cell"><a href="#">Energy centre</a></td>
                        <td class="govuk-table__cell">Assigned to assessor</td>
                        <td class="govuk-table__cell"><a href="#">Continue</a></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
@using HNTAS.Web.UI.Models
@model UploadSOCViewModel

@{
    ViewData["Title"] = "Upload statement of conformity (SOC)";
}

<div class="govuk-width-container">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <span class="govuk-caption-l">Assessor</span>
            <h1 class="govuk-heading-l">
                Upload statement of conformity (SOC)
            </h1>
            <p class="govuk-body">
                Upload SOC for each element. You can
                <a href="@Model.TemplateDownloadUrl" class="govuk-link">download</a>
                the template to fill in and update later.
            </p>

            <form method="post" enctype="multipart/form-data">
                <div class="govuk-form-group">
                    <p class="govuk-hint" for="socFile">
                        Select your document
                    </p>
                    <input class="govuk-file-upload" id="socFile" name="socFile" type="file">
                </div>
                <div class="app-button-wrapper">
                    <a role="button" asp-controller="Assessor" asp-action="UploadSOC" data-module="govuk-button" draggable="false" class="govuk-button">Continue</a>
                </div>
            </form>
        </div>
    </div>
</div>
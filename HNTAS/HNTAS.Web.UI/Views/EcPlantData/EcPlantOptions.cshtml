@using HNTAS.Web.UI.Models.EcPlantData
@model EcPlantOptionsViewModel
@{
    ViewData["Title"] = "Tell us about your energy centre plant";
}
<div class="govuk-grid-row">
    <div class="govuk-grid-column-full">

        <form class="form" asp-action="EcPlantOptions" method="post" novalidate>

            <span class="govuk-caption-l">@ViewBag.HnId , @ViewBag.HnName</span>
            <h1 class="govuk-heading-l">Tell us about your energy centre plant</h1>
            <p class="govuk-body">
                Provide the number of energy centre generators and heat sources. At feasibility these can be best estimates. You'll be able to update these as your design develops.                
            </p>
            <p class="govuk-body">
                By providing this plant data, the service can give you an estimate of the carbon intensity of heat (g/kWh) that the energy centre will produce. This data gives you an opportunity to adjust the design and improve carbon emissions in subsequent stages.
            </p>

            <h2 class="govuk-heading-m">@ViewBag.SelectedElementName - @ViewBag.SelectedElementId</h2> 
            @{
                var hasNumberOfChpError = ViewData.ModelState[$"NumberOfChp"]?.Errors.Count > 0;
                var hasNumberOfHeatPumpError = ViewData.ModelState[$"NumberOfHeatPump"]?.Errors.Count > 0;
                var hasNumberOfHighHeatRecoverySourcesError = ViewData.ModelState[$"NumberOfHighHeatRecoverySources"]?.Errors.Count > 0;
                var hasNumberOfBoilerPlantsError = ViewData.ModelState[$"NumberOfBoilerPlants"]?.Errors.Count > 0;
                var showErrorBorder = false;
            }
            <div class="govuk-form-group">
                <label class="govuk-label" asp-for="@Model.NumberOfChp">
                    Number of combined heat and power systems
                </label>
                @if (hasNumberOfChpError)
                {
                    var errorMsg = ViewData.ModelState[$"NumberOfChp"]?.Errors.FirstOrDefault()?.ErrorMessage;
                    
                    if (errorMsg != "Provide at least one heat generator or heat source for your energy centre")
                    {
                        <p id="chp-numbers-error" class="govuk-error-message">
                            <span class="govuk-visually-hidden">Error:</span>
                            @Html.ValidationMessageFor(m => m.NumberOfChp)
                        </p>
                        showErrorBorder = true;
                    }                       
                     
                }
                <input class="govuk-input govuk-input--width-3 @(hasNumberOfChpError && showErrorBorder ? "govuk-input--error" : "")" id="numberofchp" asp-for="@Model.NumberOfChp" type="number" min="0" max="9999">
            </div>
  
            <div class="govuk-form-group">
                <label class="govuk-label" asp-for="@Model.NumberOfHeatPump">
                    Number of heat pump systems
                </label>
                @if (hasNumberOfHeatPumpError)
                {
                    <p id="heatpump-numbers-error" class="govuk-error-message">
                        <span class="govuk-visually-hidden">Error:</span>
                        @Html.ValidationMessageFor(m => m.NumberOfHeatPump)
                    </p>
                }
                <input class="govuk-input govuk-input--width-3 @(hasNumberOfHeatPumpError ? "govuk-input--error" : "")" id="numberofheatpump" asp-for="@Model.NumberOfHeatPump" type="number" min="0" max="9999">
            </div>

  
            <div class="govuk-form-group">
                <label class="govuk-label" asp-for="@Model.NumberOfHighHeatRecoverySources">
                    Number of high grade heat recovery sources
                </label>
                <div class="govuk-hint">
                    Waste and natural sources that do not require a heat pump
                </div>
                @if (hasNumberOfHighHeatRecoverySourcesError)
                {
                    <p id="high-heat-recovery-sources-error" class="govuk-error-message">
                        <span class="govuk-visually-hidden">Error:</span>
                        @Html.ValidationMessageFor(m => m.NumberOfHighHeatRecoverySources)
                    </p>
                }
                <input class="govuk-input govuk-input--width-3 @(hasNumberOfHighHeatRecoverySourcesError ? "govuk-input--error" : "")" id="numberofhighheatrecoverysources" asp-for="@Model.NumberOfHighHeatRecoverySources" type="number" min="0" max="9999">
            </div>

            <div class="govuk-form-group">
                <label class="govuk-label" asp-for="@Model.NumberOfBoilerPlants">
                    Number of boiler plants
                </label>
                @if (hasNumberOfBoilerPlantsError)
                {
                    <p id="boiler-plants-error" class="govuk-error-message">
                        <span class="govuk-visually-hidden">Error:</span>
                        @Html.ValidationMessageFor(m => m.NumberOfBoilerPlants)
                    </p>
                }
                <input class="govuk-input govuk-input--width-3 @(hasNumberOfBoilerPlantsError ? "govuk-input--error" : "")" id="numberofboilerplants" asp-for="@Model.NumberOfBoilerPlants" type="number" min="0" max="9999">

            </div>

            <button type="submit" class="govuk-button">
                Continue
            </button>

        </form>

    </div>
</div>

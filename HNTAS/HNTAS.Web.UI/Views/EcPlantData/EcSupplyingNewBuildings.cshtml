@using HNTAS.Api.Client.Model
@using HNTAS.Web.UI.Models.Common
@model List<Element>

@{
    ViewData["Title"] = "List of energy centres supplying new buildings";
}
<style>
    .govuk-button--as-link {
        background: none;
        border: none;
        padding: 0;
        margin: 0;
        color: #1d70b8;
        cursor: pointer;
        font: inherit;
        text-align: left;
        text-decoration: underline;
    }

        .govuk-button--as-link:hover {
            color: #003078;
        }

        .govuk-button--as-link:focus {
            background-color: #fd0 !important;
            box-shadow: 0 -2px #fd0, 0 4px #0b0c0c;
            outline: 3px solid transparent;
            text-decoration: none;
        }
</style>
<div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
        @{
            string? additionalDescription = ViewBag.HNAdditionalDescription as string;
        }
        <span class="govuk-caption-l">@ViewBag.HNId @ViewBag.HNName@(!string.IsNullOrEmpty(additionalDescription) ? ", " + additionalDescription.TruncateWithEllipsis() : "")</span>
        <h1 class="govuk-heading-l">
            List of energy centres supplying new buildings
        </h1>

        <ul class="govuk-task-list">
            @foreach (var element in Model)
            {
                var statusClass = "govuk-tag--blue";
                var skipSpan = false;
                if (element.EnergyCentrePlantData != null)
                {
                    switch (element.EnergyCentrePlantData!.EnergyCentreStatus.ToString())
                    {
                        case nameof(NullableOfNetworkDetailsStatus.ReadyToStart):
                            statusClass = "govuk-tag--blue";
                            break;                        
                        case nameof(NullableOfNetworkDetailsStatus.InProgress):
                        case nameof(NullableOfNetworkDetailsStatus.Incomplete):
                            statusClass = "govuk-tag--blue";
                            break;
                        case nameof(NullableOfNetworkDetailsStatus.Complete):
                            skipSpan = true;
                            statusClass = "";
                            break;
                        default:
                            statusClass = "govuk-tag--blue";
                            break;
                    }
                }

                var status = StatusConstants.ReadyToStart;
                if (element.EnergyCentrePlantData != null && element.EnergyCentrePlantData!.EnergyCentreStatus.ToString() == StatusConstants.Complete)
                {
                    status = StatusConstants.Completed;
                }

                <li class="govuk-task-list__item govuk-task-list__item--with-link">
                    <div class="govuk-task-list__name-and-hint">                        
                        <form asp-action="SelectEcPlantOptions" method="post" style="display:inline;">
                            <input type="hidden" name="elementId" value="@element.ElementId" />
                            <input type="hidden" name="elementName" value="@element.ElementName" />
                            <button type="submit" class="govuk-link govuk-task-list__link govuk-button--as-link" aria-describedby="@element.ElementId" style="background:none;border:0;padding:0;cursor:pointer;">
                                @element.ElementName - @element.ElementId
                            </button>
                        </form>
                    </div>
                    
                    @if (!skipSpan)
                    {
                        <div class="govuk-task-list__status" id="@element.ElementId">
                            <span class="govuk-tag @statusClass">
                                @status
                            </span>
                        </div>
                    }
                    else
                    {
                        <div class="govuk-task-list__status" id="@element.ElementId">
                            @status
                        </div>
                    }
                </li>
            }

        </ul>
        <button type="button" onclick="location.href='@Url.Action("NetworkDetails", "HeatNetwork")'" class="govuk-button" data-module="govuk-button">
                    Continue
        </button>
    </div>

</div>

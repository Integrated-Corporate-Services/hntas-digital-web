@using HNTAS.Api.Client.Model
@using HNTAS.Web.UI.Models.Common
@using HNTAS.Web.UI.Models.HeatNetwork
@model List<Element>

@{
    ViewData["Title"] = "Heat network details";
}
<div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
        <span class="govuk-caption-l">@ViewBag.HNId @ViewBag.HNName</span>
        <h1 class="govuk-heading-l">
            List of energy centres supplying new buildings
        </h1>

        <ul class="govuk-task-list">
            @foreach (var element in Model)
            {
                var statusClass = "";
                switch (element.EnergyCentreStatus.ToString())
                {
                    case StatusConstants.ReadyToStart:
                        statusClass = "govuk-tag--light-blue";
                        break;
                    case StatusConstants.CannotStartYet:
                    case StatusConstants.InProgress:
                    case StatusConstants.Incomplete:
                        statusClass = "govuk-tag--blue";
                        break;
                    case StatusConstants.Completed:
                        statusClass = "govuk-tag--green";
                        break;
                    default:
                        statusClass = "govuk-tag--grey";
                        break;
                }

                <li class="govuk-task-list__item govuk-task-list__item--with-link">
                    <div class="govuk-task-list__name-and-hint">                        
                        <a class="govuk-link govuk-task-list__link" href="@Url.Action("EcPlantOptions", "EcPlantData", new { elementId = element.ElementId, elementName = element.ElementName })" aria-describedby="@element.ElementId">
                            @element.ElementName - @element.ElementId
                        </a>                        
                    </div>
                    <div class="govuk-task-list__status" id="@element.ElementId">
                        <span class="govuk-tag @statusClass">
                            @element.EnergyCentreStatus
                        </span>
                    </div>
                </li>
            }

        </ul>
    </div>

</div>

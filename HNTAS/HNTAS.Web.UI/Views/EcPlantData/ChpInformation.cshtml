@using HNTAS.Web.UI.Models.EcPlantData
@model ChpInformationViewModel
@{
    ViewData["Title"] = "Provide the CHP information";
    var chpInformationListCount = Model.ChpInformationList?.Count ?? 0;
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
        <form class="form" asp-action="ChpInformation" method="post" novalidate>
            <span class="govuk-caption-l">@ViewBag.HnId , @ViewBag.HnName</span>
            <h1 class="govuk-heading-l">Provide the CHP information</h1>
            
            @for (int i = 0; i < chpInformationListCount; i++)
                {
                var hasNumberOfMaximumHeatOutputError = ViewData.ModelState[$"chpinformationlist[{i}].maximumheatoutput"]?.Errors.Count > 0;
                var hasNumberOfMaximumElectricOutputError = ViewData.ModelState[$"chpinformationlist[{i}].maximumelectricoutput"]?.Errors.Count > 0;
                var hasFuelOrHeatSourceError = ViewData.ModelState[$"chpinformationlist[{i}].fuelorheatsource"]?.Errors.Count > 0;
                var hasOperationalModeError = ViewData.ModelState[$"chpinformationlist[{i}].operationalmode"]?.Errors.Count > 0;

                var chpInfo = Model.ChpInformationList[i];
                <div class="govuk-!-margin-top-6">
                    <h2 class="govuk-heading-m">Combined heat and power system @(i + 1)</h2>
                    <div class="govuk-grid-row hntas-fields-row">
                        <div class="govuk-grid-column-one-quarter">
                            <div class="govuk-form-group">
                                <label class="govuk-label" asp-for="ChpInformationList[i].MaximumHeatOutput">
                                    Maximum heat output (kWth)
                                </label>
                                @if (hasNumberOfMaximumHeatOutputError)
                                {
                                    <p id="maximumheatoutput-error" class="govuk-error-message">
                                        <span class="govuk-visually-hidden">Error:</span>
                                        @Html.ValidationMessageFor(m => m.ChpInformationList[i].MaximumHeatOutput)
                                    </p>
                                }
                                <input class="govuk-input govuk-input--width-5 @(hasNumberOfMaximumHeatOutputError ? "govuk-input--error" : "")" id="@($"chpinformationlist[{i}].maximumheatoutput")" asp-for="ChpInformationList[i].MaximumHeatOutput" type="number">
                            </div>
                        </div>
                        <div class="govuk-grid-column-one-quarter">
                            <div class="govuk-form-group">
                                <label class="govuk-label" asp-for="ChpInformationList[i].MaximumElectricOutput">
                                    Maximum electric output (kWe)
                                </label>
                                @if (hasNumberOfMaximumElectricOutputError)
                                {
                                    <p id="maximumelectricoutput-error" class="govuk-error-message">
                                        <span class="govuk-visually-hidden">Error:</span>
                                        @Html.ValidationMessageFor(m => m.ChpInformationList[i].MaximumElectricOutput)
                                    </p>
                                }
                                <input class="govuk-input govuk-input--width-5 @(hasNumberOfMaximumElectricOutputError ? "govuk-input--error" : "")" id="@($"chpinformationlist[{i}].maximumelectricoutput")" asp-for="ChpInformationList[i].MaximumElectricOutput" type="number">
                            </div>
                        </div>

                        <div class="govuk-grid-column-one-quarter">
                            <div class="govuk-form-group">
                                <label class="govuk-label" asp-for="ChpInformationList[i].FuelOrHeatSource">
                                    Fuel or heat source
                                </label>
                                @if (hasFuelOrHeatSourceError)
                                {
                                    <p id="fuelorheatsource-error" class="govuk-error-message">
                                        <span class="govuk-visually-hidden">Error:</span>
                                        @Html.ValidationMessageFor(m => m.ChpInformationList[i].FuelOrHeatSource)
                                    </p>
                                }
                                <select class="govuk-select @(hasFuelOrHeatSourceError ? "govuk-select--error" : "")" id="@($"chpinformationlist[{i}].fuelorheatsource")" asp-for="ChpInformationList[i].FuelOrHeatSource">
                                    <option value="" selected="">Select a source</option>
                                    @foreach (var fuelType in ViewBag.FuelTypes!)
                                    {
                                        <option value="@fuelType.FuelId">@fuelType.Type</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="govuk-grid-column-one-quarter">
                            <div class="govuk-form-group">
                                <label class="govuk-label" asp-for="ChpInformationList[i].OperationalMode">
                                    Operational mode
                                </label>
                                @if (hasOperationalModeError)
                                {
                                    <p id="operationalmode-error" class="govuk-error-message">
                                        <span class="govuk-visually-hidden">Error:</span>
                                        @Html.ValidationMessageFor(m => m.ChpInformationList[i].OperationalMode)
                                    </p>
                                }
                                <select class="govuk-select @(hasOperationalModeError ? "govuk-select--error" : "")" id="@($"chpinformationlist[{i}].operationalmode")" asp-for="ChpInformationList[i].OperationalMode">
                                    <option value="" selected="">Select a mode</option>
                                    @foreach (var operationalMode in ViewBag.OperationalModes)
                                    {
                                        <option value="@operationalMode.Ident">@operationalMode.OperationalMode</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                @if (chpInformationListCount > 1 && i < chpInformationListCount - 1)
                {
                    <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible">
                }
            }   
            
            <div class="govuk-!-margin-top-6">  
                <button type="submit" class="govuk-button" data-module="govuk-button" data-govuk-button-init="">
                    Continue
                </button>
            </div>
        </form>
    </div>
</div>
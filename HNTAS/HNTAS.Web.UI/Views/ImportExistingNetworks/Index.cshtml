@using HNTAS.Api.Client.Model
@model ImportResult

@{
    ViewData["Title"] = "Existing Networks Import";
}

<div class="govuk-width-container">
    <h1 class="govuk-heading-l">Existing Networks Import</h1>

    <form asp-action="Index" method="post" enctype="multipart/form-data">
        <div class="govuk-form-group">
            <label class="govuk-label" for="csvFile">Upload the CSV file</label>
            <input class="govuk-file-upload" id="csvFile" name="csvFile" type="file" accept=".csv">
        </div>
        <button type="submit" class="govuk-button">Upload and preview</button>
    </form>

    <hr class="govuk-section-break govuk-section-break--l govuk-section-break--visible">

    @if (ViewBag.DisplayResult == true)
    {
        <h2 class="govuk-heading-m">Outcome</h2>

        <table class="govuk-table">
            <thead class="govuk-table__head">
                <tr class="govuk-table__row">
                    
                        <th scope="col" class="govuk-table__header">Row processed</th>
                        <th scope="col" class="govuk-table__header">Networks added</th>
                </tr>
            </thead>
            <tbody class="govuk-table__body">
                
                    <tr class="govuk-table__row">
                        
                            <td class="govuk-table__cell">@Model.RowsProcessed</td>
                            <td class="govuk-table__cell">@Model.HeatNetworksInserted</td>
                    </tr>
                
            </tbody>
        </table>
    }

</div>
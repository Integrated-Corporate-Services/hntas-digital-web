@{
    ViewData["title"] = "Check if the new regulations apply to your heat network";
}

<style>
    .govuk-blue-bar {
        background-color: #1d70b8;
        height: 8px;
        margin-bottom: 20px;
    }
</style>


<div class="govuk-width-container">
    <main class="govuk-main-wrapper" id="main-content" role="main">
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-two-thirds">
                <h1 class="govuk-heading-l govuk-!-margin-bottom-4">
                    Check if the new regulations apply to your heat network
                </h1>

                <p class="govuk-body">
                    If you're running an existing heat network or creating a new one, use this tool to check if you need to comply with new regulations from:
                </p>
                <ul class="govuk-list govuk-list--bullet">
                    <li>Heat Network Technical Assurance Scheme (HNTAS)</li>
                </ul>

                <a asp-controller="DutyHolder" asp-action="UserLogin" role="button" draggable="false" class="govuk-button govuk-button--start govuk-!-margin-bottom-6" data-module="govuk-button">
                    Start now
                    <svg class="govuk-button__start-icon" xmlns="http://www.w3.org/2000/svg" width="17.5" height="19" viewBox="0 0 33 40" aria-hidden="true" focusable="false">
                        <path fill="currentColor" d="M0 0h13l20 20-20 20H0l20-20z" />
                    </svg>
                </a>

                <h2 class="govuk-heading-m govuk-!-margin-bottom-2">Before you start</h2>
                <p class="govuk-body">You'll be asked about your heat network's:</p>
                <ul class="govuk-list govuk-list--bullet">
                    <li>type</li>
                    <li>current state of development</li>
                    <li>number of dwellings served</li>
                    <li>thermal capacity in kW (if known)</li>
                </ul>

                <p class="govuk-body govuk-!-margin-top-6">
                    The online service is also available in Welsh (ar gael yn Gymraeg).
                </p>
            </div>
            <div class="govuk-grid-column-one-third">
                <aside class="govuk-related-items">
                    <hr class="govuk-blue-bar"/>
                    <h2 class="govuk-heading-m">Related content</h2>
                    <ul class="govuk-list govuk-list--bullet">
                        <li><a class="govuk-link" href="#">Link 1</a></li>
                    </ul>
                </aside>
            </div>
        </div>
    </main>
</div>
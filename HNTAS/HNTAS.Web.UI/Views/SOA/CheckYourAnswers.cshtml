@using HNTAS.Web.UI.Models.Soa
@model SOAReviewSummaryViewModel

@{
    ViewData["Title"] = "Check your answers before submitting";
}

<div class="govuk-width-container">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-full">
            <div class="govuk-grid-row">
                <div class="govuk-grid-column-two-thirds">

                    <h1 class="govuk-heading-l">
                        Check your answers before submitting
                    </h1>

                    <h2 class="govuk-heading-m">
                        Phase @Model.Phase overall Statement of applicability (SOA)
                    </h2>

                    <dl class="govuk-summary-list">
                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key">
                                Element list
                            </dt>
                            @foreach (var element in Model.Elements)
                            {
                                <dd class="govuk-summary-list__value">
                                    @($"{element.Name} ({element.Count})")
                                    <br />                                    
                                </dd>
                                <dd class="govuk-summary-list__actions">
                                    <a class="govuk-link" href="/change-elements">
                                        Change<span class="govuk-visually-hidden"> @($"{element.Name} ({element.Count})")</span>
                                    </a>
                                </dd>
                            }
                        </div>
                    </dl>

                    <h2 class="govuk-heading-m">
                        Stage 1 SOA documents
                    </h2>

                    <dl class="govuk-summary-list">
                        @foreach (var eleDoc in Model.ElementDocuments)
                        {
                            <div class="govuk-summary-list__row">
                                <dt class="govuk-summary-list__key">
                                    @eleDoc.Name
                                </dt>
                                @foreach (var doc in eleDoc.Documents)
                                {
                                    <dd class="govuk-summary-list__value">                                        
                                        @($"[{doc.FileName}]")
                                        <br />                                        
                                    </dd>
                                    <dd class="govuk-summary-list__actions">
                                        <a class="govuk-link" href="#">
                                            Change<span class="govuk-visually-hidden"> @($"[{doc.FileName}]")</span>
                                        </a>
                                    </dd>
                                }                                
                            </div>
                        }
                    </dl>

                    <h2 class="govuk-heading-m">
                        Assessment plan
                    </h2>

                    <dl class="govuk-summary-list">
                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key">
                                @Model.AssessmentPlanDocument.Name
                            </dt>
                            <dd class="govuk-summary-list__value">
                                @($"[{Model.AssessmentPlanDocument.Documents.FirstOrDefault().FileName}]")
                            </dd>
                            <dd class="govuk-summary-list__actions">
                                <a class="govuk-link" href="#">
                                    Change<span class="govuk-visually-hidden"> @($"[{Model.AssessmentPlanDocument.Documents.FirstOrDefault().FileName}]")</span>
                                </a>
                            </dd>
                        </div>
                    </dl>

                    <form asp-action="SubmitSOA" method="post">
                        <button type="submit" class="govuk-button" data-module="govuk-button">
                            Continue
                        </button>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

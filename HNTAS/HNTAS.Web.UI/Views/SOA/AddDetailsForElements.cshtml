@{
    ViewData["Title"] = "Initial SOA - add details for selected elements";
}

<div class="govuk-width-container">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">

            <span class="govuk-caption-xl">SOA selection</span>
            <h1 class="govuk-heading-xl">
                Initial SOA - add details for selected elements
            </h1>

            <div class="govuk-inset-text">
                <p>You may need to provide these details for the selected elements</p>
                <ul class="govuk-list govuk-list--bullet">
                    <li>location of energy centres</li>
                    <li>location of distribution network</li>
                    <li>number of sub station with their location</li>
                    <li>consumer connection details</li>
                    <li>consumer heat system details</li>
                </ul>
                <a href="@Url.Action("ElementList")" role="button" draggable="false" class="govuk-button" data-module="govuk-button">
                    Continue
                </a>
            </div>

            <h2 class="govuk-heading-m">Your selected elements</h2>

            <div class="govuk-!-margin-bottom-6">
                <span class="govuk-hint">List of elements</span>
                <a class="govuk-link" href="#">Update</a>
            </div>

            <dl class="govuk-summary-list">
                <div class="govuk-summary-list__row">
                    <dt class="govuk-summary-list__key">
                        Element 1
                    </dt>
                    <dd class="govuk-summary-list__value">
                        Energy Centre (2)
                    </dd>
                </div>
                <div class="govuk-summary-list__row">
                    <dt class="govuk-summary-list__key">
                        Element 2
                    </dt>
                    <dd class="govuk-summary-list__value">
                        Thermal sub station (2)
                    </dd>
                </div>
                <div class="govuk-summary-list__row">
                    <dt class="govuk-summary-list__key">
                        Element 3
                    </dt>
                    <dd class="govuk-summary-list__value">
                        Communal distribution network (1)
                    </dd>
                </div>
                <div class="govuk-summary-list__row">
                    <dt class="govuk-summary-list__key">
                        Element 4
                    </dt>
                    <dd class="govuk-summary-list__value">
                        Consumer connections (10)
                    </dd>
                </div>
            </dl>

        </div>

        <div class="govuk-grid-column-one-third">
            <div class="app-related-items">
                <h2 class="govuk-heading-m">
                    Part of
                </h2>
                <nav role="navigation" aria-labelledby="related-content-section">
                    <ul class="govuk-list govuk-!-font-size-16">
                        <li>
                            <a class="govuk-link" href="#">Define overall SOA</a>
                        </li>
                    </ul>
                </nav>
            </div>
            <div class="govuk-accordion" data-module="govuk-accordion" id="accordion-with-summary">
                <div class="govuk-accordion__section govuk-accordion__section--expanded">
                    <div class="govuk-accordion__section-header">
                        <h2 class="govuk-accordion__section-heading">
                            <span class="govuk-accordion__section-button" id="accordion-with-summary-heading-1">
                                <span class="govuk-accordion-nav__label">1</span>
                                Choose your elements
                            </span>
                        </h2>
                    </div>
                    <div id="accordion-with-summary-content-1" class="govuk-accordion__section-content" aria-labelledby="accordion-with-summary-heading-1">
                        <p class="govuk-body">
                            You need to choose the elements from the list of 6 elements applicable for your heat network
                        </p>
                        <p class="govuk-body">
                            <a class="govuk-link" href="#">Select your elements</a>
                        </p>
                    </div>
                </div>
                <div class="govuk-accordion__section govuk-accordion__section--expanded">
                    <div class="govuk-accordion__section-header">
                        <h2 class="govuk-accordion__section-heading">
                            <span class="govuk-accordion__section-button" id="accordion-with-summary-heading-2">
                                <span class="govuk-accordion-nav__label">2</span>
                                Initial SOA
                            </span>
                        </h2>
                    </div>
                    <div id="accordion-with-summary-content-2" class="govuk-accordion__section-content" aria-labelledby="accordion-with-summary-heading-2">
                        <p class="govuk-body">
                            Share details on the selected elements for your heat network
                        </p>
                        <p class="govuk-body">
                            <a class="govuk-link" href="#">Element details</a>
                        </p>
                    </div>
                </div>
                <div class="govuk-accordion__section ">
                    <div class="govuk-accordion__section-header">
                        <h2 class="govuk-accordion__section-heading">
                            <span class="govuk-accordion__section-button" id="accordion-with-summary-heading-3">
                                <span class="govuk-accordion-nav__label">3</span>
                                Define SOA
                            </span>
                        </h2>
                    </div>
                    <div id="accordion-with-summary-content-3" class="govuk-accordion__section-content" aria-labelledby="accordion-with-summary-heading-3">
                        <p class="govuk-body">
                            This is the content for writing well for the web.
                        </p>
                        <p class="govuk-body">
                            <a class="govuk-link" href="#">Define SOA</a>
                        </p>
                    </div>
                </div>
                <div class="govuk-accordion__section ">
                    <div class="govuk-accordion__section-header">
                        <h2 class="govuk-accordion__section-heading">
                            <span class="govuk-accordion__section-button" id="accordion-with-summary-heading-4">
                                <span class="govuk-accordion-nav__label">4</span>
                                Add assessment plan
                            </span>
                        </h2>
                    </div>
                    <div id="accordion-with-summary-content-4" class="govuk-accordion__section-content" aria-labelledby="accordion-with-summary-heading-4">
                        <p class="govuk-body">
                            [Content for Add assessment plan]
                        </p>
                    </div>
                </div>
                <div class="govuk-accordion__section ">
                    <div class="govuk-accordion__section-header">
                        <h2 class="govuk-accordion__section-heading">
                            <span class="govuk-accordion__section-button" id="accordion-with-summary-heading-5">
                                <span class="govuk-accordion-nav__label">5</span>
                                Submit your SOA
                            </span>
                        </h2>
                    </div>
                    <div id="accordion-with-summary-content-5" class="govuk-accordion__section-content" aria-labelledby="accordion-with-summary-heading-5">
                        <p class="govuk-body">
                            [Content for Submit your SOA]
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

        <div class="govuk-panel govuk-panel--confirmation">
            <h1 class="govuk-panel__title">
                Statement of Applicability (SOA) has been sent
            </h1>
        </div>

        <p class="govuk-body">
            You've sent the SOA for the following
        </p>

        @if (ViewBag.ElementList != null)
        {
            <ul class="govuk-list govuk-list--bullet">
                @foreach (var item in ViewBag.ElementList)
                {
                    <li>@item.Name</li>
                }
            </ul>
        }



        <p class="govuk-body">
            Return to the <a href="@Url.Action("Details", "HeatNetwork", new { hnid = ViewBag.HnId })" class="govuk-link">heat network overview</a> or back to <a href="@Url.Action("UserAccount", "Dashboard")" class="govuk-link">your account</a>.
        </p>

    </div>
</div>

@using HNTAS.Web.UI.Models.Soa
@model ElementListViewModel

@{
    ViewData["Title"] = "List of elements";
}

<div class="govuk-width-container">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <div class="dashboard-card">
                <h3 class="dashboard-card__title govuk-heading-s">
                    <a href="@Url.Action("DefineSOA")" class="govuk-link govuk-link--no-visited-state">Part of define your overall SOA</a>
                </h3>
                <p class="govuk-body-s">Choose your elements</p>
            </div>
        </div>
    </div>
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">

            <span class="govuk-caption-xl">@Model.HeatNetworkName</span>
            <h1 class="govuk-heading-xl">
                List of element
            </h1>

            <table class="govuk-table">
                <tbody class="govuk-table__body">
                    <tr class="govuk-table__row">
                        <th scope="row" class="govuk-table__header">
                            <a href="@Url.Action("EnergyCentre")" class="govuk-link">Energy centre (@Model.EnergyCentreCount)</a>
                        </th>
                        <td class="govuk-table__cell govuk-table__cell--no-border govuk-!-text-align-right">
                            <strong class="govuk-tag govuk-tag--blue">Not yet started</strong>
                        </td>
                    </tr>
                    <tr class="govuk-table__row">
                        <th scope="row" class="govuk-table__header">
                            <a href="@Url.Action("ThermalSubstation")" class="govuk-link">Thermal sub station (@Model.ThermalSubStationCount)</a>
                        </th>
                        <td class="govuk-table__cell govuk-table__cell--no-border govuk-!-text-align-right">
                            <strong class="govuk-tag govuk-tag--grey">Cannot start yet</strong>
                        </td>
                    </tr>
                    <tr class="govuk-table__row">
                        <th scope="row" class="govuk-table__header">
                            Communal distribution network (@Model.CommunalDistributionNetworkCount)
                        </th>
                        <td class="govuk-table__cell govuk-table__cell--no-border govuk-!-text-align-right">
                            <strong class="govuk-tag govuk-tag--grey">Cannot start yet</strong>
                        </td>
                    </tr>
                    <tr class="govuk-table__row">
                        <th scope="row" class="govuk-table__header">
                            Consumer connections (@Model.ConsumerConnectionsCount)
                        </th>
                        <td class="govuk-table__cell govuk-table__cell--no-border govuk-!-text-align-right">
                            <strong class="govuk-tag govuk-tag--grey">Cannot start yet</strong>
                        </td>
                    </tr>
                </tbody>
            </table>

            <form asp-action="DefineSoa" method="post">
                <button type="submit" class="govuk-button" data-module="govuk-button">
                    Continue
                </button>
            </form>
        </div>
    </div>
</div>
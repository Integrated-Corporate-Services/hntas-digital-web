@using HNTAS.Web.UI.Models.Soa
@model UploadAssessmentPlanViewModel
@{
    ViewData["Title"] = "Add assessment plan to statement of applicability (SOA)";
}


<div class="govuk-width-container">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <div class="dashboard-card">
                <h3 class="dashboard-card__title govuk-heading-s">
                    <a href="@Url.Action("DefineSOA")" class="govuk-link govuk-link--no-visited-state">Part of define your overall SOA</a>
                </h3>
                <p class="govuk-body-s">Choose your elements</p>
            </div>
        </div>
    </div>
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <span class="govuk-caption-l">@Model.HeatNetworkName</span>
            <h1 class="govuk-heading-m">@ViewData["Title"] </h1>

            <p class="govuk-body">
                Upload your assessment plan for <strong>phase @Model.PhaseNumber</strong>. You can
                <a href="@Model.TemplateDownloadUrl" class="govuk-link">download</a> the template to fill in and update later.
            </p>

            <form asp-action="UploadAssessmentPlan" method="post" enctype="multipart/form-data" class="govuk-form-group">
                @Html.AntiForgeryToken()
                <div class="govuk-form-group">
@*                     <label class="govuk-label" for="assessmentPlan">
                        Choose file
                    </label> *@
                    <input class="govuk-file-upload" id="assessmentPlan" name="assessmentPlan" type="file">
                </div>
                <br />
                <button type="submit" class="govuk-button" data-module="govuk-button">
                    Continue
                </button>
            </form>


        </div>
    </div>
</div>



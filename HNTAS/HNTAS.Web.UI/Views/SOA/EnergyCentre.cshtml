@using HNTAS.Web.UI.Models.Soa
@model EnergyCentreViewModel

@{
    ViewData["Title"] = "Energy centre";
}

<div class="govuk-width-container">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">

            <span class="govuk-caption-l">List of elements</span>
            <h1 class="govuk-heading-l">
                Energy centre
            </h1>

            <form method="post">
                <div class="govuk-form-group">
                    <h2 class="govuk-heading-m">Primary energy centre location 1</h2>
                    <p class="govuk-body">
                        Enter the 3 words that represent your heat network's primary energy centre location. You can find this using <a href="https://what3words.com/" class="govuk-link" target="_blank" rel="noopener noreferrer">what3words</a> (opens in a new tab).
                    </p>
                    <label class="govuk-label" for="primary-location">
                        Enter your 3 words here
                    </label>
                    <input class="govuk-input govuk-!-width-one-half" id="primary-location" name="PrimaryEnergyCentreLocation" type="text" value="@Model.PrimaryEnergyCentreLocation">
                </div>

                <div class="govuk-form-group">
                    <h2 class="govuk-heading-m">Additional energy centre location 2</h2>
                    <p class="govuk-body">
                        Enter the 3 words that represent your heat network's primary energy centre location. You can find this using <a href="https://what3words.com/" class="govuk-link" target="_blank" rel="noopener noreferrer">what3words</a> (opens in a new tab).
                    </p>
                    <label class="govuk-label" for="additional-location">
                        Enter your 3 words here
                    </label>
                    <input class="govuk-input govuk-!-width-one-half" id="additional-location" name="AdditionalEnergyCentreLocation" type="text">
                </div>

                <button type="submit" class="govuk-button" data-module="govuk-button">
                    Continue
                </button>
            </form>

        </div>
    </div>
</div>
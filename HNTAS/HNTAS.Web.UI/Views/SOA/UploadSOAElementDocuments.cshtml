@using HNTAS.Web.UI.Models.Soa
@model UploadSOAElementDocumentsViewModel

@{
    ViewData["Title"] = Model.PageTitle;
}

<div class="govuk-width-container">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-full">
            <span class="govuk-caption-l">@Model.ProjectName</span>
            <h1 class="govuk-heading-l">@Model.PageTitle</h1>

            <h2 class="govuk-heading-l">@Model.ElementName</h2>

            <p class="govuk-body">
                @Model.ElementDescription
                You can <a class="govuk-link" href="#">download</a> the template to fill in and update later.
            </p>

            <form asp-action="SaveUploadedSOAElementDocuments" method="post" enctype="multipart/form-data">
                <input type="hidden" name="ElementName" value="@Model.ElementName" />

                @if (Model.Documents != null && Model.Documents.Any())
                {
                    @foreach (var doc in Model.Documents)
                    {
                        <h3 class="govuk-heading-m">@doc.Name</h3>
                        
                        <div class="govuk-form-group">
                            <label class="govuk-label" for="@doc.FileInputId">
                                Upload your SOA document @(doc.IsRequired ? "(required)" : "")
                            </label>
                            <input class="govuk-file-upload" id="@doc.FileInputId" name="@doc.FileInputId" type="file">
                        </div>
                    }
                }
                
                <button type="submit" class="govuk-button" data-module="govuk-button">
                    Continue
                </button>
            </form>

        </div>
    </div>
</div>
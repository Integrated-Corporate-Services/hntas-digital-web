@using HNTAS.Web.UI.Models.Components
@using HNTAS.Web.UI.Models.Soa
@model HeatNetworkTypeViewModel

@{
    ViewData["Title"] = "What is your heat network type?";
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <form asp-controller="SOA" asp-action="SubmitHeatNetworkType" method="post" novalidate>
            @Html.AntiForgeryToken()
            <span class="govuk-caption-xl">Statement of applicability (SOA)</span>
            <div class="govuk-form-group @(Html.HasError(nameof(Model.SelectedHNType)) ? "govuk-form-group--error" : "")">
                <fieldset class="govuk-fieldset"
                          aria-describedby="@(Html.HasError(nameof(Model.SelectedHNType)) ? "heat-network-type-error" : "")">
                    <legend class="govuk-fieldset__legend govuk-fieldset__legend--l">
                        <h1 class="govuk-fieldset__heading">
                            What is your heat network type?
                        </h1>
                    </legend>

                    @if (Html.HasError(nameof(Model.SelectedHNType)))
                    {
                        <p id="heat-network-type-error" class="govuk-error-message">
                            <span class="govuk-visually-hidden">Error:</span> @Html.ValidationMessageFor(m => m.SelectedHNType)
                        </p>
                    }

                    @await Html.PartialAsync("Components/_GovUkRadioList", new GovUkRadioListModel
                    {
                        FieldId = Html.LowercaseIdFor(m => m.SelectedHNType),
                        FieldName = nameof(Model.SelectedHNType),
                        SelectedValue = Model.SelectedHNType?.ToString(),
                        Items = Model.HeatNetworkTypes
                    })

                    <div id="other-network-description-group" class="govuk-radios__conditional govuk-radios__conditional--hidden">
                        <div class="govuk-form-group">
                            <label class="govuk-label govuk-body-s" for="otherText">
                                Type of network
                            </label>
                            <input class="govuk-input" id="OtherNetworkDescription" name="OtherNetworkDescription" type="text" placeholder="Free text" value="@Model.OtherNetworkDescription">
                        </div>
                    </div>
                </fieldset>
            </div>

            <button type="submit" class="govuk-button" data-module="govuk-button">
                Continue
            </button>
        </form>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const radios = document.querySelectorAll("input[name='SelectedHNType']");
        const otherGroup = document.getElementById("other-network-description-group");

        function toggleOtherField() {
            const selected = document.querySelector("input[name='SelectedHNType']:checked");
            if (!otherGroup) return; // Defensive check

            if (selected && selected.value === "Other") {
                otherGroup.style.display = "block";
            } else {
                otherGroup.style.display = "none";
            }
        }

        radios.forEach(radio => {
            radio.addEventListener("change", toggleOtherField);
        });

        toggleOtherField(); // Initial state
    });
</script>


@using HNTAS.Web.UI.Models.Soa
@model SubmitAssessmentPlanViewModel
@{
    ViewData["Title"] = "Submit your statement of applicability (SOA)";
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

        <span class="govuk-caption-l">Define overall SOA</span>
        <h1 class="govuk-heading-l">
            Submit your statement of applicability (SOA)
        </h1>

        <p class="govuk-body">
            As a next step you need to submit your statement of applicability (SOA) for phase @Model.PhaseNumber
        </p>

        <dl class="govuk-summary-list">
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">
                    Assessment plan
                </dt>
                <dd class="govuk-summary-list__value">
                    [@Model.DocumentName]
                </dd>
            </div>
        </dl>

        <a href="@Url.Action("CheckYourAnswers", new { phaseIndex = 0 })" role="button" draggable="false" class="govuk-button" data-module="govuk-button">
            Continue
        </a>

    </div>

    <div class="govuk-grid-column-one-third">
        <div class="app-related-items">
            <h2 class="govuk-heading-m">
                Part of
            </h2>
            <nav role="navigation" aria-labelledby="related-content-section">
                <ul class="govuk-list govuk-!-font-size-16">
                    <li>
                        <a class="govuk-link" href="#">Define overall SOA</a>
                    </li>
                </ul>
            </nav>
        </div>
        @await Html.PartialAsync("Soa/_StepByStepGuide", Model.Steps)
    </div>

</div>
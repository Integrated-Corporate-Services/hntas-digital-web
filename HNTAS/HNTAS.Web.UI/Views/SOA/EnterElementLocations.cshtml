@using HNTAS.Web.UI.Models.Soa
@model EnterElementLocationsViewModel

@{
    ViewData["Title"] = Model.ElementName;
}

<div class="govuk-width-container">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">

            <span class="govuk-caption-l">List of elements</span>
            <h1 class="govuk-heading-l">@Model.ElementName</h1>

            <form asp-controller="SOA" asp-action="SaveEnterElementLocations" method="post" novalidate>
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.ElementName)
                @for (int i = 0; i < Model.Locations.Count; i++)
                {
                    var fieldId = $"location-{i}";
                    var fieldName = $"Locations[{i}]";
                    var label = $"{Model.ElementName} location {i + 1}";
                    var value = Model.Locations[i];

                    <div class="govuk-form-group">
                        <h2 class="govuk-heading-m">@label</h2>
                        <p class="govuk-body">
                            Enter the 3 words that represent this your heat network's primary energy location. You can find this using
                            <a href="https://what3words.com/" class="govuk-link" target="_blank" rel="noopener noreferrer">what 3 words</a> (opens in a new tab).
                        </p>
                        <label class="govuk-label" for="@fieldId">Enter your 3 words here</label>
                        <input class="govuk-input govuk-!-width-one-half" id="@fieldId" name="@fieldName" type="text" value="@value" />
                    </div>
                }

                <button type="submit" class="govuk-button" data-module="govuk-button">
                    Continue
                </button>
            </form>

        </div>
    </div>
</div>

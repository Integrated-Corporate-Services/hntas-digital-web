@using HNTAS.Web.UI.Models.Soa
@model InitialSoaViewModel
@{
    ViewData["Title"] = "Initial SOA - add details for selected elements";
}

<div class="govuk-width-container">
   
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <span class="govuk-caption-l">SOA selection</span>
            <h1 class="govuk-heading-l">
                Initial SOA - add details for selected elements
            </h1>

            <p class="govuk-body">You may need to provide these details for the selected elements:</p>
            <ul class="govuk-list govuk-list--bullet">
                <li>location of energy centres</li>
                <li>location of distribution network</li>
                <li>number of sub station with their location</li>
                <li>consumer connection details</li>
                <li>consumer heat system details</li>
            </ul>

            <a href="@Url.Action("ElementList")" role="button" draggable="false" class="govuk-button" data-module="govuk-button">
                Continue
            </a>
          

            <div class="govuk-summary-card">
                <div class="govuk-summary-card__title-wrapper">
                    <h2 class="govuk-summary-card__title">
                        List of elements
                    </h2>
                    <ul class="govuk-summary-card__actions">
                        <li class="govuk-summary-card__action">
                            <a class="govuk-link" href="@Url.Action("SelectElements")">Update<span class="govuk-visually-hidden"></span></a>
                        </li>
                    </ul>
                </div>
                <div class="govuk-summary-card__content">
                    <dl class="govuk-summary-list">
                        @if (Model.SelectedElements != null)
                        {
                            for (int i = 0; i < Model.SelectedElements.Count; i++)
                            {
                                var element = Model.SelectedElements[i];
                                <div class="govuk-summary-list__row">
                                    <dt class="govuk-summary-list__key">
                                        Element @(i + 1)
                                    </dt>
                                    <dd class="govuk-summary-list__value">
                                        @element.Name (@element.Count)
                                    </dd>
                                </div>
                            }
                        }
                    </dl>
                </div>
            </div>

        </div>

        <div class="govuk-grid-column-one-third">
            <div class="app-related-items">
                <h2 class="govuk-heading-m">
                    Part of
                </h2>
                <nav role="navigation" aria-labelledby="related-content-section">
                    <ul class="govuk-list govuk-!-font-size-16">
                        <li>
                            <a class="govuk-link" href="#">Define overall SOA</a>
                        </li>
                    </ul>
                </nav>
            </div>
            @await Html.PartialAsync("Soa/_StepByStepGuide", Model.Steps)
        </div>
    </div>
</div>
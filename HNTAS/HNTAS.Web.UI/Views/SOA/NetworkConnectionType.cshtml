@using HNTAS.Web.UI.Models.Components
@using HNTAS.Web.UI.Models.Soa
@model NetworkConnectionTypeViewModel
@{
    ViewData["Title"] = "What connection types does your network have?";
    var fieldId = Html.LowercaseIdFor(m => m.SelectedConnections);
}

<div class="govuk-width-container">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">

            <span class="govuk-caption-l">Statement of applicability (SOA)</span>

            <form asp-action="SubmitNetworkConnectionType" method="post">

                <div class="govuk-form-group @(Html.HasError(nameof(Model.SelectedConnections)) ? "govuk-form-group--error" : "")">
                    <fieldset class="govuk-fieldset" aria-describedby="nationality-hint nationality-error">
                        <legend class="govuk-fieldset__legend govuk-fieldset__legend--l">
                            <h1 class="govuk-fieldset__heading">
                                What connection types does your network have?
                            </h1>
                        </legend>
                        <div id="@fieldId-hint" class="govuk-hint">
                            Select all that apply
                        </div>

                        @if (Html.HasError(nameof(Model.SelectedConnections)))
                        {
                            <p id="@fieldId-error" class="govuk-error-message">
                                <span class="govuk-visually-hidden">Error:</span> @Html.ValidationMessageFor(m => m.SelectedConnections)
                            </p>
                        }

                        @await Html.PartialAsync("Components/_GovUkCheckboxList", new GovUkCheckboxListModel
                        {
                            FieldId = Html.LowercaseIdFor(m => m.SelectedConnections),
                            FieldName = nameof(Model.SelectedConnections),
                            Items = Model.ConnectionTypes
                        })
                    </fieldset>
                </div>
                <button type="submit" class="govuk-button" data-module="govuk-button">
                    Continue
                </button>
            </form>
        </div>
        
    </div>
</div>
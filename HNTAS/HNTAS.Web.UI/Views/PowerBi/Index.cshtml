@{
    ViewBag.Title = "Power BI Report";
}
<style>
    /* Remove only the narrow content restriction */ .container,
    .container-fluid,
    .body-content,
    main {
        max-width: none !important;
    }

    #powerBiWrapper {
        width: 100vw;
        margin-left: calc(50% - 50vw);
        padding: 0;
        overflow: hidden;
        background: white;
    }

    #powerBiFrame {
        display: block;
        width: 100%;
        height: 100%;
        margin: 0;
        padding: 0;
        border: 0;
    }
</style>

@{
    var orgId = ViewBag.OrgId as string;
    var isSuperUser = ViewBag.IsSuperUser as bool?;
    var powerBiUrl = string.Empty;

    if (isSuperUser == true)
    {
        powerBiUrl =
           $"https://app.powerbi.com/reportEmbed?reportId=e8a86f10-23c4-4238-969e-46229daa7ecc" +
           $"&autoAuth=true" +
           $"&ctid=cbac7005-02c1-43eb-b497-e6492d1b2dd8";
    }
    else
    {
        powerBiUrl =
        $"https://app.powerbi.com/reportEmbed?reportId=e8a86f10-23c4-4238-969e-46229daa7ecc" +
        $"&autoAuth=true" +
        $"&ctid=cbac7005-02c1-43eb-b497-e6492d1b2dd8" +
        $"&filter=KPI_Data1/org_id eq '{orgId}'";
    }
}

<div id="powerBiWrapper">
    <iframe id="powerBiFrame" title="HNTAS POC"
            src="@powerBiUrl"
            allowfullscreen="true"></iframe>
</div>
<script>
    function resizePowerBiReport() {
            const wrapper = document.getElementById("powerBiWrapper");
            if (!wrapper) {
                return;
            }
            /*
               Calculates the available screen height beneath the website
               header/navigation instead of covering it.
            */const wrapperTop = wrapper.getBoundingClientRect().top;
            const availableHeight = window.innerHeight - wrapperTop;
            wrapper.style.height =
                Math.max(availableHeight, 1000) + "px";
        }
        window.addEventListener("load", resizePowerBiReport);
        window.addEventListener("resize", resizePowerBiReport);</script>
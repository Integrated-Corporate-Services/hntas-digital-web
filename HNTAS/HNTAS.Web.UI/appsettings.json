{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "OneLogin": {
    "ClientId": "${ONELOGIN_CLIENT_ID}",
    "PrivateKey": "${ONELOGIN_PRIVATE_KEY}",
    "VectorsOfTrust": "Cl.Cm"
  },
  "OrdnanceSurvey": {
    "ApiKey": "${OS_API_KEY}"
  },
  "ApiClients": {
    "CoreApiBaseUrl": "core url"
  },
  "CompaniesHouse": {
    "BaseUrl": "https://api-sandbox.company-information.service.gov.uk"
  },
  "AWS": {
    "UseLocalStack": false
  },
  "CacheSettings": {
    "RoleCacheDurationMinutes": 30
  }  
}

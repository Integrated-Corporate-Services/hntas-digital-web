{
  "Logging": {
    "Region": "eu-west-2",
    "LogGroup": "HNTAS-Core-Api-Logs",
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System": "Warning"
    }
  },
  "AllowedHosts": "*",
  "OneLogin": {
    "ClientId": "${ONELOGIN_CLIENT_ID}",
    "PrivateKey": "${ONELOGIN_PRIVATE_KEY}"
  },
  "OrdnanceSurvey": {
    "ApiKey": "${OS_API_KEY}"
  },
 "ApiClients": {
    "CoreApiBaseUrl": "core url"
  }
}

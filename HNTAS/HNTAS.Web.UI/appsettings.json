{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "OneLogin": {
    "ClientId": "${ONELOGIN_CLIENT_ID}",
    "PrivateKey": "${ONELOGIN_PRIVATE_KEY}",
    "VectorsOfTrust": "Cl"
  },
  "OrdnanceSurvey": {
    "ApiKey": "${OS_API_KEY}"
  },
  "ApiClients": {
    "CoreApiBaseUrl": "core url"
  },
  "AWS": {
    "UseLocalStack": false
  }
}

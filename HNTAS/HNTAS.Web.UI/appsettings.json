{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "OneLogin": {
    "ClientId": "${ONELOGIN_CLIENT_ID}",
    "PrivateKey": "${ONELOGIN_PRIVATE_KEY}",
    "VectorsOfTrust": "Cl.Cm"
  },
  "OrdnanceSurvey": {
    "ApiKey": "${OS_API_KEY}"
  },
  "CompaniesHouse": {
    "BaseUrl": "https://api-sandbox.company-information.service.gov.uk"
  },
  "AWS": {
    "UseLocalStack": false
  },
  "CacheSettings": {
    "RoleCacheDurationMinutes": 30
  },
  "SuperUserLogin": {
    "Enabled": false
  },
  "Jwt": {
    "Issuer": "HNTAS.Web.UI",
    "Audience": "HNTAS.Core.Api",
    "ExpiryHours": 2
  },
  "SessionTimeout": {
    "Minutes": 60
  },
  "Jwks": {
    "KeyId": "certify-your-heat-networks-dev-key-1"
  }
}

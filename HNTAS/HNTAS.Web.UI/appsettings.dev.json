{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "OneLogin": {
    "VectorsOfTrust": "Cl"
  },
  "ExistingNetworks": {
    "EnableFeature": true
  },
  "SuperUserLogin": {
    "Enabled": true
  },
  "Jwks": {
    "Keys": [
      {
        "KeyId": "certify-your-heat-networks-dev-key-1",
        "PublicKeyPemEnvVar": "ONELOGIN_PUBLIC_KEY"
      }
    ]
  }
}
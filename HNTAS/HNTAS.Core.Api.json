            "format": "date-time"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "NullableOfUserStatus": {
        "enum": [
          "Active",
          "InActive",
          "InvitationSent",
          "InvitationAccepted",
          "InvitationDeclined",
          null
        ],
        "nullable": true
      },
      "Organisation": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "companinesHouseNumber": {
            "type": "string",
            "nullable": true
          },
          "type": {
            "type": "string"
          }
        },
        "nullable": true
      },
      "OrganisationType": {
        "enum": [
          "UkCompaniesHouse",
          "OtherUkOrganisation",
          "OverseasOrganisation"
        ]
      },
      "OrgDetails": {
        "required": [
          "orgType",
          "orgName",
          "firstName",
          "lastName",
          "preferredContactType",
          "jobTitle",
          "orgRegisteredAddress"
        ],
        "type": "object",
        "properties": {
          "orgId": {
            "type": "string",
            "nullable": true
          },
          "orgType": {
            "$ref": "#/components/schemas/OrganisationType"
          },
          "companiesHouseNumber": {
            "type": "string",
            "nullable": true
          },
          "orgName": {
            "type": "string"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "preferredContactType": {
            "$ref": "#/components/schemas/PreferredContactType"
          },
          "landlineNumber": {
            "maxLength": 20,
            "pattern": "^\\+?\\d{1,3}[\\s-]?\\(?\\d{1,4}\\)?[\\s-]?\\d{1,4}[\\s-]?\\d{1,4}[\\s-]?\\d{1,9}$",
            "type": "string",
            "nullable": true
          },
          "contactNumberExtension": {
            "maxLength": 10,
            "pattern": "^\\d*$",
            "type": "string",
            "nullable": true
          },
          "mobileNumber": {
            "maxLength": 13,
            "pattern": "^\\+?\\d{1,3}[\\s-]?\\(?\\d{1,4}\\)?[\\s-]?\\d{1,4}[\\s-]?\\d{1,4}[\\s-]?\\d{1,9}$",
            "type": "string",
            "nullable": true
          },
          "jobTitle": {
            "maxLength": 100,
            "pattern": "^[a-zA-Z ]+$",
            "type": "string",
            "nullable": true
          },
          "orgRegisteredAddress": {
            "$ref": "#/components/schemas/OrgRegisteredAddress"
          }
        },
        "nullable": true
      },
      "OrgDetails2": {
        "required": [
          "orgType",
          "orgName",
          "firstName",
          "lastName",
          "preferredContactType",
          "jobTitle",
          "orgRegisteredAddress"
